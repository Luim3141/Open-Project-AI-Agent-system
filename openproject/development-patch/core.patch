+++ b/app/controllers/qldapm_gates_controller.rb
@@ -0,0 +1,51 @@
+class QldapmGatesController < ApplicationController
+  before_action :require_login
+  before_action :load_item, only: %i[show update]
+  before_action :load_project, only: :index
+  authorize_with_permission :view_work_packages
+
+  def index
+    @items = WorkPackage.visible(User.current).where(project: @project).order(:id)
+  end
+
+  def show
+    @policy = Qldapm::GatePolicy.new
+    @snapshot = @item.qldapm_snapshot
+  end
+
+  def update
+    begin
+      raise ::ArgumentError, "PM_REQUIRED: chỉ PM được thay đổi gate hoặc trạng thái" unless Qldapm::Rbac.pm?(@project, User.current)
+      if params[:operation] == "transition"
+        result = WorkPackages::UpdateService.new(user: User.current, model: @item).call(
+          status_id: Integer(params.fetch(:status_id).to_s), lock_version: Integer(params.fetch(:lock_version).to_s))
+        raise ::ArgumentError, result.errors.full_messages.join("; ") unless result.success?
+      else
+        raise ::ArgumentError, "Gate value phải là object" unless params[:value].is_a?(ActionController::Parameters)
+        value = params.fetch(:value).to_unsafe_h.deep_stringify_keys
+        value["done"] = ActiveModel::Type::Boolean.new.cast(value["done"]) if params[:operation] == "checklist"
+        value["job_receipt"] = JSON.parse(value["job_receipt"]) if value["verification"] == "automatic" && value["job_receipt"].is_a?(String)
+        Qldapm::GateActions.new(@item, User.current).call(params[:operation], value, params[:lock_version])
+      end
+      flash[:notice] = "Saved. Evidence is an assertion, not proof that tests actually passed."
+    rescue JSON::ParserError
+      flash[:error] = "Job receipt JSON không hợp lệ; chưa lưu."
+    rescue ::ArgumentError, ActiveRecord::RecordInvalid, ::KeyError => error
+      flash[:error] = error.message
+    end
+    redirect_to qldapm_gate_path(@item.id)
+  end
+
+  private
+
+  def load_project
+    @project = Project.visible(User.current).find_by!(identifier: params[:project_id])
+    render_404 unless @project.identifier == "qldapm-local"
+  end
+
+  def load_item
+    @item = WorkPackage.visible(User.current).find(params[:id])
+    render_404 unless @item.qldapm_managed?
+    @project = @item.project
+  end
+end
diff --git a/app/helpers/qldapm_ai_helper.rb b/app/helpers/qldapm_ai_helper.rb
new file mode 100644
index 00000000..cc455373
--- /dev/null
+++ b/app/helpers/qldapm_ai_helper.rb
@@ -0,0 +1,55 @@
+module QldapmAIHelper
+  ACTIONS = {"create_work_package" => "Tạo công việc", "update_work_package" => "Cập nhật công việc",
+             "comment" => "Thêm bình luận", "transition" => "Chuyển trạng thái", "write_code" => "Sửa nội dung file"}.freeze
+  FIELDS = {"subject" => "Tên công việc", "description" => "Mô tả", "start_date" => "Ngày bắt đầu", "due_date" => "Hạn hoàn thành",
+            "assignee_id" => "Người phụ trách", "assignee_role" => "Vai trò phụ trách", "priority_id" => "Ưu tiên",
+            "status_id" => "Trạng thái", "parent_id" => "Công việc cha", "type_id" => "Loại công việc", "text" => "Bình luận"}.freeze
+
+  def qldapm_preview(proposal)
+    command = proposal.fetch("command", {})
+    action, args = command["action"], command.fetch("arguments", {})
+    before = command.dig("preview", "before") || {}
+    changes = action == "update_work_package" ? args.fetch("changes", {}) : args
+    changes = changes.merge((command.dig("preview", "date_adjustments") || {}).transform_values { |row| row["actual"] })
+    title = ACTIONS.fetch(action, "Thay đổi công việc")
+    title += " ##{args['id']}" if args["id"].is_a?(Integer)
+    if action == "write_code"
+      return {title: title + " “#{args['path']}”", subject: nil,
+              rows: [{label: "Nội dung file", before: before["content"].presence || "File mới", after: args["content"]}]}
+    end
+    rows = changes.filter_map do |field, value|
+      next unless FIELDS.key?(field)
+      old = case field
+            when "start_date" then before["startDate"]
+            when "due_date" then before["dueDate"]
+            when "description" then before.dig("description", "raw")
+            when "assignee_id", "assignee_role" then before.dig("_links", "assignee", "title")
+            when "priority_id" then before.dig("_links", "priority", "title")
+            when "status_id" then before.dig("_links", "status", "title")
+            else before[field]
+            end
+      label = case field
+              when "status_id" then Status.find_by(id: value)&.name
+              when "type_id" then Type.find_by(id: value)&.name
+              when "priority_id" then IssuePriority.find_by(id: value)&.name
+              when "parent_id" then "Công việc ##{value}"
+              when "assignee_id" then "Thành viên ##{value}"
+              else value
+              end
+      if adjustment = command.dig("preview", "date_adjustments", field)
+        label = if adjustment["automatic"]
+                  "#{adjustment['actual']} (OpenProject tự tính theo lịch và thời lượng công việc)"
+                else
+                  "#{adjustment['actual']} (OpenProject điều chỉnh từ #{adjustment['requested']} theo lịch làm việc)"
+                end
+      end
+      {label: FIELDS[field], before: old.presence || "—", after: label.nil? ? "Bỏ giá trị" : label}
+    end
+    {title:, subject: before["subject"], rows:}
+  end
+
+  def qldapm_state(state)
+    {"pending" => "Chờ duyệt", "confirmed" => "Đã thực hiện", "rejected" => "Đã từ chối",
+     "running" => "Đang xử lý", "done" => "Đã có kết quả", "failed_or_unknown" => "Cần kiểm tra kết quả"}.fetch(state, state)
+  end
+end
diff --git a/app/models/concerns/qldapm_gate_write.rb b/app/models/concerns/qldapm_gate_write.rb
new file mode 100644
index 00000000..e2ff0a15
--- /dev/null
+++ b/app/models/concerns/qldapm_gate_write.rb
@@ -0,0 +1,148 @@
+require "digest"
+require "json"
+
+module QldapmGateWrite
+  extend ActiveSupport::Concern
+  TRACKED = %w[subject description assigned_to_id parent_id project_id type_id].freeze
+
+  included do
+    before_save :qldapm_validate_write, prepend: true
+    around_save :qldapm_serialized_save, prepend: true
+    before_destroy :qldapm_guard_destroy, prepend: true
+  end
+
+  def qldapm_managed?
+    project&.identifier == "qldapm-local" || (persisted? && Project.find_by(id: project_id_in_database)&.identifier == "qldapm-local")
+  end
+
+  def qldapm_actor(user = User.current)
+    {"id" => user&.id, "role" => Qldapm::Rbac.role(project, user)}
+  end
+
+  def qldapm_snapshot
+    bug_scope = type.name == "Subtask" && qldapm_gate["kind"] == "qa" && parent ? parent : self
+    descendants = WorkPackage.where(id: bug_scope.descendants.select(:id)).includes(:status).to_a
+    {"id" => id, "type" => type.name, "status" => status.name, "assignee" => assigned_to_id,
+     "data" => qldapm_gate, "children" => children.includes(:status).map { |c|
+       {"id" => c.id, "type" => c.type.name, "status" => c.status.name, "stream" => c.qldapm_gate["stream"], "kind" => c.qldapm_gate["kind"]}
+     }, "blocking_bugs" => descendants.select { |c| c.qldapm_gate["kind"] == "fix_bug" }.map { |c|
+       {"id" => c.id, "status" => c.status.name}
+     }}
+  end
+
+  def qldapm_lock_projects
+    ids = [project_id, project_id_in_database].compact.uniq.sort
+    ids.each { |identifier| self.class.connection.execute("SELECT pg_advisory_xact_lock(817609, #{Integer(identifier)})") }
+  end
+
+  def qldapm_serialized_save
+    return yield unless qldapm_managed?
+    self.class.transaction do
+      qldapm_lock_projects
+      yield
+    end
+  end
+
+  def qldapm_validate_write
+    return unless qldapm_managed?
+    unless Qldapm::Rbac.pm?(project, User.current, fresh: true)
+      if new_record? || (changed_with_custom_fields - %w[lock_version updated_at updated_on]).any?
+        errors.add(:base, "QLDAPM_PM_REQUIRED")
+        throw :abort
+      end
+      return
+    end
+      fresh = persisted? ? WorkPackage.find(id) : nil
+      source_field = WorkPackageCustomField.find_by!(name: "Source ID")
+      source_id = custom_value_for(source_field)&.value.to_s
+      if source_id.empty? || (fresh && fresh.qldapm_gate["source_id"] && fresh.qldapm_gate["source_id"] != source_id)
+        errors.add(:base, "QLDAPM_SOURCE_ID_REQUIRED_AND_IMMUTABLE")
+        throw :abort
+      end
+      if WorkPackage.where(project_id:).where.not(id:).joins(:custom_values)
+          .where(custom_values: {custom_field_id: source_field.id, value: source_id}).exists?
+        errors.add(:base, "QLDAPM_DUPLICATE_SOURCE_ID")
+        throw :abort
+      end
+      if fresh && fresh.project_id != project_id
+        errors.add(:base, "QLDAPM_PROJECT_MOVE_REQUIRES_LOCAL_APPROVAL")
+        throw :abort
+      end
+      if fresh && fresh.lock_version != lock_version
+        errors.add(:base, "QLDAPM_STALE_WORK_PACKAGE")
+        throw :abort
+      end
+      parents = [parent_id, parent_id_in_database].compact.uniq
+      substantive = new_record? || (changes.keys & (TRACKED + %w[status_id qldapm_gate])).any?
+      if substantive && WorkPackage.where(id: parents).joins(:status).where(statuses: {name: %w[REVIEW DONE]}).exists?
+        errors.add(:base, "QLDAPM_PARENT_CLOSED_REOPEN_PARENT_FIRST")
+        throw :abort
+      end
+      data = (qldapm_gate || {}).deep_dup
+      before = fresh&.qldapm_gate || {}
+      if fresh&.status&.name == "DONE" && status_id == fresh.status_id && substantive &&
+          !(changes.keys == ["qldapm_gate"] && data.except("transition_reason", "events") == before.except("transition_reason", "events") &&
+            data.fetch("events", []).last&.fetch("operation", nil) == "reason")
+        errors.add(:base, "QLDAPM_REOPEN_BEFORE_EDIT")
+        throw :abort
+      end
+      if (changes.keys & TRACKED).any? && !new_record?
+        data["revision"] = before.fetch("revision", 0) + 1
+        data["approvals"] = {}
+      end
+      if !new_record? && (changes.keys & %w[subject description]).any?
+        actor = qldapm_actor
+        data["contributors"] = (data.fetch("contributors", []) + [actor["id"]]).uniq if actor["role"]
+      end
+      data["revision"] ||= 0
+      data["source_id"] ||= source_id
+      data["checklist"] ||= []
+      data["evidence"] ||= {}
+      data["approvals"] ||= {}
+      if type.name == "Subtask" && !data["stream"]
+        assignee_role = qldapm_actor(assigned_to)["role"] if assigned_to.is_a?(User)
+        data["stream"] = %w[BE FE].include?(assignee_role) ? "development" : "business"
+        data["kind"] = assignee_role == "QA" ? "qa" : "work"
+      end
+      self.qldapm_gate = data
+      if new_record? && status.name != "NEW"
+        errors.add(:base, "QLDAPM_CREATE_IN_NEW_ONLY")
+        throw :abort
+      end
+      if fresh && status_id != fresh.status_id
+        policy = Qldapm::GatePolicy.new
+        # Permissions and independence must still hold when the transition is executed.
+        data["approvals"].delete_if do |key, record|
+          reviewer = User.active.find_by(id: record["actor_id"])
+          !reviewer || !policy.can_approve?(qldapm_snapshot, qldapm_actor(reviewer), key)
+        end
+        failures = policy.errors(qldapm_snapshot, qldapm_actor, fresh.status.name, status.name)
+        if status.name == "CODE REVIEW"
+          reviewer = User.active.find_by(id: data["reviewer_id"])
+          failures << "ACTIVE_CODE_REVIEWER_REQUIRED" unless reviewer && policy.can_approve?(qldapm_snapshot, qldapm_actor(reviewer), "code")
+        end
+        failures.each { |message| errors.add(:base, "QLDAPM_#{message}") }
+        throw :abort if failures.any?
+        data.delete("transition_reason")
+        self.qldapm_gate = data
+      end
+  end
+
+  def qldapm_guard_destroy
+    return unless qldapm_managed?
+    unless Qldapm::Rbac.pm?(project, User.current, fresh: true)
+      errors.add(:base, "QLDAPM_PM_REQUIRED")
+      throw :abort
+    end
+    qldapm_lock_projects
+    unless Thread.current[:qldapm_approved_delete] == id
+      errors.add(:base, "QLDAPM_DELETE_REQUIRES_LOCAL_APPROVAL")
+      throw :abort
+    end
+    parents = [parent_id, WorkPackage.where(id:).pick(:parent_id)].compact.uniq
+    if WorkPackage.where(id: parents).joins(:status).where(statuses: {name: %w[REVIEW DONE]}).exists?
+      errors.add(:base, "QLDAPM_PARENT_CLOSED_REOPEN_PARENT_FIRST")
+      throw :abort
+    end
+  end
+end
diff --git a/app/models/qldapm/gate_policy.rb b/app/models/qldapm/gate_policy.rb
new file mode 100644
index 00000000..223659d5
--- /dev/null
+++ b/app/models/qldapm/gate_policy.rb
@@ -0,0 +1,191 @@
+module Qldapm
+  # This policy is shared by preview and the database write guard; no AI-specific bypass.
+  class GatePolicy
+    def self.actor_role(roles)
+      recognized = roles.map { |role| role == "BA" ? "BA-PM" : role } & %w[PM BA-PM BE FE QA]
+      return "PM" if recognized.include?("PM")
+      # BA-PM is the historical BA policy key, not a union with PM permissions.
+      recognized.first
+    end
+
+    EPIC = {
+      ["NEW", "READY"] => %w[PM], ["READY", "NEW"] => %w[PM],
+      ["READY", "IN PROGRESS"] => %w[PM], ["IN PROGRESS", "REVIEW"] => %w[PM],
+      ["REVIEW", "DONE"] => %w[PM], ["REVIEW", "IN PROGRESS"] => %w[PM],
+      ["DONE", "IN PROGRESS"] => %w[PM], ["CANCELLED", "NEW"] => %w[PM]
+    }.merge(%w[NEW READY].concat(["IN PROGRESS", "REVIEW"]).to_h { |s| [[s, "CANCELLED"], %w[PM]] }).freeze
+    TASK = {
+      ["NEW", "IN ANALYSIS"] => %w[BA-PM PM], ["IN ANALYSIS", "READY FOR DEV"] => %w[BA-PM PM],
+      ["READY FOR DEV", "IN PROGRESS"] => %w[BE FE PM], ["IN PROGRESS", "CODE REVIEW"] => %w[BE FE PM],
+      ["CODE REVIEW", "IN PROGRESS"] => %w[BE FE PM], ["CODE REVIEW", "READY FOR TEST"] => %w[BE FE PM],
+      ["READY FOR TEST", "IN TESTING"] => %w[QA PM], ["IN TESTING", "IN PROGRESS"] => %w[QA PM],
+      ["IN TESTING", "REVIEW"] => %w[QA PM], ["REVIEW", "IN PROGRESS"] => %w[BE FE BA-PM PM],
+      ["REVIEW", "IN TESTING"] => %w[QA PM], ["REVIEW", "READY FOR RELEASE"] => %w[PM],
+      ["READY FOR RELEASE", "DONE"] => %w[PM], ["DONE", "IN PROGRESS"] => %w[PM]
+    }.freeze
+    BUSINESS = { ["NEW", "IN PROGRESS"] => %w[PM BA-PM BE FE QA],
+      ["IN PROGRESS", "REVIEW"] => %w[PM BA-PM BE FE QA], ["REVIEW", "DONE"] => %w[PM BA-PM BE FE QA],
+      ["REVIEW", "IN PROGRESS"] => %w[PM BA-PM BE FE QA], ["DONE", "IN PROGRESS"] => %w[PM BA-PM BE FE QA] }.freeze
+    DEVELOPMENT = { ["NEW", "IN PROGRESS"] => %w[PM BE FE], ["IN PROGRESS", "CODE REVIEW"] => %w[PM BE FE],
+      ["CODE REVIEW", "IN PROGRESS"] => %w[PM BE FE], ["CODE REVIEW", "READY FOR TEST"] => %w[PM BE FE],
+      ["READY FOR TEST", "IN TESTING"] => %w[PM QA], ["IN TESTING", "IN PROGRESS"] => %w[PM QA],
+      ["IN TESTING", "REVIEW"] => %w[PM QA], ["REVIEW", "IN TESTING"] => %w[PM QA],
+      ["REVIEW", "IN PROGRESS"] => %w[PM BE FE], ["REVIEW", "DONE"] => %w[PM BE FE],
+      ["DONE", "IN PROGRESS"] => %w[PM BE FE] }.freeze
+    APPROVERS = {"scope" => %w[PM], "analysis" => %w[BA-PM PM], "code" => %w[PM BE FE],
+      "test" => %w[QA PM], "retest" => %w[QA PM], "ba" => %w[BA-PM], "pm" => %w[PM],
+      "completion" => %w[PM BA-PM BE FE QA], "handover" => %w[PM]}.freeze
+    REVERSE = [["READY", "NEW"], ["CODE REVIEW", "IN PROGRESS"], ["IN TESTING", "IN PROGRESS"],
+      ["REVIEW", "IN PROGRESS"], ["REVIEW", "IN TESTING"], ["DONE", "IN PROGRESS"], ["CANCELLED", "NEW"]].freeze
+
+    def edges(item)
+      case item["type"]
+      when "Epic" then EPIC
+      when "Task" then TASK
+      when "Subtask" then item.dig("data", "stream") == "development" ? DEVELOPMENT : BUSINESS
+      else {}
+      end
+    end
+
+    def can_approve?(item, actor, key)
+      allowed = APPROVERS.key?(key) && actor["role"] == "PM" && item.dig("data", "reviewer_id") &&
+        item.dig("data", "reviewer_id") != item["assignee"] &&
+        !item.dig("data", "contributors").to_a.include?(item.dig("data", "reviewer_id"))
+      independent = actor["id"] != item["assignee"] && !item.dig("data", "contributors").to_a.include?(actor["id"])
+      if %w[code completion].include?(key)
+        allowed && independent && actor["id"] == item.dig("data", "reviewer_id")
+      elsif %w[test retest pm handover].include?(key)
+        allowed && independent
+      else
+        allowed && independent
+      end
+    end
+
+    def errors(item, actor, from, to)
+      data, children = item.fetch("data"), item.fetch("children", [])
+      errors = []
+      return ["TRANSITION_DENIED"] unless actor["role"] == "PM" && edges(item).key?([from, to])
+      if item["type"] == "Subtask"
+        errors << "STREAM_REQUIRED" unless %w[development business].include?(data["stream"])
+        if from == "NEW" || from == "IN PROGRESS"
+          errors << "ASSIGNEE_ONLY" unless actor["id"] == item["assignee"] || actor["role"] == "PM"
+        end
+      end
+      if from == "CODE REVIEW"
+        errors << "REVIEWER_ONLY" unless can_approve?(item, actor, "code")
+      end
+      if to == "CODE REVIEW" && (!data["reviewer_id"] || data["reviewer_id"] == item["assignee"] ||
+          data.fetch("contributors", []).include?(data["reviewer_id"]))
+        errors << "REVIEWER_REQUIRED"
+      end
+      if item["type"] == "Subtask" && %w[REVIEW DONE].include?(from) && to == "IN PROGRESS"
+        errors << "REVIEWER_ONLY" unless actor["role"] == "PM" || can_approve?(item, actor, "completion")
+      end
+      if REVERSE.include?([from, to]) || to == "CANCELLED"
+        reason = data["transition_reason"] || {}
+        errors << "CHANGE_REASON_REQUIRED" unless reason["from"] == from && reason["to"] == to &&
+          reason["text"].to_s.strip.length >= 5 && reason["actor_id"] == actor["id"] && reason["revision"] == data["revision"]
+        errors << "CHANGE_EVIDENCE_REQUIRED" unless reason["reference"].to_s.strip.length >= 5
+      end
+      require_evidence = ->(key) { errors << "EVIDENCE_#{key.upcase}_REQUIRED" unless evidence?(data, key) }
+      require_approval = ->(key) { errors << "APPROVAL_#{key.upcase}_REQUIRED" unless approved?(data, key) }
+      checklist = -> { errors << "CHECKLIST_INCOMPLETE" if data.fetch("checklist", []).empty? ||
+        data["checklist"].any? { |entry| !entry["done"] || entry["reference"].to_s.empty? || entry["revision"] != data["revision"] } }
+      completed_children = -> {
+        errors << "CHILDREN_REQUIRED" if children.empty?
+        errors << "CHILDREN_NOT_DONE" unless children.all? { |child| child["status"] == "DONE" }
+      }
+      clear_bugs = -> { errors << "BLOCKING_BUGS" if item.fetch("blocking_bugs", []).any? { |bug| bug["status"] != "DONE" } }
+      case item["type"]
+      when "Epic"
+        if to == "READY"
+          errors << "OWNER_REQUIRED" unless item["assignee"]
+          errors << "AC_REQUIRED" if data["acceptance_criteria"].to_s.strip.empty?
+          errors << "TASK_REQUIRED" unless children.any? { |child| child["type"] == "Task" }
+          require_evidence.call("scope")
+          require_approval.call("scope")
+        elsif to == "IN PROGRESS" && from == "READY"
+          errors << "CHILD_NOT_STARTED" unless children.any? { |c| c["status"] != "NEW" }
+        elsif %w[REVIEW DONE].include?(to)
+          completed_children.call
+          if to == "DONE"
+            checklist.call
+            require_evidence.call("integration")
+            require_evidence.call("handover")
+            require_approval.call("handover")
+            clear_bugs.call
+          end
+        end
+      when "Task"
+        case to
+        when "IN ANALYSIS"
+          require_evidence.call("story")
+          errors << "AC_REQUIRED" if data["acceptance_criteria"].to_s.strip.empty?
+          require_evidence.call("scope"); require_approval.call("scope")
+        when "READY FOR DEV"
+          errors << "AC_REQUIRED" if data["acceptance_criteria"].to_s.strip.empty?
+          require_evidence.call("analysis"); require_approval.call("analysis"); require_approval.call("scope")
+        when "IN PROGRESS"
+          errors << "DEVELOPMENT_CHILD_REQUIRED" if from == "READY FOR DEV" && children.none? { |c| c["type"] == "Subtask" && c["stream"] == "development" }
+          if from == "IN TESTING"
+            require_evidence.call("bug")
+            errors << "FIX_BUG_REQUIRED" if item.fetch("blocking_bugs", []).empty?
+          end
+        when "CODE REVIEW" then checklist.call; require_evidence.call("implementation")
+        when "READY FOR TEST"
+          require_approval.call("code"); require_evidence.call("test_build"); require_evidence.call("test_cases")
+          errors << "REVIEWER_ONLY" unless actor["id"] == data["reviewer_id"] && can_approve?(item, actor, "code")
+        when "IN TESTING" then require_evidence.call("test_cases")
+        when "REVIEW"
+          require_evidence.call("test"); require_approval.call("test"); clear_bugs.call
+          errors << "QA_CHILD_NOT_DONE" if children.any? { |c| c["kind"] == "qa" && c["status"] != "DONE" }
+        when "READY FOR RELEASE"
+          %w[code ba pm].each { |key| require_approval.call(key) }
+          if evidence?(data, "retest_not_needed")
+            require_approval.call("retest")
+          else
+            require_evidence.call("retest"); require_approval.call("retest")
+          end
+          clear_bugs.call
+        when "DONE"
+          completed_children.call; checklist.call; clear_bugs.call
+          %w[code ba pm retest].each { |key| require_approval.call(key) }
+          require_evidence.call("deployment"); require_evidence.call("smoke")
+        end
+      when "Subtask"
+        if to == "CODE REVIEW"
+          checklist.call; require_evidence.call("implementation")
+        elsif to == "READY FOR TEST"
+          require_approval.call("code"); require_evidence.call("test_cases"); require_evidence.call("test_build")
+          errors << "REVIEWER_ONLY" unless actor["id"] == data["reviewer_id"] && can_approve?(item, actor, "code")
+        elsif to == "IN TESTING"
+          require_evidence.call("test_cases")
+        elsif to == "IN PROGRESS" && from == "IN TESTING"
+          require_evidence.call("bug")
+        elsif to == "REVIEW"
+          checklist.call
+          require_evidence.call(data["stream"] == "development" ? "test" : "completion")
+          require_approval.call("test") if data["stream"] == "development"
+          clear_bugs.call if data["kind"] == "qa" || data["stream"] == "development"
+        elsif to == "DONE"
+          checklist.call; require_approval.call("completion")
+          errors << "REVIEWER_ONLY" unless can_approve?(item, actor, "completion")
+          clear_bugs.call if data["kind"] == "qa" || data["kind"] == "fix_bug"
+        end
+      end
+      errors.uniq
+    end
+
+    def evidence?(data, key)
+      record = data.fetch("evidence", {}).fetch(key, []).last
+      record && record["revision"] == data["revision"] && record["reference"].to_s.strip.length >= 5 && record["actor_id"] &&
+        (!%w[test retest smoke].include?(key) || record["result"] == "passed") &&
+        (key != "deployment" || record["environment"] == "Test")
+    end
+
+    def approved?(data, key)
+      approval = data.fetch("approvals", {})[key]
+      approval && approval["revision"] == data["revision"] && approval["actor_id"] && approval["reference"].to_s.length >= 5
+    end
+  end
+end

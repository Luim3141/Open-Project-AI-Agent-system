diff --git a/app/services/qldapm/ai_bridge.rb b/app/services/qldapm/ai_bridge.rb
new file mode 100644
index 00000000..5140ce89
--- /dev/null
+++ b/app/services/qldapm/ai_bridge.rb
@@ -0,0 +1,64 @@
+require "net/http"
+require "openssl"
+require "securerandom"
+
+module Qldapm
+  class AiBridge
+    ERRORS = {
+      "GEMINI_DISABLED_PENDING_LOCAL_CREDENTIAL_COST_AND_DATA_VERIFICATION" => "Gemini OFF: cấu hình, key hoặc quyền sử dụng chưa hợp lệ. Chưa gọi Google; cần kiểm tra local.",
+      "GEMINI_FREE_DATA_SCOPE_DENIED" => "Câu hỏi ngoài phạm vi Gemini được cho phép hoặc chứa thông tin cá nhân/key. Hãy bỏ thông tin đó trước khi gửi.",
+      "GEMINI_METADATA_SHAPE_DENIED" => "Dữ liệu không thuộc metadata được phép gửi Google. AI đã dừng; dùng Tool/Insights local để kiểm tra.",
+      "GEMINI_CIRCUIT_OPEN" => "Gemini đã dừng sau lỗi/quota; cần đối soát local, không tự retry hay dùng model trả phí.",
+      "GEMINI_LOCAL_RPM_EXHAUSTED" => "Gemini đã hết giới hạn RPM an toàn; chưa gọi Google, không dùng model trả phí.",
+      "GEMINI_LOCAL_TPM_EXHAUSTED" => "Gemini đã hết giới hạn TPM an toàn; chưa gọi Google, không dùng model trả phí.",
+      "GEMINI_LOCAL_RPD_EXHAUSTED" => "Gemini đã hết giới hạn RPD an toàn; chưa gọi Google, không dùng model trả phí.",
+      "GEMINI_QUOTA_429" => "Google từ chối do quota; Gemini chờ cooldown trước yêu cầu mới. Receipt đã nhận được vẫn được giữ.",
+      "OPENPROJECT_401" => "Phiên xác thực OpenProject không còn hợp lệ; cần đăng nhập lại.",
+      "OPENPROJECT_403" => "OpenProject từ chối vì tài khoản của bạn không có quyền thực hiện thao tác này.",
+      "OPENPROJECT_404" => "Không tìm thấy công việc trong dự án bạn được phép truy cập.",
+      "OPENPROJECT_409" => "Công việc đã thay đổi. Đọc lại phiên bản mới trước khi sửa hoặc duyệt.",
+      "OPENPROJECT_422" => "OpenProject không chấp nhận thay đổi theo workflow, quyền hoặc dữ liệu hiện tại. Chưa có xác nhận thành công.",
+      "OPENPROJECT_502" => "Chưa xác định được kết quả từ OpenProject. Kiểm tra receipt và công việc trước khi gửi lại.",
+      "OPENPROJECT_503" => "OpenProject đang gián đoạn. Kiểm tra receipt và công việc trước khi gửi lại thao tác ghi.",
+      "STALE_WORK_PACKAGE" => "Preview đã cũ vì công việc vừa thay đổi. Tạo preview mới trước khi duyệt.",
+      "STALE_EXPIRED_OR_CONSUMED_PROPOSAL" => "Đề xuất đã hết hạn, đã xử lý hoặc phiên bản/hash không còn khớp. Không thực hiện lại.",
+      "PROPOSAL_NOT_FOUND" => "Không tìm thấy đề xuất của tài khoản này. Chưa thực hiện thao tác.",
+      "RUN_WRITE_SCOPE_POSITIVE_IDS" => "Phạm vi chỉ nhận ID công việc là số nguyên dương.",
+      "AI_BUSY" => "Một yêu cầu Gemini đang chạy. Chờ kết quả hiện tại trước khi gửi yêu cầu mới."
+    }.freeze
+
+    def self.call(project, actor, operation, command)
+      key_file = ENV.fetch("QLDAPM_UI_KEY_FILE", "/qldapm-ui/ui.key")
+      raise ArgumentError, "AI bridge chưa được cấu hình" unless File.file?(key_file)
+      data = {actor: actor.id, project: project.id, audience: "qldapm-ai-ui", at: Time.now.to_i,
+              nonce: SecureRandom.hex(16), operation:, command:}
+      body = JSON.generate(data)
+      # Fixed private destination, never a URL from a ticket, model or browser.
+      uri = URI("http://gateway:8090/internal/ui")
+      request = Net::HTTP::Post.new(uri)
+      request["Content-Type"] = "application/json"
+      request["X-Qldapm-Signature"] = OpenSSL::HMAC.hexdigest("SHA256", File.binread(key_file), body)
+      request.body = body
+      response_body = +""
+      Net::HTTP.start(uri.host, uri.port, nil, open_timeout: 3, read_timeout: 100, write_timeout: 5) do |http|
+        http.request(request) do |response|
+          response.read_body do |chunk|
+            raise ArgumentError, "AI response quá lớn" if response_body.bytesize + chunk.bytesize > 2.megabytes
+            response_body << chunk
+          end
+          unless response.code == "200"
+            document = JSON.parse(response_body)
+            code = document.is_a?(Hash) ? document["error"].to_s[/\A(?:OPENPROJECT_[0-9]+|[A-Z][A-Z0-9_]+)/] : nil
+            # Only known codes become UI messages; never echo upstream text or credentials.
+            raise ArgumentError, ERRORS.fetch(code) { "AI gateway từ chối hoặc chưa sẵn sàng (#{response.code}); không tự gửi lại thao tác ghi" }
+          end
+        end
+      end
+      document = JSON.parse(response_body)
+      raise ArgumentError, "AI gateway trả dữ liệu không hợp lệ" unless document.is_a?(Hash)
+      document
+    rescue JSON::ParserError, IOError, SystemCallError, Timeout::Error
+      raise ArgumentError, "AI gateway chưa sẵn sàng; không tự gửi lại thao tác ghi"
+    end
+  end
+end
diff --git a/app/services/qldapm/gate_actions.rb b/app/services/qldapm/gate_actions.rb
new file mode 100644
index 00000000..2e3be497
--- /dev/null
+++ b/app/services/qldapm/gate_actions.rb
@@ -0,0 +1,139 @@
+module Qldapm
+  class GateActions
+    EVIDENCE = %w[story scope analysis implementation test_cases test_build test retest retest_not_needed completion
+                  bug integration handover deployment smoke].freeze
+    def initialize(work_package, user)
+      @work_package, @user, @policy = work_package, user, GatePolicy.new
+    end
+
+    def call(operation, value, lock_version, request_id: nil, request_hash: nil)
+      wp = @work_package
+      raise ArgumentError, "GATE_PROJECT_DENIED" unless wp.qldapm_managed?
+      raise ArgumentError, "PM_REQUIRED" unless Qldapm::Rbac.pm?(wp.project, @user, fresh: true)
+      raise ArgumentError, "GATE_EDIT_DENIED" unless @user.allowed_in_work_package?(:edit_work_packages, wp)
+      wp.class.transaction do
+        wp.qldapm_lock_projects
+        wp.reload
+        raise ArgumentError, "ACTIVE_MEMBER_REQUIRED" unless wp.qldapm_actor(@user)["role"]
+        if request_id
+          raise ArgumentError, "REQUEST_ID_DENIED" unless request_id.match?(/\AQLDAPM-request-[a-f0-9]{64}\z/) && request_hash.to_s.match?(/\A[a-f0-9]{64}\z/)
+          existing = wp.qldapm_gate.fetch("events", []).find { |entry| entry["request_id"] == request_id && entry["actor_id"] == @user.id }
+          if existing
+            raise ArgumentError, "IDEMPOTENCY_KEY_REUSED" unless existing["request_hash"] == request_hash
+            return {"id" => wp.id, "lockVersion" => wp.lock_version, "gate" => wp.qldapm_gate}
+          end
+        end
+        raise ArgumentError, "STALE_WORK_PACKAGE" unless wp.lock_version == Integer(lock_version)
+        actor, data = wp.qldapm_actor(@user), wp.qldapm_gate.deep_dup
+        reference = value["reference"].to_s.strip
+        case operation
+        when "acceptance_criteria"
+          raise ArgumentError, "BA_OR_PM_REQUIRED" unless %w[BA-PM PM].include?(actor["role"])
+          text = value.fetch("text").to_s.strip
+          raise ArgumentError, "AC_REQUIRED" unless (5..10000).cover?(text.length)
+          data["acceptance_criteria"] = text
+          data["revision"] = data.fetch("revision", 0) + 1
+          data["approvals"] = {}
+          data["contributors"] = (data.fetch("contributors", []) + [actor["id"]]).uniq
+        when "evidence"
+          key = value.fetch("key")
+          raise ArgumentError, "EVIDENCE_KEY_DENIED" unless EVIDENCE.include?(key)
+          validate_reference(reference)
+          raise ArgumentError, "TEST_RESULT_REQUIRED" if %w[test retest smoke].include?(key) && !%w[passed failed].include?(value["result"])
+          verification = {}
+          if %w[test retest smoke].include?(key)
+            mode = value.fetch("verification", "manual")
+            raise ArgumentError, "TEST_VERIFICATION_DENIED" unless %w[manual automatic].include?(mode)
+            raise ArgumentError, "AUTOMATIC_SMOKE_SUITE_NOT_IMPLEMENTED" if mode == "automatic" && key == "smoke"
+            verification = mode == "automatic" ? TestReceipt.verify(value, wp, data.fetch("revision", 0)) : {"verification" => "manual"}
+          end
+          raise ArgumentError, "DEPLOYMENT_ENVIRONMENT_REQUIRED" if key == "deployment" && !%w[Test Staging Production].include?(value["environment"])
+          if key == "implementation"
+            data["revision"] = data.fetch("revision", 0) + 1
+            data["approvals"] = {}
+            data["contributors"] = (data.fetch("contributors", []) + [actor["id"]]).uniq
+          end
+          data["evidence"] ||= {}
+          data["evidence"][key] ||= []
+          invalidated = {"implementation" => %w[code completion], "scope" => GatePolicy::APPROVERS.keys,
+            "analysis" => GatePolicy::APPROVERS.keys, "test_cases" => %w[test retest ba pm completion],
+            "test_build" => %w[code test retest ba pm completion], "test" => %w[test retest ba pm completion],
+            "retest" => %w[retest ba pm completion], "retest_not_needed" => %w[retest ba pm],
+            "deployment" => %w[pm], "smoke" => %w[pm completion], "completion" => %w[completion], "handover" => %w[handover]}.fetch(key, [])
+          invalidated.each { |approval| data.fetch("approvals", {}).delete(approval) }
+          data["evidence"][key] << receipt(actor, data, reference).merge(value.slice("result", "environment")).merge(verification)
+        when "checklist_add"
+          raise ArgumentError, "ASSIGNEE_OR_PM_REQUIRED" unless wp.assigned_to_id == actor["id"] || actor["role"] == "PM"
+          text = value.fetch("text").to_s.strip
+          raise ArgumentError, "CHECKLIST_TEXT_REQUIRED" unless (5..2000).cover?(text.length)
+          data["checklist"] ||= []
+          identifier = Digest::SHA256.hexdigest("#{wp.id}:#{text}")[0, 16]
+          raise ArgumentError, "DUPLICATE_CHECKLIST_ITEM" if data["checklist"].any? { |entry| entry["id"] == identifier }
+          data["checklist"] << {"id" => identifier, "text" => text, "done" => false}
+          data["approvals"] = {}
+        when "checklist"
+          raise ArgumentError, "ASSIGNEE_OR_PM_REQUIRED" unless wp.assigned_to_id == actor["id"] || actor["role"] == "PM"
+          entry = data.fetch("checklist").find { |item| item["id"] == value["id"] }
+          raise ArgumentError, "CHECKLIST_ITEM_NOT_FOUND" unless entry
+          validate_reference(reference) if value["done"]
+          raise ArgumentError, "BOOLEAN_REQUIRED" unless [true, false].include?(value["done"])
+          entry.merge!(receipt(actor, data, reference)).merge!("done" => value["done"])
+          data["approvals"] = {}
+        when "approve"
+          key = value.fetch("key")
+          wp.qldapm_gate = data
+          raise ArgumentError, "APPROVER_DENIED_OR_SELF_APPROVAL" unless @policy.can_approve?(wp.qldapm_snapshot, actor, key)
+          validate_reference(reference)
+          evidence_key = key == "code" ? "implementation" : key == "pm" || key == "ba" ? "test" : key
+          evidence_key = "retest_not_needed" if key == "retest" && @policy.evidence?(data, "retest_not_needed")
+          raise ArgumentError, "CURRENT_EVIDENCE_REQUIRED" unless @policy.evidence?(data, evidence_key)
+          data["approvals"] ||= {}
+          data["approvals"][key] = receipt(actor, data, reference)
+        when "reviewer"
+          raise ArgumentError, "PM_REQUIRED" unless actor["role"] == "PM"
+          reviewer_id = Integer(value.fetch("user_id"))
+          reviewer = User.active.find(reviewer_id)
+          role = wp.qldapm_actor(reviewer)["role"]
+          raise ArgumentError, "MEMBER_REVIEWER_REQUIRED" unless role == "PM" && reviewer_id != wp.assigned_to_id &&
+            !data.fetch("contributors", []).include?(reviewer_id)
+          data["reviewer_id"] = reviewer_id
+          data["approvals"] = {}
+        when "classification"
+          raise ArgumentError, "PM_AND_OPEN_WORK_REQUIRED" unless actor["role"] == "PM" && ["NEW", "IN PROGRESS"].include?(wp.status.name)
+          validate_reference(reference)
+          raise ArgumentError, "CLASSIFICATION_DENIED" unless %w[development business].include?(value["stream"]) &&
+            %w[work qa fix_bug].include?(value["kind"])
+          data.merge!(value.slice("stream", "kind"))
+          data["revision"] = data.fetch("revision", 0) + 1
+          data["approvals"] = {}
+        when "reason"
+          validate_reference(value["text"].to_s)
+          validate_reference(reference)
+          data["transition_reason"] = {"from" => wp.status.name, "to" => value.fetch("to"),
+            "text" => value["text"], "reference" => reference, "actor_id" => actor["id"], "revision" => data.fetch("revision", 0)}
+        else
+          raise ArgumentError, "GATE_OPERATION_DENIED"
+        end
+        data["events"] ||= []
+        data["events"] << receipt(actor, data, reference).merge("operation" => operation, "lock_version" => wp.lock_version,
+          "request_id" => request_id, "request_hash" => request_hash, "value_hash" => Digest::SHA256.hexdigest(JSON.generate(value)))
+        wp.qldapm_gate = data
+        User.execute_as(@user) { raise ActiveRecord::RecordInvalid, wp unless wp.save }
+        # Native work-package journaling stores the actor; the receipt is retained in the structured gate.
+        {"id" => wp.id, "lockVersion" => wp.lock_version, "gate" => wp.qldapm_gate}
+      end
+    end
+
+    private
+
+    def validate_reference(reference)
+      raise ArgumentError, "EVIDENCE_REFERENCE_REQUIRED" if reference.length < 5 || reference.length > 2000
+      raise ArgumentError, "REFERENCE_SCHEME_DENIED" if reference.match?(/\A(?:javascript|data|file):/i)
+    end
+
+    def receipt(actor, data, reference)
+      {"actor_id" => actor["id"], "role" => actor["role"], "revision" => data.fetch("revision", 0),
+       "reference" => reference, "at" => Time.now.utc.iso8601}
+    end
+  end
+end
diff --git a/app/services/qldapm/insight_metrics.rb b/app/services/qldapm/insight_metrics.rb
new file mode 100644
index 00000000..ba07f97f
--- /dev/null
+++ b/app/services/qldapm/insight_metrics.rb
@@ -0,0 +1,61 @@
+require "time"
+
+module Qldapm
+  class InsightMetrics
+    VERSION = 1
+    def self.calculate(events, actor, from, to)
+      selected = events.select { |event| event["actor_id"] == actor && event["at"] >= from && event["at"] < to }
+      delivery = selected.select { |event| event["kind"] == "status" && event["type"] == "Task" }
+      completions = delivery.select { |event| event["to"] == "DONE" && event["from"] != "DONE" }
+      reopens = delivery.select { |event| event["from"] == "DONE" && event["to"] != "DONE" }
+      evidence = events.select { |event| event["actor_id"] == actor && event["at"] < to && event["kind"] == "evidence" && %w[test retest smoke].include?(event["key"]) }
+      tests = evidence.group_by { |event| [event["work_package_id"], event["key"], event["revision"]] }.values
+        .map { |rows| rows.min_by { |row| row["at"] } }.select { |row| row["at"] >= from }
+      passing = tests.count { |event| event["result"] == "passed" }
+      cycles, waits = [], []
+      events.select { |event| event["type"] == "Task" }.group_by { |event| event["work_package_id"] }.each_value do |rows|
+        started, waiting = nil, nil
+        rows.sort_by { |row| [row["at"], row["source"]] }.each do |row|
+          next if row["at"] >= to
+          started = nil if started && row["assignee_id"] != actor
+          waiting = nil if waiting && row["assignee_id"] != actor
+          next unless row["kind"] == "status"
+          if row["to"] == "IN PROGRESS" && row["from"] == "READY FOR DEV" && row["assignee_id"] == actor
+            started = row
+          elsif row["to"] == "DONE" && started
+            cycles << {"seconds" => row["at"] - started["at"], "sources" => [started["source"], row["source"]]} if row["at"] >= from
+            started = nil
+          end
+          if waiting && row["from"] == waiting["to"]
+            waits << {"status" => waiting["to"], "seconds" => row["at"] - waiting["at"], "sources" => [waiting["source"], row["source"]]} if row["at"] >= from
+            waiting = nil
+          end
+          waiting = row if %w[CODE\ REVIEW READY\ FOR\ TEST REVIEW].include?(row["to"]) && row["assignee_id"] == actor
+        end
+      end
+      {"version" => VERSION, "from" => from.utc.iso8601, "to" => to.utc.iso8601, "timezone" => "Asia/Bangkok",
+       "subject_id" => actor, "coverage" => selected.empty? ? "insufficient" : "partial",
+       "metrics" => {"task_completion_actions" => {"numerator" => completions.size, "denominator" => delivery.size,
+           "sources" => completions.map { |event| event["source"] }, "meaning" => "Status actions by actor, not personal productivity"},
+         "task_reopen_actions" => {"count" => reopens.size, "denominator" => delivery.size, "sources" => reopens.map { |event| event["source"] }},
+         "first_recorded_test_pass" => {"numerator" => passing, "denominator" => tests.size,
+           "ratio" => tests.empty? ? nil : passing.to_f / tests.size, "sources" => tests.map { |event| event["source"] },
+           "meaning" => "Actor's first recorded assertion per revision, not independently proven test quality"},
+         "review_actions" => {"count" => selected.count { |event| event["kind"] == "approval" },
+           "sources" => selected.select { |event| event["kind"] == "approval" }.map { |event| event["source"] }},
+         "cycle_time" => {"samples" => cycles, "mean_seconds" => cycles.empty? ? nil : cycles.sum { |row| row["seconds"] } / cycles.size,
+           "sample_count" => cycles.size, "coverage" => cycles.empty? ? "insufficient" : "partial", "meaning" => "Task READY FOR DEV→IN PROGRESS→DONE with unchanged recorded assignee; not effort hours"},
+         "handoff_wait" => {"samples" => waits, "sample_count" => waits.size, "coverage" => waits.empty? ? "insufficient" : "partial",
+           "meaning" => "Observed review/test queue intervals, not blame or idle time"},
+         "scope_changes" => {"count" => selected.count { |event| event["kind"] == "scope_change" },
+           "sources" => selected.select { |event| event["kind"] == "scope_change" }.map { |event| event["source"] }},
+         "blocked_time" => {"value" => nil, "coverage" => "insufficient", "reason" => "Needs explicit blocker start/end evidence"},
+         "commitment_carryover" => {"value" => nil, "coverage" => "insufficient", "reason" => "No verified pre-sprint commitment snapshot"}},
+       "events" => selected.map { |event| event.merge("at" => event["at"].utc.iso8601) },
+       "provenance" => selected.group_by { |event| event["provenance"] || "unknown" }.transform_values(&:size),
+       "limitations" => ["No score, ranking or automatic HR decision", "Task/Subtask/Epic are not summed as throughput",
+         "Creation/import and simulated estimates are excluded", "Unknown provenance is not attributed as human effort",
+         "Current role is not applied retrospectively", "Missing data is not zero performance"]}
+    end
+  end
+end
diff --git a/app/services/qldapm/insights.rb b/app/services/qldapm/insights.rb
new file mode 100644
index 00000000..e1d80789
--- /dev/null
+++ b/app/services/qldapm/insights.rb
@@ -0,0 +1,115 @@
+require "digest"
+
+module Qldapm
+  class Insights
+    def initialize(project, user)
+      @project, @user = project, user
+      raise ArgumentError, "PROJECT_DENIED" unless project.identifier == "qldapm-local"
+      @item = WorkPackage.visible(user).where(project:).first!
+      @role = @item.qldapm_actor(user)["role"]
+      raise ArgumentError, "ACTIVE_MEMBER_REQUIRED" unless @role
+    end
+
+    def report(target, days, now: Time.current)
+      target, days = Integer(target), Integer(days)
+      raise ArgumentError, "PM_OR_SELF_REQUIRED" unless target == @user.id || @role == "PM"
+      raise ArgumentError, "WINDOW_DENIED" unless [7, 30, 90].include?(days)
+      subject = User.active.find(target)
+      raise ArgumentError, "SUBJECT_MEMBER_REQUIRED" unless @item.qldapm_actor(subject)["role"]
+      events = collect
+      data = InsightMetrics.calculate(events, target, now - days.days, now)
+      previous = InsightMetrics.calculate(events, target, now - (days * 2).days, now - days.days)
+      data["previous_window"] = previous.except("events")
+      data["trend"] = {"coverage" => data["coverage"] == "insufficient" || previous["coverage"] == "insufficient" ? "insufficient" : "partial",
+        "task_completion_action_delta" => data.dig("metrics", "task_completion_actions", "numerator") - previous.dig("metrics", "task_completion_actions", "numerator"),
+        "notice" => "Process action delta, not employee improvement/decline or a ranking."}
+      data["subject"] = subject.name
+      data["role_current_only"] = Member.find_by!(project_id: @project.id, user_id: subject.id, entity_id: nil).roles
+        .map { |role| role.name.delete_prefix("QLDAPM ") }.find { |role| %w[PM BA BA-PM BE FE QA].include?(role) }
+      data["role_context"] = {"PM" => "Planning, blockers, independent acceptance and release evidence",
+        "BA" => "AC/scope clarity and business acceptance", "BA-PM" => "AC/scope clarity and business acceptance", "BE" => "Implementation/review/test evidence",
+        "FE" => "Implementation/review/test evidence", "QA" => "Test cases, failures, retest and verification"}.fetch(data["role_current_only"])
+      sprints = Sprint.where(project: @project)
+      current = sprints.active.where.not(start_date: nil, finish_date: nil).order(:start_date).last
+      recent = sprints.completed.where.not(start_date: nil, finish_date: nil).order(finish_date: :desc).limit(3)
+      data["sprints"] = ([current].compact + recent).map do |sprint|
+        start = sprint.start_date.in_time_zone("Asia/Bangkok").beginning_of_day
+        finish = [sprint.finish_date.in_time_zone("Asia/Bangkok").end_of_day, now].min
+        {"id" => sprint.id, "name" => sprint.name, "start" => start.iso8601, "finish" => finish.iso8601,
+         "report" => InsightMetrics.calculate(events, target, start, finish), "commitment_coverage" => "insufficient"}
+      end
+      data["sprint_notice"] = "Planning/undated sprints are not started or inferred; no retrospective commitment baseline."
+      data
+    end
+
+    def snapshot(target, days, now: Time.current)
+      data = report(target, days, now:)
+      fingerprint = Digest::SHA256.hexdigest(JSON.generate(data))
+      InsightSnapshot.create_or_find_by!(project: @project, user_id: target, days:, input_hash: fingerprint) { |row| row.report = data }
+    end
+
+    def self.daily
+      Project.where(identifier: "qldapm-local").each do |project|
+        item = project.work_packages.first
+        next unless item
+        members = User.active.where(id: Member.where(project_id: project.id, entity_id: nil).select(:user_id)).select { |user| item.qldapm_actor(user)["role"] }
+        pm = members.find { |user| item.qldapm_actor(user)["role"] == "PM" }
+        next unless pm
+        engine = new(project, pm)
+        # Daily boundaries are deterministic; re-running the same day does not add duplicate reports.
+        cutoff = Time.current.in_time_zone("Asia/Bangkok").change(hour: 23, min: 55).utc
+        cutoff -= 1.day if cutoff > Time.current
+        members.each { |user| [7, 30, 90].each { |days| engine.snapshot(user.id, days, now: cutoff) } }
+      end
+    end
+
+    private
+
+    def collect
+      items = WorkPackage.visible(@user).where(project: @project).includes(:type).to_a
+      journals = Journal.where(journable_type: "WorkPackage", journable_id: items.map(&:id)).includes(:data)
+        .order(:version).group_by(&:journable_id)
+      statuses = Status.pluck(:id, :name).to_h
+      provenance = MutationReceipt.where(project: @project).where.not(journal_id: nil).pluck(:journal_id, :provenance).to_h
+      events = []
+      items.each do |item|
+        # Imported simulation is source context, not observed human effort or quality.
+        next if item.description.to_s.start_with?("> JIRA IMPORT — SIMULATION ONLY.")
+        previous = nil
+        journals.fetch(item.id, []).each do |journal|
+          current = journal.data
+          if previous && journal.user_id && !%w[import system_update].include?(journal.cause_type)
+            base = {"actor_id" => journal.user_id, "assignee_id" => current.assigned_to_id, "work_package_id" => item.id,
+                    "type" => item.type.name, "at" => journal.created_at, "source" => "journal:#{journal.id}", "provenance" => provenance.fetch(journal.id, "unknown")}
+            if previous.assigned_to_id != current.assigned_to_id
+              events << base.merge("kind" => "assignment", "previous_assignee_id" => previous.assigned_to_id)
+            end
+            if previous.subject != current.subject || previous.description != current.description
+              events << base.merge("kind" => "scope_change")
+            end
+            old_status, new_status = previous.status_id, current.status_id
+            if old_status != new_status
+              events << {"kind" => "status", "actor_id" => journal.user_id, "assignee_id" => current.assigned_to_id,
+                "from" => statuses[old_status], "to" => statuses[new_status], "work_package_id" => item.id,
+                "type" => item.type.name, "at" => journal.created_at, "source" => "journal:#{journal.id}", "provenance" => provenance.fetch(journal.id, "unknown")}
+            end
+          end
+          previous = current
+        end
+        gate = item.qldapm_gate
+        gate.fetch("evidence", {}).each do |key, rows|
+          rows.each do |row|
+            events << row.slice("actor_id", "revision", "result", "role", "reference", "verification", "snapshot_hash").merge(
+              "kind" => "evidence", "key" => key, "work_package_id" => item.id, "at" => Time.iso8601(row.fetch("at")),
+              "source" => "gate:#{item.id}:#{key}:#{row['at']}", "provenance" => row["verification"] == "automatic" ? "broker_test_receipt" : "manual_or_legacy_assertion")
+          end
+        end
+        gate.fetch("events", []).select { |row| row["operation"] == "approve" }.each do |row|
+          events << row.slice("actor_id", "revision", "role", "reference").merge("kind" => "approval", "work_package_id" => item.id,
+            "at" => Time.iso8601(row.fetch("at")), "source" => "gate:#{item.id}:approve:#{row['at']}", "provenance" => "unknown_assertion")
+        end
+      end
+      events.sort_by { |event| [event["at"], event["source"]] }
+    end
+  end
+end
diff --git a/app/services/qldapm/mutations.rb b/app/services/qldapm/mutations.rb
new file mode 100644
index 00000000..1c1c5bc9
--- /dev/null
+++ b/app/services/qldapm/mutations.rb
@@ -0,0 +1,58 @@
+require "openssl"
+require "digest"
+
+module Qldapm
+  class Mutations
+    def self.canonical(value)
+      case value
+      when Hash then value.keys.sort.to_h { |key| [key, canonical(value[key])] }
+      when Array then value.map { |entry| canonical(entry) }
+      else value
+      end
+    end
+
+    def self.call(item, user, payload, headers)
+      raise ArgumentError, "PM_REQUIRED" unless item.qldapm_managed? && Qldapm::Rbac.pm?(item.project, user)
+      raise ArgumentError, "EDIT_DENIED" unless user.allowed_in_work_package?(:edit_work_packages, item)
+      raise ArgumentError, "MUTATION_ACTION_DENIED" unless %w[update_work_package transition].include?(payload["action"])
+      raise ArgumentError, "REQUEST_ID_DENIED" unless payload["request_id"].to_s.match?(/\AQLDAPM-request-[a-f0-9]{64}\z/)
+      command_hash = Digest::SHA256.hexdigest(JSON.generate(canonical(payload.merge("id" => item.id))))
+      at = headers["X-Qldapm-At"].to_i
+      signature = headers["X-Qldapm-Mutation"].to_s
+      key_path = ENV.fetch("QLDAPM_UI_KEY_FILE", "/qldapm-ui/ui.key")
+      provenance = "unknown"
+      if !signature.empty?
+        raise ArgumentError, "AI_SIGNATURE_EXPIRED" if (Time.now.to_i - at).abs > 30 || !File.file?(key_path)
+        expected = OpenSSL::HMAC.hexdigest("SHA256", File.binread(key_path), "#{user.id}:#{at}:#{command_hash}")
+        raise ArgumentError, "AI_SIGNATURE_DENIED" unless ActiveSupport::SecurityUtils.secure_compare(signature, expected)
+        provenance = "ai_gateway"
+      end
+      WorkPackage.transaction do
+        item.qldapm_lock_projects
+        item.reload
+        receipt = MutationReceipt.find_by(project_id: item.project_id, user_id: user.id, request_id: payload["request_id"])
+        if receipt
+          raise ArgumentError, "IDEMPOTENCY_KEY_REUSED" unless receipt.request_hash == command_hash && receipt.work_package_id == item.id
+          return receipt.result
+        end
+        raise ArgumentError, "STALE_WORK_PACKAGE" unless item.lock_version == Integer(payload.fetch("lock_version"))
+        attributes = {lock_version: item.lock_version}
+        if payload["action"] == "transition"
+          attributes[:status_id] = Integer(payload.fetch("status_id"))
+        else
+          changes = payload.fetch("changes")
+          raise ArgumentError, "CHANGES_DENIED" unless (changes.keys - %w[subject description assignee_id start_date due_date priority_id]).empty?
+          attributes.merge!(changes.slice("subject", "description", "start_date", "due_date", "priority_id").symbolize_keys)
+          attributes[:assigned_to_id] = Integer(changes["assignee_id"]) if changes.key?("assignee_id")
+        end
+        result = WorkPackages::UpdateService.new(user:, model: item).call(attributes)
+        raise ArgumentError, result.errors.full_messages.join("; ") unless result.success?
+        item.reload
+        body = {"id" => item.id, "lockVersion" => item.lock_version, "request_id" => payload["request_id"], "provenance" => provenance}
+        MutationReceipt.create!(project_id: item.project_id, user_id: user.id, work_package: item,
+          journal_id: item.journals.order(:version).last&.id, request_id: payload["request_id"], request_hash: command_hash, provenance:, result: body)
+        body
+      end
+    end
+  end
+end
diff --git a/app/services/qldapm/test_receipt.rb b/app/services/qldapm/test_receipt.rb
new file mode 100644
index 00000000..368c70e0
--- /dev/null
+++ b/app/services/qldapm/test_receipt.rb
@@ -0,0 +1,25 @@
+require "openssl"
+require "digest"
+
+module Qldapm
+  class TestReceipt
+    def self.verify(value, item, revision, key_file: ENV.fetch("QLDAPM_TEST_RECEIPT_KEY_FILE", "/qldapm-ui/test-receipt.key"))
+      receipt = value.fetch("job_receipt")
+      raise ArgumentError, "TEST_RECEIPT_MALFORMED" unless receipt.is_a?(Hash) && receipt["proof"].is_a?(Hash)
+      proof = receipt.fetch("proof")
+      fields = %w[job_id actor_id project_id work_package_id gate_revision suite workspace_actor snapshot_hash output_hash passed finished_at]
+      raise ArgumentError, "TEST_RECEIPT_FIELDS" unless proof.keys.sort == fields.sort && File.file?(key_file)
+      expected = OpenSSL::HMAC.hexdigest("SHA256", File.binread(key_file), JSON.generate(Mutations.canonical(proof)))
+      signature = receipt.fetch("signature").to_s
+      raise ArgumentError, "TEST_RECEIPT_SIGNATURE" unless signature.length == 64 && ActiveSupport::SecurityUtils.secure_compare(signature, expected)
+      raise ArgumentError, "TEST_RECEIPT_SCOPE_OR_REVISION" unless proof["project_id"] == item.project_id &&
+        proof["work_package_id"] == item.id && proof["gate_revision"] == revision
+      raise ArgumentError, "TEST_RECEIPT_SNAPSHOT" unless proof["snapshot_hash"].to_s.match?(/\A[a-f0-9]{64}\z/) && value["snapshot_hash"] == proof["snapshot_hash"]
+      raise ArgumentError, "TEST_RECEIPT_FAILED_OR_INVALID" unless proof["passed"] == true && value["result"] == "passed" &&
+        %w[gate-policy core-integration].include?(proof["suite"]) && proof["finished_at"].is_a?(Integer) && proof["finished_at"] <= Time.now.to_i + 30
+      {"verification" => "automatic", "job_receipt" => receipt, "snapshot_hash" => proof["snapshot_hash"]}
+    rescue KeyError, TypeError
+      raise ArgumentError, "TEST_RECEIPT_MALFORMED"
+    end
+  end
+end

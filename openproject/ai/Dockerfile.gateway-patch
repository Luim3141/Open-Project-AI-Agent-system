# Reuse the qualified dependency runtime; this change only replaces application code.
FROM qldapm-ai:runtime-1cd1687b
USER root
COPY requirements.lock.txt /app/requirements.lock.txt
RUN pip install --no-cache-dir -r /app/requirements.lock.txt
COPY --chown=10001:10001 gateway/ /app/gateway/
COPY --chown=10001:10001 knowledge_sources/ /app/knowledge_sources/
USER 10001

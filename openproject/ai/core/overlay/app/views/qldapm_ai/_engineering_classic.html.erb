            PM/BA → Tạo đặc tả & backlog
          </button>
        <% end %>
      <% end %>

      <% Array(@engineering['plans']).each do |plan| %>
        <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px; margin-bottom: 10px;">

# Nhập secret trong file local được ACL bảo vệ; không commit hoặc gửi qua chat.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Giữ false cho đến khi model/free-quota/data sharing đã được Owner xác nhận.
GEMINI_PROJECT_DATA_CONSENT=false
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Chỉ bật khi Owner cho phép chuyển bot riêng từ webhook sang polling.
TELEGRAM_ALLOW_WEBHOOK_REMOVAL=false
QLDAPM_GATEWAY_INTERNAL_URL=http://gateway:8090
QLDAPM_SERVICE_CREDENTIAL_REF=/run/secrets/gateway.token
QLDAPM_ALLOWED_PROJECT_IDS=5,6
TELEGRAM_AI_DB_PATH=/state/telegram.sqlite
TELEGRAM_AI_INTERNAL_SECRET_FILE=/run/secrets/notification.key
TELEGRAM_AI_N8N_WEBHOOK_URL=
TELEGRAM_AI_N8N_WEBHOOK_SECRET_FILE=/run/secrets/notification.key
TELEGRAM_AI_MAX_TOOL_ROUNDS=5
TELEGRAM_AI_MAX_TOOL_CALLS=12
TELEGRAM_AI_REQUEST_TIMEOUT_SECONDS=90
TELEGRAM_AI_MAX_DAILY_MODEL_CALLS=20
TZ=Asia/Bangkok

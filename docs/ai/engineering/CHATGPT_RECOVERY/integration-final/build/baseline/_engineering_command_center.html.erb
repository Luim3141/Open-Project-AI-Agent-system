                      </td>
                      <td>
                        <span class="qcc-chip <%= qstate == 'finished' ? 'qcc-chip-emerald' : (qstate == 'paused' ? 'qcc-chip-amber' : 'qcc-chip-cyan') %>">
                          <%= qstate.upcase %>
                        </span>
                      </td>
                      <td><%= run.dig('result', 'stage') || 'UNKNOWN' %></td>
                      <td>
                        <% if run['unit'].present? %>
                          <code><%= run['unit'] %></code> (WP #<%= run['native_id'] %>)
                        <% else %>
                          WP #<%= run['native_id'] || 379 %>
                        <% end %>
                      </td>
                      <td>
                        <span class="qcc-review-badge">Review evidence: <strong><%= run.dig('result', 'review_evidence', 'verdict') || 'NOT VERIFIED' %></strong></span>
                      </td>
                      <td>
                        <span class="text-<%= status == 'succeeded' ? 'emerald' : (status == 'failed' ? 'rose' : 'amber') %>">
                          <%= status.upcase %>
                        </span>
                      </td>
                      <td>
                        <% if is_active %>
                          <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", style: "display:inline;" do %>
                            <%= hidden_field_tag :tool, 'engineering_cancel' %>
                            <%= hidden_field_tag :arguments, {run_id: run['id']}.to_json %>
                            <button type="submit" class="qcc-btn-xs qcc-btn-rose" data-confirm="Xác nhận thao tác?">Hủy</button>
                          <% end %>
                        <% end %>
                        <% if can_resume %>
                          <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", style: "display:inline;" do %>
                            <%= hidden_field_tag :tool, 'engineering_resume' %>
                            <%= hidden_field_tag :arguments, {run_id: run['id'], checkpoint_version: checkpoint['version'] || 0}.to_json %>
                            <button type="submit" class="qcc-btn-xs qcc-btn-emerald" title="Gateway xác minh budget/checkpoint; cùng run, attempt liên kết">Yêu cầu Resume</button>
                          <% end %>
                        <% elsif !is_active %>
                          <button type="button" class="qcc-btn-xs qcc-btn-secondary qcc-run-inspector-btn" data-run-id="<%= run['id'] %>" title="Xem sơ đồ DAG và tiến trình Agent">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <span>Chi tiết</span>
                          </button>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 5: GITHUB & DELIVERY -->
      <section id="tab-github" data-qcc-live class="qcc-tab-pane" role="tabpanel">
        <div class="qcc-card">
          <div class="qcc-card-header">
            <div>
              <h3 class="qcc-card-title">Chuỗi Pull Requests Xếp tầng (GitHub Stacked PRs)</h3>
              <p class="qcc-card-sub">Kho mã nguồn: <code>Luim3141/mini-task-manager</code> · Phân định minh bạch nhánh chính và nhánh feature</p>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
              <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form", style: "display:inline;" do %>
                <%= hidden_field_tag :tool, 'engineering_github_sync' %>
                <%= hidden_field_tag :active_tab, 'tab-github' %>
                <%= hidden_field_tag :arguments, {}.to_json %>
                <button type="submit" class="qcc-btn qcc-btn-primary" title="Đối soát trực tiếp với GitHub REST API">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                  <span>Đồng bộ GitHub ngay</span>
                </button>
              <% end %>
              <a href="https://github.com/Luim3141/mini-task-manager/pulls" target="_blank" class="qcc-btn qcc-btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                <span>Xem trên GitHub</span>
              </a>
            </div>
          </div>

          <!-- Real-Time GitHub Synchronization Status Bar -->
          <div class="qcc-sync-status-bar" style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; padding: 12px 16px; margin: 0 16px 16px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 8px; font-size: 13px;">
            <div style="display: flex; gap: 12px; align-items: center;">
              <span class="qcc-chip qcc-chip-emerald" style="display: inline-flex; align-items: center; gap: 6px;">
                <span class="qcc-pulse-dot" style="width: 8px; height: 8px; background: #10B981; border-radius: 50%;"></span>
                GITHUB REST API: <%= github_info['status'] || 'UNKNOWN' %>
              </span>
              <span style="color: #94A3B8;">
                Đối soát: <strong style="color: #E2E8F0;"><%= github_prs.size %> PRs</strong>
              </span>
              <span style="color: #64748B;">|</span>
              <span style="color: #94A3B8;">
                Last successful sync: <strong style="color: #38BDF8;" title="<%= iso_tooltip.call(sync_meta['last_synced_at']) %>"><%= format_vn_time.call(sync_meta['last_success_at']) %></strong>
              </span>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
              <% 
                merged_main_cnt = github_prs.count { |p| p['is_merged'] && (p['base_ref'] == 'main' || p['merge_target'] == 'MAIN') }
                merged_branch_cnt = github_prs.count { |p| p['is_merged'] && p['base_ref'] != 'main' && p['merge_target'] != 'MAIN' }
                open_cnt = github_prs.count { |p| p['state'] == 'open' }
              %>
              <span class="qcc-chip qcc-chip-emerald" title="Đã merge vào nhánh chính main"><%= merged_main_cnt %> Main</span>
              <span class="qcc-chip qcc-chip-purple" title="Đã merge vào feature branch"><%= merged_branch_cnt %> Feature Branch</span>
              <span class="qcc-chip qcc-chip-amber" title="Pull Request đang mở"><%= open_cnt %> Đang mở</span>
            </div>
          </div>

          <div class="qcc-table-wrapper">
            <table class="qcc-table">
              <thead>
                <tr>
                  <th>Pull Request</th>
                  <th>Task OpenProject</th>
                  <th>Tạo lúc</th>
                  <th>Merge lúc</th>
                  <th>Base Branch (Target)</th>
                  <th>Head Branch & Commit</th>
                  <th>Reviews & CI GitHub</th>
                  <th>Đích Merge</th>
                  <th>Trạng thái</th>
                </tr>
              </thead>
              <tbody>
                <% github_prs.each do |pr| %>
                  <tr>
                    <td>
                      <a href="https://github.com/Luim3141/mini-task-manager/pull/<%= pr['number'] %>" target="_blank" class="qcc-pr-link">
                        <strong>PR #<%= pr['number'] %></strong>: <%= pr['title'] %>
                      </a>
                    </td>
                    <td>
                      <span class="qcc-chip qcc-chip-blue"><%= pr['wp_id'].present? ? "WP ##{pr['wp_id']}" : 'Chưa xác minh liên kết WP' %></span>
                    </td>
                    <td title="<%= iso_tooltip.call(pr['created_at']) %>">
                      <span class="text-slate" style="font-size:11px;"><%= format_vn_time.call(pr['created_at']) %></span>
                    </td>
                    <td title="<%= iso_tooltip.call(pr['merged_at']) %>">
                      <span class="text-slate" style="font-size:11px;"><%= pr['is_merged'] ? format_vn_time.call(pr['merged_at']) : '—' %></span>
                    </td>
                    <td>
                      <code><%= pr['base_ref'] %></code>
                    </td>
                    <td>
                      <code><%= pr['head_sha'] ? pr['head_sha'][0..7] : 'N/A' %></code>
                    </td>
                    <td>
                      <div class="qcc-badge-stack">
                        <span class="qcc-chip qcc-chip-subtle" title="Trạng thái GitHub reviews"><%= pr['reviews_state'] || 'NOT_CHECKED' %></span>
                        <span class="qcc-chip qcc-chip-subtle" title="Trạng thái GitHub CI"><%= pr['checks_state'] || 'NOT_CHECKED' %></span>
                      </div>
                    </td>
                    <td>
                      <% if pr['is_merged'] %>
                        <% if pr['base_ref'] == 'main' || pr['merge_target'] == 'MAIN' %>
                          <span class="qcc-chip qcc-chip-emerald" title="Đã hợp nhất vào nhánh chính">MERGED TO MAIN</span>
                        <% else %>
                          <span class="qcc-chip qcc-chip-purple" title="Đã hợp nhất vào nhánh tính năng (<%= pr['base_ref'] %>)">MERGED TO BRANCH (<%= pr['base_ref'] %>)</span>
                        <% end %>
                      <% elsif pr['base_ref'] == 'main' %>
                        <span class="qcc-chip qcc-chip-amber">MAIN</span>
                      <% else %>
                        <span class="qcc-chip qcc-chip-cyan">FEATURE_STACK (<%= pr['base_ref'] %>)</span>
                      <% end %>
                    </td>
                    <td>
                      <% if pr['is_merged'] %>
                        <span class="qcc-chip qcc-chip-purple" title="Đã được merge vào git remote">MERGED</span>
                      <% elsif pr['state'] == 'open' %>
                        <span class="qcc-chip qcc-chip-emerald" title="Pull Request đang mở">OPEN</span>
                      <% else %>
                        <span class="qcc-chip qcc-chip-slate" title="Pull Request đã đóng">CLOSED</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 6: REPORTS & ANALYTICS -->
      <section id="tab-reports" data-qcc-live class="qcc-tab-pane" role="tabpanel">
        <div class="qcc-card">
          <div class="qcc-card-header">
            <div>
              <h3 class="qcc-card-title">Hệ thống Báo cáo Tự động & Lịch Chạy (Reporting System)</h3>
              <p class="qcc-card-sub">Báo cáo tiến độ hằng ngày (Daily), hằng tuần (Weekly) và báo cáo tức thời (Snapshot)</p>
            </div>
            <button type="button" class="qcc-btn qcc-btn-primary" data-open-schedule>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>Cấu hình lịch tự động</span>
            </button>
          </div>

          <div class="qcc-reports-grid">
            <% if reports.empty? %>
              <div class="qcc-empty-state">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-slate"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <p>Chưa có báo cáo nào được sinh. Nhấn nút "Snapshot Tức Thời (+AI)" ở trên để tạo báo cáo đầu tiên.</p>
              </div>
            <% else %>
              <% reports.each do |rep| %>
                <div class="qcc-report-card">
                  <div class="qcc-report-top">
                    <span class="qcc-chip qcc-chip-blue"><%= rep['report_type'] || rep['type'] || 'DAILY' %></span>
                    <span class="qcc-chip"><%= rep['source_state'] || 'UNKNOWN' %></span>
                    <span class="qcc-report-time" title="<%= iso_tooltip.call(rep['created_at'] || rep['created_iso']) %>"><%= format_vn_time.call(rep['created_at'] || rep['created_iso']) %></span>
                  </div>
                  <h4 class="qcc-report-title"><%= rep['title'] || 'Báo cáo Tiến độ Phát triển AI Engineering' %></h4>
                  <div class="qcc-report-metrics">
                    <div class="qcc-report-metric">
                      <span>WPs trong nguồn</span>
                      <strong><%= rep.dig('metrics', 'work_packages', 'total_items') || 'Chưa có dữ liệu' %></strong>
                    </div>
                    <div class="qcc-report-metric">
                      <span>Runs succeeded</span>
                      <strong><%= rep.dig('metrics', 'runs', 'succeeded') || 'Chưa có dữ liệu' %></strong>
                    </div>
                    <div class="qcc-report-metric">
                      <span>Pull Requests</span>
                      <strong><%= rep.dig('metrics', 'github', 'total_prs') || 'Chưa có dữ liệu' %></strong>
                    </div>
                  </div>
                  <p class="qcc-text-muted">AI: <%= rep['ai_narrative_status'] || 'UNKNOWN' %> · <%= rep['ai_narrative_label'] || 'Nhận định AI chưa xác minh' %> · Usage <%= rep.dig('metrics','runs','usage_complete') == true ? 'đủ receipts' : 'chưa đầy đủ' %></p>
                  <% if rep['narrative'].present? %>
                    <div class="qcc-report-narrative" style="margin-bottom: 12px;">
                      <%= truncate(rep['narrative'], length: 220) %>
                    </div>
                  <% end %>
                  <button type="button" class="qcc-btn-xs qcc-btn-primary qcc-read-report-btn" data-report-id="<%= rep['id'] || rep['report_id'] %>" data-report-title="<%= rep['title'] || 'Báo cáo Tiến độ Phát triển AI Engineering' %>" data-report-type="<%= rep['report_type'] || 'DAILY' %>" data-report-time="<%= rep['created_iso'] || rep['created_at'] || 'Vừa xong' %>">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                    <span>Xem toàn văn</span>
                  </button>
                  <script type="application/json" id="rep-narrative-<%= rep['id'] || rep['report_id'] %>">
                    <%= json_escape((rep['narrative'].presence || rep['content'].presence || rep.dig('document', 'narrative').presence || 'Không có nội dung chi tiết.').to_json).html_safe %>
                  </script>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>

      <!-- TAB 7: KNOWLEDGE & SECOND BRAIN -->
      <section id="tab-knowledge" class="qcc-tab-pane" role="tabpanel">
        <div class="qcc-card">
          <div class="qcc-card-header">
            <div>
              <h3 class="qcc-card-title">Bộ máy Tìm kiếm Tri thức Thứ hai (Second Brain / RAG)</h3>
              <p class="qcc-card-sub">Qdrant Vector Database (1024-dim BGE-M3) kết hợp SQLite FTS5 BM25 Lexical Retrieval</p>
            </div>
            <span class="qcc-chip qcc-chip-purple">Số vector: chưa đo tại màn hình này</span>
          </div>

          <!-- Knowledge Search Box -->
          <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-knowledge-form" do %>
            <%= hidden_field_tag :tool, 'knowledge_search' %>
            <div class="qcc-search-bar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input type="text" name="knowledge_query" class="qcc-search-input" placeholder="Tìm kiếm tài liệu, work packages, mã nguồn, trích dẫn (ví dụ: route GET /healthz)..." value="<%= params[:knowledge_query] %>">
              <button type="submit" class="qcc-btn qcc-btn-primary">Tìm kiếm Tri thức</button>
            </div>
          <% end %>

          <p class="qcc-text-muted">Exact ID/citation đã kiểm tra; semantic retrieval chưa đạt benchmark. Không có kết quả không chứng minh tài liệu không tồn tại.</p>
          <!-- Search Results / Citations Area -->
          <div id="qcc-knowledge-results" class="qcc-knowledge-results">
            <% if @knowledge && @knowledge['items'] && @knowledge['items'].any? %>
              <h4 class="qcc-results-heading">Kết quả tìm kiếm từ Second Brain (<%= @knowledge['items'].size %> mục):</h4>
              <% @knowledge['items'].each do |item| %>
                <div class="qcc-knowledge-item">
                  <div class="qcc-knowledge-header">
                    <span class="qcc-chip qcc-chip-cyan"><%= item['match_type'] || 'UNKNOWN' %></span> · Native version <%= item['lock_version'] || 'UNKNOWN' %>
                    <strong class="qcc-knowledge-title"><%= item['title'] %></strong>
                    <span class="qcc-knowledge-score">Score: <%= item['score'] ? sprintf("%.2f", item['score']) : 'N/A' %></span>
                  </div>
                  <p class="qcc-knowledge-snippet"><%= item['snippet'] %></p>
                  <% if item['citation'].to_s.match?(%r{\A/work_packages/[1-9]\d*(?:/activity)?\z}) %>
                    <div class="qcc-knowledge-cite">Trích dẫn: <a href="<%= item['citation'] %>" target="_blank"><%= item['citation'] %></a></div>
                  <% end %>
                </div>
              <% end %>
            <% elsif @knowledge && @knowledge['items'] %>
              <div class="qcc-empty-state text-muted" style="padding: 24px; text-align: center; border: 1px dashed var(--qcc-border); border-radius: 8px;">
                Không tìm thấy tài liệu phù hợp trong Second Brain cho truy vấn "<%= params[:knowledge_query] %>".
              </div>
            <% else %>
              <div class="qcc-empty-state text-muted" style="padding: 24px; text-align: center; border: 1px dashed var(--qcc-border); border-radius: 8px;">
                Nhập từ khóa (ví dụ: route GET /healthz, sqlite, task) vào ô tìm kiếm ở trên để truy vấn kho tri thức Second Brain.
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <!-- TAB 8: SYSTEM INTEGRATIONS -->
      <section id="tab-integrations" data-qcc-live class="qcc-tab-pane" role="tabpanel">
        <%= render partial: 'qldapm_ai/engineering_integrations', locals: {eng: eng, format_vn_time: format_vn_time} %>
      </section>
    </main>
  </div>

  <!-- AI WORK INTAKE MODAL (Phase 3.2: PM/BA Planning) -->
  <div id="qcc-intake-modal" class="qcc-modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-intake-title">
    <div class="qcc-modal-box" style="max-width: 640px;">
      <div class="qcc-modal-header">
        <h3 id="modal-intake-title" class="qcc-modal-title">Giao việc mới cho AI · Phân tích Yêu cầu & Lập Kế hoạch</h3>
        <button type="button" class="qcc-modal-close" data-action="close-modal" aria-label="Đóng modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", id: 'qcc-intake-form' do %>
        <%= hidden_field_tag :tool, 'engineering_plan' %>
        <%= hidden_field_tag :arguments, {native_id: parent_id, lock_version: parent_lock}.to_json %>

        <div class="qcc-modal-body">
          <p class="qcc-modal-desc">
            Nhập yêu cầu tính năng, User Story hoặc cải tiến bằng ngôn ngữ tự nhiên. 
            <strong>Tác nhân BA</strong> sẽ phân tích đặc tả kỹ thuật và tiêu chí chấp nhận (AC); 
            <strong>Tác nhân PM</strong> sẽ phân rã thành các Engineering Units và tự động tạo Work Package con trên OpenProject.
          </p>

          <div class="qcc-form-group">
            <label for="engineering_feedback" style="display:block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: #E6EDF3;">
              Mô tả yêu cầu / Tính năng mới:
            </label>
            <textarea id="engineering_feedback" name="engineering_feedback" class="qcc-textarea" rows="5" maxlength="6000" placeholder="Ví dụ: Bổ sung tính năng lọc công việc theo danh mục (category) và xuất danh sách ra file CSV. Cần kiểm tra quyền người dùng trước khi xuất và có unit test đi kèm..." required style="width: 100%; border-radius: 6px; padding: 12px; background: #0D1117; color: #E6EDF3; border: 1px solid #30363D; font-family: inherit; font-size: 13px; resize: vertical; box-sizing: border-box;"></textarea>
          </div>

          <div class="qcc-info-box" style="margin-top: 12px; padding: 10px 14px; background: rgba(56, 189, 248, 0.08); border-left: 3px solid #38BDF8; border-radius: 4px; font-size: 12px; color: #94A3B8;">
            <strong style="color: #38BDF8;">Quy trình tiếp nhận tự động:</strong>
            Yêu cầu sẽ được tạo thành Unit mới trong Backlog ở trạng thái <code>PLANNED</code>. Sau đó bạn có thể nhấn <code>RUN ONCE</code> hoặc bật <code>AUTO</code> để Dev Agent viết code, Reviewer kiểm tra diff và QA chạy pytest tạo PR trên GitHub.
          </div>
        </div>

        <div class="qcc-modal-footer">
          <button type="button" class="qcc-btn qcc-btn-slate" data-action="close-modal">Đóng</button>
          <button type="submit" class="qcc-btn qcc-btn-primary" id="btn-submit-intake">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            <span>Gửi tới PM/BA Agent</span>
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- EXECUTION INSPECTOR MODAL (Phase 3.2: DAG & Detailed Agent Communication) -->
  <div id="qcc-run-modal" class="qcc-modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-run-title">
    <div class="qcc-modal-box" style="max-width: 960px; width: 92vw; max-height: 90vh; display: flex; flex-direction: column;">
      <div class="qcc-modal-header" style="flex-shrink: 0;">
        <div>
          <h3 id="modal-run-title" class="qcc-modal-title" style="display: flex; align-items: center; gap: 8px;">
            <span>Chi tiết Thực thi & Giám sát Tác nhân</span>
            <span id="qcc-run-modal-status-badge" class="qcc-chip qcc-chip-cyan">LOADING</span>
          </h3>
          <p class="qcc-card-sub" style="margin: 4px 0 0 0;">Run ID: <code id="qcc-run-modal-id" class="text-cyan">...</code> · Đơn vị: <strong id="qcc-run-modal-unit" class="text-white">...</strong></p>
        </div>
        <button type="button" class="qcc-modal-close" data-action="close-modal" aria-label="Đóng modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <section id="qcc-run-summary" class="qcc-run-summary" aria-live="polite"></section>

      <!-- Quick Metrics Bar -->
      <div class="qcc-run-metrics-strip" style="background: #111827; padding: 10px 20px; display: flex; gap: 20px; border-bottom: 1px solid #1F2937; flex-shrink: 0; font-size: 12px; flex-wrap: wrap;">
        <div><span class="text-slate">Thời gian chạy:</span> <strong id="qcc-run-metric-duration" class="text-white">--</strong></div>
        <div><span class="text-slate">Mô hình AI:</span> <strong id="qcc-run-metric-model" class="text-cyan">gemini-3.5-flash-lite</strong></div>
        <div><span class="text-slate">Tokens (Lượt chạy này):</span> <strong id="qcc-run-metric-tokens" class="text-white" title="Tokens tiêu thụ trong riêng Run ID này. Quota tích lũy toàn hệ thống xem tại KPI Header">--</strong></div>
        <div><span class="text-slate">Cuộc gọi API:</span> <strong id="qcc-run-metric-calls" class="text-emerald">--</strong></div>
        <div><span class="text-slate">Tác nhân tham gia:</span> <strong id="qcc-run-metric-agents" class="text-purple">--</strong></div>
      </div>

      <!-- Modal Sub-navigation Tabs -->
      <div class="qcc-modal-subnav" style="background: #0B0F19; border-bottom: 1px solid #1F2937; padding: 0 20px; display: flex; gap: 8px; flex-shrink: 0;">
        <button type="button" class="qcc-subnav-btn active" data-subtab="subtab-dag">Sơ đồ Tương tác DAG</button>
        <button type="button" class="qcc-subnav-btn" data-subtab="subtab-events">Dòng sự kiện (Timeline)</button>
        <button type="button" class="qcc-subnav-btn" data-subtab="subtab-diff">Mã nguồn & Diff</button>
        <button type="button" class="qcc-subnav-btn" data-subtab="subtab-qa">Bằng chứng QA & Test</button>
        <button type="button" class="qcc-subnav-btn" data-subtab="subtab-raw">Raw Telemetry</button>
      </div>

      <div class="qcc-modal-body" style="flex: 1; overflow-y: auto; padding: 20px;">
        <!-- Subtab 1: DAG Flow -->
        <div id="subtab-dag" class="qcc-subtab-pane active">
          <div id="qcc-dag-container" class="qcc-dag-wrapper" style="display: flex; flex-direction: column; gap: 12px;">
            <!-- Dynamic nodes rendered via JS -->
          </div>
        </div>

        <!-- Subtab 2: Events Timeline -->
        <div id="subtab-events" class="qcc-subtab-pane" style="display: none;">
          <label>Timeline filter <select id="qcc-event-filter" class="qcc-input"><option value="all">All</option><option value="milestones">Milestones</option><option value="errors">Errors</option><option value="model">Model calls</option><option value="tool">Tool calls</option></select></label>
          <table class="qcc-table" style="font-size: 12px;">
            <thead>
              <tr>
                <th>STT</th>
                <th>Thời điểm</th>
                <th>Tác nhân</th>
                <th>Sự kiện</th>
                <th>Trạng thái</th>
              </tr>
            </thead>
            <tbody id="qcc-events-tbody">
              <!-- Dynamic events rendered via JS -->
            </tbody>
          </table>
        </div>

        <!-- Subtab 3: Code Diff -->
        <div id="subtab-diff" class="qcc-subtab-pane" style="display: none;">
          <div id="qcc-diff-content" style="background: #030712; padding: 16px; border-radius: 6px; border: 1px solid #1F2937; font-family: monospace; font-size: 12px; white-space: pre-wrap; color: #E5E7EB;">
            <!-- Dynamic diff rendered via JS -->
          </div>
        </div>

        <!-- Subtab 4: QA Evidence -->
        <div id="subtab-qa" class="qcc-subtab-pane" style="display: none;">
          <div id="qcc-qa-content" style="background: #030712; padding: 16px; border-radius: 6px; border: 1px solid #1F2937; font-family: monospace; font-size: 12px; white-space: pre-wrap; color: #A7F3D0;">
            <!-- Dynamic QA test log rendered via JS -->
          </div>
        </div>

        <!-- Subtab 5: Raw JSON -->
        <div id="subtab-raw" class="qcc-subtab-pane" style="display: none;">
          <pre id="qcc-raw-content" style="background: #030712; padding: 16px; border-radius: 6px; border: 1px solid #1F2937; font-size: 11px; overflow-x: auto; color: #94A3B8; max-height: 400px;"></pre>
        </div>
      </div>

      <div class="qcc-modal-footer" style="flex-shrink: 0;">
        <button type="button" class="qcc-btn qcc-btn-slate" data-action="close-modal">Đóng</button>
      </div>
    </div>
  </div>

  <!-- REPORT READER MODAL (Phase 3.2: Full Markdown Viewer) -->
  <%= render partial: 'qldapm_ai/engineering_report_reader' %>

  <!-- SCHEDULE CONFIGURATION MODAL (Finding G & UI) -->
  <div id="schedule-config-modal" class="qcc-modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-sched-title">
    <div class="qcc-modal-box">
      <div class="qcc-modal-header">
        <h3 id="modal-sched-title" class="qcc-modal-title">Cấu hình Lịch Báo cáo Tự động</h3>
        <button type="button" class="qcc-modal-close" data-action="close-modal" aria-label="Đóng modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", id: 'qcc-schedule-form' do %>
        <%= hidden_field_tag :tool, 'engineering_report_schedule_update' %>
        <%= hidden_field_tag :arguments, '', id: 'qcc-schedule-args' %>

        <div class="qcc-modal-body">
          <p class="qcc-modal-desc">
            Cấu hình thời gian hệ thống tự động tổng hợp báo cáo tiến độ bằng background daemon timer độc lập trong múi giờ <strong>Asia/Ho_Chi_Minh (UTC+7)</strong>.
          </p>

          <!-- Daily Schedule Form Group -->
          <div class="qcc-form-group">
            <label class="qcc-checkbox-label">
              <input type="checkbox" id="sched_daily_enabled" <%= 'checked' if [true,1].include?(sched['daily_enabled']) %>>
              <strong>Bật báo cáo hằng ngày (Daily Report)</strong>
            </label>
            <div class="qcc-time-pickers">
              <div class="qcc-field">
                <span>Giờ (0-23):</span>
                <input type="number" id="sched_daily_hour" class="qcc-input-number" min="0" max="23" value="<%= sched['daily_hour'] || 7 %>">
              </div>
              <div class="qcc-field">
                <span>Phút (0-59):</span>
                <input type="number" id="sched_daily_minute" class="qcc-input-number" min="0" max="59" value="<%= sched['daily_minute'] || 30 %>">
              </div>
            </div>
          </div>

          <!-- Weekly Schedule Form Group -->
          <div class="qcc-form-group">
            <label class="qcc-checkbox-label">
              <input type="checkbox" id="sched_weekly_enabled" <%= 'checked' if [true,1].include?(sched['weekly_enabled']) %>>
              <strong>Bật báo cáo hằng tuần (Weekly Report)</strong>
            </label>
            <div class="qcc-time-pickers">
              <div class="qcc-field">
                <span>Thứ (1=Thứ Hai .. 7=Chủ Nhật):</span>
                <input type="number" id="sched_weekly_day" class="qcc-input-number" min="1" max="7" value="<%= sched['weekly_day'] || 1 %>">
              </div>
              <div class="qcc-field">
                <span>Giờ:</span>
                <input type="number" id="sched_weekly_hour" class="qcc-input-number" min="0" max="23" value="<%= sched['weekly_hour'] || 9 %>">
              </div>
              <div class="qcc-field">
                <span>Phút:</span>
                <input type="number" id="sched_weekly_minute" class="qcc-input-number" min="0" max="59" value="<%= sched['weekly_minute'] || 0 %>">
              </div>
            </div>
          </div>
        </div>

        <div class="qcc-modal-footer">
          <button type="button" class="qcc-btn qcc-btn-slate" data-action="close-modal">Đóng</button>
          <button type="submit" class="qcc-btn qcc-btn-primary" id="btn-save-schedule" data-action="save-schedule">Lưu cấu hình</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- SCOPED CSS STYLESHEET (Dark-First OLED & Swiss Precision) -->
<style>
  :root {
    --qcc-bg: #090D16;
    --qcc-surface: #0F172A;
    --qcc-card: #131E35;
    --qcc-card-hover: #192744;
    --qcc-border: #1E293B;
    --qcc-border-subtle: rgba(255, 255, 255, 0.08);
    --qcc-text-main: #F8FAFC;
    --qcc-text-muted: #94A3B8;
    --qcc-text-dim: #64748B;
    --qcc-primary: #6366F1;
    --qcc-primary-hover: #4F46E5;
    --qcc-cyan: #06B6D4;
    --qcc-emerald: #10B981;
    --qcc-amber: #F59E0B;
    --qcc-rose: #EF4444;
    --qcc-purple: #A855F7;
    --qcc-radius-sm: 6px;
    --qcc-radius-md: 10px;
    --qcc-radius-lg: 14px;
    --qcc-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --qcc-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace;
  }

  /* Reset OpenProject wrapper padding for Command Center full width */
  #content-wrapper, #content {
    background: var(--qcc-bg) !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .qcc-root {
    font-family: var(--qcc-font);
    background: var(--qcc-bg);
    color: var(--qcc-text-main);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .qcc-root *, .qcc-root *::before, .qcc-root *::after {
    box-sizing: inherit;
  }

  /* Top Animated Indicator */
  .qcc-top-progress {
    height: 3px;
    background: linear-gradient(90deg, #6366F1, #06B6D4, #10B981);
    opacity: 0.6;
  }
  .qcc-top-progress.active {
    opacity: 1;
    background-size: 200% 100%;
    animation: qcc-shimmer 2s infinite linear;
  }
  @keyframes qcc-shimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  /* Shell Grid */
  .qcc-shell {
    display: flex;
    flex: 1;
    min-height: calc(100vh - 3px);
  }

  /* Left Sidebar */
  .qcc-sidebar {
    width: 260px;
    background: var(--qcc-surface);
    border-right: 1px solid var(--qcc-border);
    display: flex;
    flex-direction: column;
    padding: 20px 14px;
    flex-shrink: 0;
  }

  .qcc-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px 18px 8px;
    border-bottom: 1px solid var(--qcc-border-subtle);
  }
  .qcc-brand-icon {
    width: 36px;
    height: 36px;
    background: rgba(99, 102, 241, 0.15);
    color: var(--qcc-primary);
    border-radius: var(--qcc-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }
  .qcc-brand-name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #FFFFFF;
  }
  .qcc-brand-sub {
    font-size: 11px;
    color: var(--qcc-text-muted);
  }

  .qcc-project-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 8px;
    padding: 6px 10px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--qcc-radius-sm);
    font-size: 12px;
    color: var(--qcc-cyan);
    font-family: var(--qcc-mono);
  }
  .qcc-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .qcc-badge-dot.alive {
    background: var(--qcc-emerald);
    box-shadow: 0 0 8px var(--qcc-emerald);
  }
  .qcc-badge-dot.idle {
    background: var(--qcc-text-dim);
  }

  /* Navigation */
  .qcc-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 10px;
    flex: 1;
  }
  .qcc-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-radius: var(--qcc-radius-sm);
    color: var(--qcc-text-muted);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: all 180ms ease;
  }
  .qcc-nav-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--qcc-text-main);
  }
  .qcc-nav-item.active {
    background: rgba(99, 102, 241, 0.15);
    color: #FFFFFF;
    border-left: 3px solid var(--qcc-primary);
  }
  .qcc-nav-pill {
    margin-left: auto;
    font-size: 11px;
    padding: 2px 7px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    color: var(--qcc-text-muted);
    font-family: var(--qcc-mono);
  }

  /* Sidebar Footer */
  .qcc-sidebar-footer {
    border-top: 1px solid var(--qcc-border-subtle);
    padding-top: 14px;
    margin-top: auto;
  }
  .qcc-user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px;
    margin-bottom: 10px;
  }
  .qcc-user-avatar {
    width: 32px;
    height: 32px;
    background: var(--qcc-primary);
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
  }
  .qcc-user-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--qcc-text-main);
  }
  .qcc-user-role {
    font-size: 11px;
    color: var(--qcc-cyan);
    font-family: var(--qcc-mono);
  }
  .qcc-footer-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .qcc-footer-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    color: var(--qcc-text-dim);
    font-size: 12px;
    text-decoration: none;
    border-radius: var(--qcc-radius-sm);
    transition: color 150ms ease;
  }
  .qcc-footer-link:hover {
    color: var(--qcc-text-main);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Main Canvas */
  .qcc-main {
    flex: 1;
    padding: 24px 32px 60px 32px;
    overflow-y: auto;
  }

  /* Header */
  .qcc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--qcc-border);
    margin-bottom: 20px;
  }
  .qcc-header-title {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 6px 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .qcc-header-meta {
    font-size: 13px;
    color: var(--qcc-text-muted);
    margin: 0;
  }
  .qcc-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .qcc-action-form {
    display: inline-block;
    margin: 0;
  }

  /* Buttons */
  .qcc-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--qcc-radius-sm);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 180ms ease;
    text-decoration: none;
    outline: none;
  }
  .qcc-btn:focus-visible {
    outline: 2px solid var(--qcc-primary);
    outline-offset: 2px;
  }
  .qcc-btn.loading {
    opacity: 0.6;
    pointer-events: none;
  }
  .qcc-btn-primary {
    background: var(--qcc-primary);
    color: #FFFFFF;
  }
  .qcc-btn-primary:hover {
    background: var(--qcc-primary-hover);
  }
  .qcc-btn-emerald {
    background: rgba(16, 185, 129, 0.15);
    color: var(--qcc-emerald);
    border-color: rgba(16, 185, 129, 0.4);
  }
  .qcc-btn-emerald:hover {
    background: var(--qcc-emerald);
    color: #090D16;
  }
  .qcc-btn-slate {
    background: rgba(255, 255, 255, 0.08);
    color: var(--qcc-text-main);
    border-color: var(--qcc-border);
  }
  .qcc-btn-slate:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .qcc-btn-amber {
    background: rgba(245, 158, 11, 0.15);
    color: var(--qcc-amber);
    border-color: rgba(245, 158, 11, 0.4);
  }
  .qcc-btn-amber:hover {
    background: var(--qcc-amber);
    color: #090D16;
  }
  .qcc-btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--qcc-text-main);
    border-color: var(--qcc-border);
  }
  .qcc-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .qcc-btn-xs {
    padding: 3px 8px;
    font-size: 11px;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    border: none;
  }
  .qcc-btn-rose {
    background: rgba(239, 68, 68, 0.2);
    color: var(--qcc-rose);
  }
  .qcc-btn-rose:hover {
    background: var(--qcc-rose);
    color: #FFFFFF;
  }
  .qcc-btn-link {
    color: var(--qcc-cyan);
    font-size: 12px;
    text-decoration: none;
  }
  .qcc-btn-link:hover {
    text-decoration: underline;
  }

  /* Chips & Badges */
  .qcc-chip-mode {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--qcc-mono);
  }
  .qcc-chip-mode.mode-auto {
    background: rgba(16, 185, 129, 0.2);
    color: var(--qcc-emerald);
    border: 1px solid rgba(16, 185, 129, 0.5);
  }
  .qcc-chip-mode.mode-off {
    background: rgba(100, 116, 139, 0.2);
    color: var(--qcc-text-dim);
    border: 1px solid rgba(100, 116, 139, 0.4);
  }
  .qcc-chip-mode.mode-paused {
    background: rgba(245, 158, 11, 0.2);
    color: var(--qcc-amber);
    border: 1px solid rgba(245, 158, 11, 0.5);
  }
  .qcc-chip-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: qcc-blink 1.5s infinite;
  }
  @keyframes qcc-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .qcc-chip {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--qcc-mono);
  }
  .qcc-chip-emerald { background: rgba(16, 185, 129, 0.15); color: var(--qcc-emerald); }
  .qcc-chip-cyan { background: rgba(6, 182, 212, 0.15); color: var(--qcc-cyan); }
  .qcc-chip-blue { background: rgba(59, 130, 246, 0.15); color: #60A5FA; }
  .qcc-chip-purple { background: rgba(168, 85, 247, 0.15); color: var(--qcc-purple); }
  .qcc-chip-amber { background: rgba(245, 158, 11, 0.15); color: var(--qcc-amber); }
  .qcc-chip-rose { background: rgba(239, 68, 68, 0.15); color: var(--qcc-rose); }
  .qcc-chip-subtle { background: rgba(255, 255, 255, 0.05); color: var(--qcc-text-dim); font-size: 10px; }

  /* Notifications */
  .qcc-notifications-section {
    margin-bottom: 20px;
  }
  .qcc-notif-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: var(--qcc-radius-md);
    font-size: 13px;
  }
  .qcc-notif-subtle {
    background: rgba(255, 255, 255, 0.02);
    border-color: var(--qcc-border);
    color: var(--qcc-text-muted);
  }
  .qcc-notif-content {
    flex: 1;
  }
  .qcc-notif-close {
    background: transparent;
    border: none;
    color: var(--qcc-text-dim);
    cursor: pointer;
  }
  .qcc-notif-close:hover {
    color: var(--qcc-text-main);
  }

  /* Cards */
  .qcc-card {
    background: var(--qcc-card);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-lg);
    padding: 20px;
    margin-bottom: 20px;
  }
  .qcc-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .qcc-card-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 4px 0;
    color: var(--qcc-text-main);
  }
  .qcc-card-sub {
    font-size: 13px;
    color: var(--qcc-text-muted);
    margin: 0;
  }

  /* Active Mission Hero */
  .qcc-mission-hero {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(6, 182, 212, 0.06) 100%), var(--qcc-card);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: var(--qcc-radius-lg);
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  .qcc-mission-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--qcc-cyan);
    font-family: var(--qcc-mono);
    margin-bottom: 8px;
  }
  .qcc-mission-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #FFFFFF;
  }
  .qcc-mission-desc {
    font-size: 14px;
    color: var(--qcc-text-muted);
    margin: 0 0 16px 0;
    line-height: 1.5;
  }
  .qcc-mission-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .qcc-tag {
    font-size: 12px;
    background: rgba(0, 0, 0, 0.3);
    padding: 4px 10px;
    border-radius: var(--qcc-radius-sm);
    border: 1px solid var(--qcc-border-subtle);
  }

  /* KPI Grid */
  .qcc-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }
  .qcc-kpi-card {
    background: var(--qcc-card);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-md);
    padding: 16px 18px;
  }
  .qcc-kpi-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .qcc-kpi-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--qcc-text-dim);
  }
  .qcc-kpi-value {
    font-size: 24px;
    font-weight: 700;
    color: var(--qcc-text-main);
    margin-bottom: 4px;
  }
  .qcc-kpi-sub {
    font-size: 12px;
    color: var(--qcc-text-muted);
  }

  /* Pipeline Visualization */
  .qcc-pipeline-flow {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    padding: 12px 4px;
  }
  .qcc-stage-node {
    flex: 1;
    min-width: 105px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-md);
    padding: 12px 10px;
    text-align: center;
    transition: all 180ms ease;
  }
  .qcc-stage-node.done {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.04);
  }
  .qcc-stage-icon {
    width: 28px;
    height: 28px;
    margin: 0 auto 6px auto;
    background: rgba(16, 185, 129, 0.15);
    color: var(--qcc-emerald);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 11px;
    font-family: var(--qcc-mono);
  }
  .qcc-stage-name {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 2px;
  }
  .qcc-stage-sub {
    font-size: 10px;
    color: var(--qcc-text-dim);
    margin-bottom: 4px;
  }
  .qcc-stage-state {
    font-size: 10px;
    font-weight: 700;
    color: var(--qcc-emerald);
    font-family: var(--qcc-mono);
  }
  .qcc-stage-arrow {
    width: 12px;
    height: 2px;
    background: rgba(16, 185, 129, 0.5);
    flex-shrink: 0;
  }

  /* Split Grid */
  .qcc-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 900px) {
    .qcc-split-grid { grid-template-columns: 1fr; }
  }

  /* Units List */
  .qcc-units-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .qcc-unit-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-sm);
  }
  .qcc-unit-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .bullet-emerald { background: var(--qcc-emerald); box-shadow: 0 0 6px var(--qcc-emerald); }
  .bullet-cyan { background: var(--qcc-cyan); box-shadow: 0 0 6px var(--qcc-cyan); }
  .qcc-unit-info { flex: 1; }
  .qcc-unit-title { font-size: 13px; font-weight: 600; color: var(--qcc-text-main); margin-bottom: 2px; }
  .qcc-unit-meta { font-size: 11px; color: var(--qcc-text-dim); }

  /* Audit List */
  .qcc-audit-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .qcc-audit-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--qcc-text-muted);
    line-height: 1.4;
  }
  .qcc-audit-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-top: 6px;
    flex-shrink: 0;
  }
  .dot-emerald { background: var(--qcc-emerald); }

  /* Tables */
  .qcc-table-wrapper {
    overflow-x: auto;
  }
  .qcc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }
  .qcc-table th {
    padding: 10px 14px;
    border-bottom: 1px solid var(--qcc-border);
    color: var(--qcc-text-dim);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .qcc-table td {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: var(--qcc-text-main);
    vertical-align: middle;
  }
  .qcc-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }
  .row-parent td {
    background: rgba(99, 102, 241, 0.05);
    border-bottom: 1px solid rgba(99, 102, 241, 0.2);
  }
  .qcc-pr-link {
    color: var(--qcc-cyan);
    text-decoration: none;
    font-weight: 500;
  }
  .qcc-pr-link:hover {
    text-decoration: underline;
  }
  .qcc-badge-stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .qcc-review-badge {
    font-size: 11px;
    color: var(--qcc-emerald);
  }

  /* Agent Grid */
  .qcc-agent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .qcc-agent-card {
    background: var(--qcc-card);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-lg);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 180ms ease, border-color 180ms ease;
  }
  .qcc-agent-card:hover {
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateY(-2px);
  }
  .qcc-agent-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .qcc-agent-avatar {
    width: 38px;
    height: 38px;
    border-radius: var(--qcc-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 12px;
    color: #FFFFFF;
    font-family: var(--qcc-mono);
  }
  .bg-indigo { background: #6366F1; }
  .bg-blue { background: #3B82F6; }
  .bg-teal { background: #0D9488; }
  .bg-emerald { background: #10B981; }
  .bg-amber { background: #F59E0B; }
  .bg-rose { background: #EF4444; }
  .bg-purple { background: #A855F7; }

  .qcc-agent-info { flex: 1; min-width: 0; }
  .qcc-agent-name { font-size: 15px; font-weight: 700; margin: 0 0 2px 0; color: var(--qcc-text-main); }
  .qcc-agent-role { font-size: 12px; color: var(--qcc-text-muted); }
  .qcc-agent-details {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
    background: rgba(0, 0, 0, 0.2);
    padding: 10px 12px;
    border-radius: var(--qcc-radius-sm);
  }
  .qcc-agent-row { display: flex; flex-wrap: wrap; justify-content: space-between; color: var(--qcc-text-muted); }
  .qcc-agent-skills { display: flex; gap: 6px; flex-wrap: wrap; }
  .qcc-skill-pill {
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    background: rgba(99, 102, 241, 0.1);
    color: #A5B4FC;
    border-radius: 4px;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  /* Services Grid */
  .qcc-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .qcc-service-card {
    background: var(--qcc-card);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-md);
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .qcc-service-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--qcc-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 12px;
    color: #FFFFFF;
    flex-shrink: 0;
  }
  .qcc-service-name { font-size: 14px; font-weight: 600; color: var(--qcc-text-main); margin-bottom: 2px; }
  .qcc-service-port { font-size: 11px; color: var(--qcc-text-dim); margin-bottom: 4px; font-family: var(--qcc-mono); }
  .qcc-service-status { font-size: 11px; font-weight: 700; }

  /* Reports Grid */
  .qcc-reports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .qcc-report-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-md);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .qcc-report-top { display: flex; justify-content: space-between; align-items: center; }
  .qcc-report-time { font-size: 11px; color: var(--qcc-text-dim); font-family: var(--qcc-mono); }
  .qcc-report-title { font-size: 14px; font-weight: 600; margin: 0; color: var(--qcc-text-main); }
  .qcc-report-metrics {
    display: flex;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.2);
    padding: 8px 12px;
    border-radius: var(--qcc-radius-sm);
    font-size: 11px;
  }
  .qcc-report-metric span { display: block; color: var(--qcc-text-dim); }
  .qcc-report-metric strong { color: var(--qcc-cyan); font-size: 13px; }
  .qcc-report-narrative {
    font-size: 12px;
    color: var(--qcc-text-muted);
    line-height: 1.4;
    background: rgba(255, 255, 255, 0.01);
    padding: 8px;
    border-radius: var(--qcc-radius-sm);
  }

  /* Knowledge Search */
  .qcc-search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-md);
    padding: 8px 14px;
    margin-bottom: 20px;
  }
  .qcc-search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--qcc-text-main);
    font-size: 14px;
    outline: none;
  }
  .qcc-knowledge-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-md);
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .qcc-knowledge-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .qcc-knowledge-title { font-size: 14px; color: var(--qcc-text-main); flex: 1; }
  .qcc-knowledge-score { font-size: 11px; color: var(--qcc-cyan); font-family: var(--qcc-mono); }
  .qcc-knowledge-snippet { font-size: 13px; color: var(--qcc-text-muted); line-height: 1.5; margin: 0 0 8px 0; }
  .qcc-knowledge-cite a { color: var(--qcc-primary); font-size: 12px; text-decoration: none; }
  .qcc-knowledge-cite a:hover { text-decoration: underline; }

  /* Modals */
  .qcc-modal-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
  }
  .qcc-modal-box {
    background: var(--qcc-card);
    border: 1px solid var(--qcc-border);
    border-radius: var(--qcc-radius-lg);
    width: 100%;
    max-width: 520px;
    padding: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }
  .qcc-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .qcc-modal-title { font-size: 18px; font-weight: 700; margin: 0; color: #FFFFFF; }
  .qcc-modal-close { background: transparent; border: none; color: var(--qcc-text-dim); cursor: pointer; }
  .qcc-modal-close:hover { color: #FFFFFF; }
  .qcc-modal-desc { font-size: 13px; color: var(--qcc-text-muted); margin: 0 0 20px 0; line-height: 1.5; }
  .qcc-form-group {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--qcc-border-subtle);
    border-radius: var(--qcc-radius-md);
    padding: 14px;
    margin-bottom: 14px;
  }
  .qcc-checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--qcc-text-main);
    cursor: pointer;
    margin-bottom: 10px;
  }
  .qcc-time-pickers { display: flex; gap: 14px; }
  .qcc-field { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--qcc-text-muted); }
  .qcc-input-number {
    width: 60px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--qcc-border);
    border-radius: 4px;
    color: #FFFFFF;
    padding: 4px 6px;
    font-size: 13px;
    font-family: var(--qcc-mono);
  }
  .qcc-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--qcc-border);
  }

  /* Tab pane toggle */
  .qcc-tab-pane { display: none; }
  .qcc-tab-pane.active { display: block; animation: qcc-fadeIn 200ms ease; }
  @keyframes qcc-fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Utility */
  .text-emerald { color: var(--qcc-emerald) !important; }
  .text-cyan { color: var(--qcc-cyan) !important; }
  .text-slate { color: var(--qcc-text-dim) !important; }
  .text-purple { color: var(--qcc-purple) !important; }
  .text-amber { color: var(--qcc-amber) !important; }
  .text-rose { color: var(--qcc-rose) !important; }
  .text-center { text-align: center; }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .qcc-shell { flex-direction: column; }
    .qcc-sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--qcc-border); }
    .qcc-nav { flex-direction: row; flex-wrap: wrap; }
    .qcc-nav-item { width: auto; }
  }

  /* Modal Sub-navigation & DAG styling (Phase 3.2) */
  .qcc-subnav-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #94A3B8;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .qcc-subnav-btn:hover { color: #E6EDF3; }
  .qcc-subnav-btn.active {
    color: #38BDF8;
    border-bottom-color: #38BDF8;
    font-weight: 600;
  }
  .qcc-dag-node-box {
    background: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .qcc-dag-node-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .qcc-dag-arrow {
    display: flex;
    justify-content: center;
    color: #475569;
    font-size: 14px;
  }

  /* Toast Notification Alerts & Spinners (Phase 2.9.2) */
  .qcc-toast-container {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 440px;
    pointer-events: none;
  }
  .qcc-toast {
    pointer-events: auto;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 18px;
    border-radius: var(--qcc-radius);
    background: #0F172A;
    border: 1px solid var(--qcc-border);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    animation: qccToastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  @keyframes qccToastIn {
    from { opacity: 0; transform: translateY(-12px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .qcc-toast-success {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(15, 23, 42, 0.98);
  }
  .qcc-toast-success .qcc-toast-icon {
    color: var(--qcc-emerald);
    background: rgba(16, 185, 129, 0.15);
  }
  .qcc-toast-error {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(15, 23, 42, 0.98);
  }
  .qcc-toast-error .qcc-toast-icon {
    color: var(--qcc-rose);
    background: rgba(239, 68, 68, 0.15);
  }
  .qcc-toast-info {
    border-color: rgba(6, 182, 212, 0.4);
    background: rgba(15, 23, 42, 0.98);
  }
  .qcc-toast-info .qcc-toast-icon {
    color: var(--qcc-cyan);
    background: rgba(6, 182, 212, 0.15);
  }
  .qcc-toast-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .qcc-toast-content {
    flex: 1;
    min-width: 0;
  }
  .qcc-toast-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--qcc-text-main);
    margin-bottom: 2px;
  }
  .qcc-toast-body {
    font-size: 12px;
    color: var(--qcc-text-muted);
    line-height: 1.4;
    word-break: break-word;
  }
  .qcc-toast-close {
    background: none;
    border: none;
    color: var(--qcc-text-slate);
    font-size: 18px;
    cursor: pointer;
    padding: 0 4px;
    line-height: 1;
    transition: color 0.15s;
  }
  .qcc-toast-close:hover {
    color: var(--qcc-text-main);
  }
  .qcc-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: qccSpin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 6px;
  }
  @keyframes qccSpin {
    to { transform: rotate(360deg); }
  }
  button.submitting {
    opacity: 0.8 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
  }

  /* Phase3.1: readable summaries contain technical text at narrow widths and 200% zoom. */
  .qcc-root, .qcc-main, .qcc-tab-pane, .qcc-card, .qcc-agent-card, .qcc-modal-box, .qcc-modal-body { min-width: 0; max-width: 100%; box-sizing: border-box; }
  .qcc-root { overflow-wrap: anywhere; }
  .qcc-root details { min-width: 0; margin-top: 10px; }
  .qcc-root summary { cursor: pointer; padding: 8px 0; color: var(--qcc-cyan); }
  .qcc-root pre { white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; max-width: 100%; max-height: 420px; overflow: auto; }
  .qcc-root code, .qcc-agent-card, .qcc-agent-details, .qcc-agent-role, .qcc-chip, .qcc-tag { overflow-wrap: anywhere; white-space: normal; min-width: 0; }
  .qcc-agent-top { flex-wrap: wrap; }
  .qcc-agent-details { font-size: 13px; }
  .qcc-agent-details h5 { margin: 0; font-size: 14px; }
  .qcc-work-filters, .qcc-work-actions, .qcc-work-heading { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .qcc-work-heading { justify-content: space-between; }
  .qcc-work-heading > a, .qcc-work-heading > strong { flex: 1 1 240px; }
  .qcc-work-filters { padding: 0 0 16px; }
  .qcc-work-filters label { flex: 1 1 220px; }
  .qcc-work-filters input, .qcc-work-filters select, #qcc-plan-search { width: 100%; min-height: 40px; box-sizing: border-box; }
  .qcc-work-list { display: grid; gap: 12px; }
  .qcc-work-row { min-width: 0; border: 1px solid var(--qcc-border); border-radius: var(--qcc-radius-md); padding: 16px; background: rgba(15, 23, 42, .5); }
  .qcc-work-row[hidden], .qcc-root [hidden] { display: none !important; }
  .qcc-work-active { border-left: 4px solid var(--qcc-cyan); }
  .qcc-work-blocked { border-left: 4px solid var(--qcc-rose); }
  .qcc-work-selected { outline: 2px solid var(--qcc-cyan); outline-offset: 2px; }
  .qcc-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 20px; margin: 12px 0; }
  .qcc-summary-grid > div { min-width: 0; }
  .qcc-summary-grid dt { font-size: 12px; color: var(--qcc-text-muted); }
  .qcc-summary-grid dd { margin: 2px 0 0; font-size: 14px; color: var(--qcc-text-main); overflow-wrap: anywhere; }
  .qcc-run-summary { padding: 12px 20px; max-height: 40vh; overflow: auto; border-bottom: 1px solid var(--qcc-border); }
  .qcc-run-summary h4 { font-size: 16px; margin: 0 0 8px; }
  .qcc-plan-group { margin-top: 20px; }
  .qcc-plan-group .qcc-work-row { margin-top: 10px; }
  .qcc-stage-list { display: grid; gap: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .qcc-modal-subnav { flex-wrap: wrap; }
  .qcc-root button:focus-visible, .qcc-root a:focus-visible, .qcc-root summary:focus-visible, .qcc-root input:focus-visible, .qcc-root select:focus-visible { outline: 2px solid var(--qcc-cyan); outline-offset: 3px; }
  @media (max-width: 1500px) { .qcc-agent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .qcc-agent-grid, .qcc-summary-grid, .qcc-stage-list { grid-template-columns: minmax(0, 1fr); } .qcc-main { padding: 16px; } }
  @media (prefers-reduced-motion: reduce) { .qcc-root *, .qcc-root *::before, .qcc-root *::after { animation: none !important; transition: none !important; } }
</style>

<!-- CLIENT-SIDE INTERACTION SCRIPT -->
<%= nonced_javascript_tag do %>
  // QLDAPM Command Center — 100% CSP Unobtrusive Event Handling
  (window.qccPageHandlers || []).forEach(function(v){v[0].removeEventListener(v[1],v[2]);});
  window.qccPageHandlers=[];
  function qccOn(target,name,handler){target.addEventListener(name,handler);window.qccPageHandlers.push([target,name,handler]);}

  function restoreActiveTab() {
    var saved = '';
    if (window.location.hash && window.location.hash.startsWith('#tab-')) {
      saved = window.location.hash.substring(1);
    } else {
      try { saved = localStorage.getItem('qcc_active_tab'); } catch(e) {}
    }
    if (saved && document.getElementById(saved)) {
      document.querySelectorAll('.qcc-nav-item').forEach(function(btn) {
        if (btn.getAttribute('data-tab') === saved) btn.classList.add('active');
        else btn.classList.remove('active');
      });
      document.querySelectorAll('.qcc-tab-pane').forEach(function(pane) {
        if (pane.id === saved) pane.classList.add('active');
        else pane.classList.remove('active');
      });
    }
  }
  restoreActiveTab();
  ['turbo:load', 'DOMContentLoaded'].forEach(function(ev) {
    qccOn(document,ev, restoreActiveTab);
  });
  qccOn(document,'click', function(e) {
    // Tab Switching with LocalStorage and Hash Persistence
    var navItem = e.target.closest('.qcc-nav-item');
    if (navItem) {
      e.preventDefault();
      var targetTab = navItem.getAttribute('data-tab');
      if (!targetTab) return;

      document.querySelectorAll('.qcc-nav-item').forEach(function(btn) {
        btn.classList.remove('active');
      });
      navItem.classList.add('active');

      document.querySelectorAll('.qcc-tab-pane').forEach(function(pane) {
        pane.classList.remove('active');
      });

      var targetPane = document.getElementById(targetTab);
      if (targetPane) {
        targetPane.classList.add('active');
      }
      try { localStorage.setItem('qcc_active_tab', targetTab); } catch(err) {}
      if (history.replaceState) { history.replaceState(null, null, '#' + targetTab); }
      return;
    }

    // Open Schedule Modal
    var openModalBtn = e.target.closest('#btn-open-schedule-modal, [data-open-schedule]');
    if (openModalBtn) {
      e.preventDefault();
      var m = document.getElementById('schedule-config-modal');
      if (m) {
        var schedule=window.qccLive && window.qccLive.schedule;
        if(schedule){['daily_enabled','weekly_enabled'].forEach(function(k){var n=document.getElementById('sched_'+k);if(n)n.checked=schedule[k]===true || schedule[k]===1;});['daily_hour','daily_minute','weekly_day','weekly_hour','weekly_minute'].forEach(function(k){var n=document.getElementById('sched_'+k);if(n && schedule[k]!=null)n.value=schedule[k];});}
        m.style.display = 'flex';
        var firstInput = m.querySelector('input, button');
        if (firstInput) firstInput.focus();
      }
      return;
    }

    // Close Schedule Modal
    var closeModalBtn = e.target.closest('[data-action="close-modal"], .qcc-modal-close');
    if (closeModalBtn) {
      e.preventDefault();
      var m = document.getElementById('schedule-config-modal');
      if (m) m.style.display = 'none';
      return;
    }

    var dismissBtn = e.target.closest('[data-action="dismiss-toast"]');
    if (dismissBtn) {
      e.preventDefault();
      var toast = dismissBtn.closest('.qcc-notification-item');
      if (toast) toast.style.display = 'none';
      return;
    }

    // Close toast alert
    var closeToastBtn = e.target.closest('[data-action="close-toast"]');
    if (closeToastBtn) {
      e.preventDefault();
      var tItem = closeToastBtn.closest('.qcc-toast');
      if (tItem) {
        tItem.style.opacity = '0';
        tItem.style.transform = 'translateY(-10px)';
        setTimeout(function() { tItem.remove(); }, 300);
      }
      return;
    }
  });

  // Client-side Toast Helper Function
  function showClientToast(type, title, message) {
    var container = document.getElementById('qcc-toast-container');
    if (!container) return;
    var toast = document.createElement('div');
    toast.className = 'qcc-toast qcc-toast-' + (['success', 'error', 'info'].includes(type) ? type : 'info');
    toast.setAttribute('role', 'alert');
    toast.innerHTML = '<div class="qcc-toast-icon">' +
      (type === 'success' ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>' :
       type === 'error' ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' :
       '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>') +
      '</div>' +
      '<div class="qcc-toast-content">' +
      '<div class="qcc-toast-title">' + escapeQccHtml(title) + '</div>' +
      '<div class="qcc-toast-body">' + escapeQccHtml(message) + '</div>' +
      '</div>' +
      '<button type="button" class="qcc-toast-close" data-action="close-toast">&times;</button>';
    container.appendChild(toast);
    setTimeout(function() {
      if (toast && toast.parentNode) {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        setTimeout(function() { if (toast.parentNode) toast.remove(); }, 300);
      }
    }, 7000);
  }

  function resetSubmittingButtons() {
    document.querySelectorAll('form[data-qcc-submitting]').forEach(function(form) { delete form.dataset.qccSubmitting; });
    document.querySelectorAll('button.submitting').forEach(function(b) {
      b.disabled = false;
      b.classList.remove('submitting');
      var orig = b.getAttribute('data-original-html');
      if (orig) b.innerHTML = orig;
    });
    var progressBar = document.querySelector('.qcc-top-progress');
    if (progressBar) progressBar.classList.remove('active');
  }

  <%= render partial: 'qldapm_ai/engineering_owner_ux_script' %>

  // Phase3 owner live transport — one command, fresh projection, no navigation/replay.
  if (window.qccLive) window.qccLive.stop();
  if (window.qccSubmitHandler) document.removeEventListener('submit', window.qccSubmitHandler);
  if (window.qccStatusPoll) clearInterval(window.qccStatusPoll);
  if (window.qccPollController) window.qccPollController.abort();
  (function() {
    var live = window.qccLive = {stopped:false, epoch:0, revision:-1, pending:false, active:0, unknownRequest:window.qccUnknownRequest || null};
    var root=document.getElementById('qldapm-command-center');
    if(root && root.dataset.stateRevision)live.revision=Number(root.dataset.stateRevision);
    var timer, pollController, commandController, pollPromise;
    var regions = ['qcc-live-controls','tab-mission','tab-pipeline','tab-workforce','tab-backlog','tab-execution','tab-github','tab-reports','tab-integrations','qcc-live-notifications'];
    var listeners = [];
    function on(target, name, fn, capture) { target.addEventListener(name,fn,capture); listeners.push([target,name,fn,capture]); }
    function text(id,value) { var n=document.getElementById(id); if(n) n.textContent=value; }
    function now() { return new Date().toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',hour12:false}); }
    function feedback(message) { text('qcc-command-feedback',message); }
    function disconnected(message) {
      text('qcc-poll-status',message);text('qcc-connection-status',message+' · các panel giữ snapshot cũ');
      document.querySelectorAll('[data-qcc-worker], [data-qcc-effective]').forEach(function(n){n.textContent='STALE / UNKNOWN';});
    }
    function schedule() {
      clearTimeout(timer);
      if (!live.stopped) timer=setTimeout(live.refresh, document.hidden ? 60000 : (live.active ? 3000 : 15000));
    }
    function project(data, epoch) {
      if (live.stopped || epoch!==live.epoch || !data || !data.engineering || data.error) return false;
      var eng=data.engineering, revision=eng.control && eng.control.state_revision;
      live.schedule=data.schedule || eng.reporting_schedule;
      var commands=(eng.control && eng.control.recent_commands) || [];
      var last=commands.find(function(c){return c.request_id===live.unknownRequest;}) || (eng.control && eng.control.last_command);
      if(live.unknownRequest && last && (last.request_id===live.unknownRequest || last.command_id===live.unknownRequest)) {
        feedback('Đã đối chiếu lệnh '+live.unknownRequest+' · '+last.reason_code);
        var info=window.qccUnknownFormInfo;
        if(info && info.request_id===live.unknownRequest){delete info.form.dataset.qccSubmitting;delete info.form.dataset.qccRequestId;if(info.button){info.button.disabled=false;info.button.innerHTML=info.original;}}
        live.unknownRequest=null;window.qccUnknownRequest=null;window.qccUnknownFormInfo=null;
      }
      if (typeof revision==='number' && revision<live.revision) return false;
      if (typeof revision==='number') live.revision=revision;
      live.active=Number(eng.queue && eng.queue.active) || (eng.runs || []).filter(function(r){return r.queue_state!=='finished';}).length;
      regions.forEach(function(id) {
        var node=document.getElementById(id), html=(data.fragments || {})[id];
        var editing=document.activeElement && document.activeElement.matches('input,textarea,select') && node && node.contains(document.activeElement);
        if (node && typeof html==='string' && !editing) {
          var panelState=typeof qccCapturePanelState==='function' ? qccCapturePanelState(node) : null;
          node.innerHTML=html;
          if(typeof qccRestorePanelState==='function')qccRestorePanelState(node, panelState);
        }
      });
      // Search results remain stable while polling other panels; command search replaces only its result region.
      if (typeof data.knowledge_html==='string') { var knowledge=document.getElementById('qcc-knowledge-results'); if(knowledge) knowledge.innerHTML=data.knowledge_html; }
      document.querySelectorAll('[data-qcc-mode]').forEach(function(n){n.textContent=eng.mode || 'UNKNOWN';});
      text('qcc-last-refresh',now()); text('qcc-poll-status','CONNECTED · cập nhật '+now());text('qcc-connection-status','CONNECTED · snapshot '+now());
      return true;
    }
    live.refresh=function() {
      if (live.stopped || pollPromise) return pollPromise;
      var epoch=live.epoch, controller=pollController=new AbortController();
      var timeout=setTimeout(function(){controller.abort();},12000);
      pollPromise=fetch('/projects/<%= @project.identifier %>/qldapm-ai?format=json',{
        method:'GET',credentials:'same-origin',cache:'no-store',signal:controller.signal,headers:{'Accept':'application/json'}
      }).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
        .then(function(data){ if(data.error || !data.engineering) throw new Error('STATE_UNAVAILABLE');project(data,epoch); })
        .catch(function(){if(!live.stopped && epoch===live.epoch)disconnected('DISCONNECTED / STALE · chưa xác minh worker hoặc run mới');})
        .finally(function(){clearTimeout(timeout);pollPromise=null;schedule();});
      return pollPromise;
    };
    function submit(e) {
      var form=e.target.closest('form');
      if (!form || !form.closest('#qldapm-command-center')) return;
      e.preventDefault();e.stopImmediatePropagation();
      if (live.unknownRequest) {feedback('Chưa xác định kết quả · request '+live.unknownRequest+' · cần đối chiếu trước lệnh mới');return;}
      if (live.pending || form.dataset.qccSubmitting==='true') return;
      if (form.id==='qcc-schedule-form') {
        var payload={};
        ['daily_enabled','weekly_enabled'].forEach(function(k){payload[k]=document.getElementById('sched_'+k).checked;});
        ['daily_hour','daily_minute','weekly_day','weekly_hour','weekly_minute'].forEach(function(k){payload[k]=parseInt(document.getElementById('sched_'+k).value,10);});
        document.getElementById('qcc-schedule-args').value=JSON.stringify(payload);
      }
      var body=new FormData(form), tool=body.get('tool'), csrf=document.querySelector('meta[name="csrf-token"]');
      var requestId=form.dataset.qccRequestId || window.crypto.randomUUID();
      form.dataset.qccRequestId=requestId;body.set('request_id',requestId);
      if(tool==='engineering_control' && live.revision>=0)body.set('expected_revision',String(live.revision));
      var button=form.querySelector('button[type="submit"]'), original=button && button.innerHTML;
      live.pending=true;form.dataset.qccSubmitting='true';live.epoch++;var epoch=live.epoch;
      if(button){button.disabled=true;button.innerHTML=tool==='engineering_github_sync'?'SYNCING…':'Đang gửi…';}
      feedback('Đang gửi '+tool+' · request '+requestId);
      var controller=commandController=new AbortController();
      var warning=setTimeout(function(){if(live.pending)feedback('Đang chờ xác nhận · '+requestId+' · không gửi lại lệnh');},15000);
      var timeout=setTimeout(function(){controller.abort();},110000);
      var known=false;
      fetch(form.action,{method:'POST',credentials:'same-origin',cache:'no-store',signal:controller.signal,body:body,
        headers:{'Accept':'application/json','X-CSRF-Token':csrf ? csrf.content : ''}
      }).then(function(r){return r.json().then(function(data){
        if(live.stopped)return;
        var receipt=data.result && data.result.request_id===requestId && typeof data.result.accepted==='boolean';
        if((r.status>=500 || r.status===409) && !receipt)throw new Error('COMMAND_OUTCOME_UNKNOWN');
        known=true;
        if(!r.ok || data.error || (data.result && data.result.accepted===false)){feedback('Từ chối / lỗi HTTP '+r.status+' · '+(data.error || data.result.reason_code || 'COMMAND_FAILED')+' · request '+requestId);project(Object.assign({},data,{error:null}),epoch);return;}
        var result=data.result || {};
        project(data,epoch);
        feedback((result.message || result.reason_code || 'Đã nhận lệnh; xem trạng thái hiệu lực')+' · '+(data.correlation_id || result.command_id || requestId));
        if(tool==='engineering_plan'){
          var modal=document.getElementById('qcc-intake-modal');if(modal)modal.style.display='none';
          var acceptedWp=result.native_id || result.work_package_id;
          if(!acceptedWp && result.native_units){var created=Object.values(result.native_units);acceptedWp=created[0] && created[0].id;}
          if(acceptedWp){
            window.qccSelectedWork=String(acceptedWp);
            var search=document.getElementById('qcc-task-search');if(search)search.value=String(acceptedWp);
            var filter=document.getElementById('qcc-task-state');if(filter)filter.value='ALL';
            var backlogTab=document.querySelector('[data-tab="tab-backlog"]');if(backlogTab)backlogTab.click();
            if(typeof qccApplyWorkFilters==='function')qccApplyWorkFilters(document);
            feedback('Đã tiếp nhận WP #'+acceptedWp+' · xem Backlog / mở Work Package · '+(data.correlation_id || requestId));
          }
        }
      });}).catch(function(){if(!live.stopped)feedback('Chưa xác định kết quả · request '+requestId+' · đối chiếu trạng thái trước khi gửi lại; không tự retry');})
      .finally(function(){
        clearTimeout(warning);clearTimeout(timeout);live.pending=false;
        if(!known){live.unknownRequest=requestId;window.qccUnknownRequest=requestId;window.qccUnknownFormInfo={form:form,button:button,original:original,request_id:requestId};}
        if(known){delete form.dataset.qccSubmitting;delete form.dataset.qccRequestId;if(button){button.disabled=false;button.innerHTML=original;}}
        // Unknown writes remain locked; polling can show durable outcome but never replays them.
        live.refresh();
      });
    }
    live.stop=function(){
      live.stopped=true;clearTimeout(timer);if(pollController)pollController.abort();if(commandController)commandController.abort();
      listeners.forEach(function(v){v[0].removeEventListener(v[1],v[2],v[3]);});
    };
    on(document,'submit',submit,true);
    on(document,'visibilitychange',function(){if(!document.hidden)live.refresh();else schedule();});
    on(window,'online',function(){live.refresh();});
    on(window,'offline',function(){disconnected('DISCONNECTED / STALE · mạng không khả dụng');});
    on(document,'turbo:before-cache',live.stop);
    schedule();
  })();

  // Phase 3.2 Modal Handlers & Dynamic Loaders
  qccOn(document,'click', function(e) {
    var target = e.target;

    // Open Intake Modal
    var intakeBtn = target.closest('.qcc-open-intake-btn');
    if (intakeBtn) {
      e.preventDefault();
      var modal = document.getElementById('qcc-intake-modal');
      if (modal) modal.style.display = 'flex';
      return;
    }

    // Close any modal
    var closeBtn = target.closest('[data-action="close-modal"]');
    if (closeBtn || (target.classList && target.classList.contains('qcc-modal-backdrop'))) {
      var backdrops = document.querySelectorAll('.qcc-modal-backdrop');
      backdrops.forEach(function(m) { m.style.display = 'none'; });
      return;
    }

    if (window.qccReportReader && window.qccReportReader.handleClick(e)) return;

    // Subtab switching inside Execution Modal
    var subnavBtn = target.closest('.qcc-subnav-btn');
    if (subnavBtn) {
      var tabId = subnavBtn.getAttribute('data-subtab');
      var modalBox = subnavBtn.closest('.qcc-modal-box');
      if (modalBox) {
        modalBox.querySelectorAll('.qcc-subnav-btn').forEach(function(b) { b.classList.remove('active'); });
        modalBox.querySelectorAll('.qcc-subtab-pane').forEach(function(p) { p.style.display = 'none'; });
        subnavBtn.classList.add('active');
        var pane = document.getElementById(tabId);
        if (pane) pane.style.display = 'block';
      }
      return;
    }

    // Open Execution Inspector Modal
    var runBtn = target.closest('.qcc-run-inspector-btn');
    if (runBtn) {
      e.preventDefault();
      var runId = runBtn.getAttribute('data-run-id');
      if (!runId) return;

      var runModal = document.getElementById('qcc-run-modal');
      if (!runModal) return;

      var inspectorRequest={};runModal.inspectorRequest=inspectorRequest;
      document.getElementById('qcc-run-modal-id').textContent = runId.slice(0,8);
      document.getElementById('qcc-run-modal-id').title = runId;
      var oldSummary=document.getElementById('qcc-run-summary');if(oldSummary)oldSummary.textContent='Đang tải đúng run được chọn…';
      document.getElementById('qcc-run-modal-unit').textContent = 'Đang tải...';
      document.getElementById('qcc-run-modal-status-badge').textContent = 'LOADING...';
      document.getElementById('qcc-dag-container').innerHTML = '<div style="text-align:center; padding:20px; color:#94A3B8;">Đang nạp dữ liệu DAG từ AI Gateway...</div>';
      runModal.style.display = 'flex';

      var execUrl = '/projects/<%= @project.identifier %>/qldapm-ai/executions/' + encodeURIComponent(runId) + '?format=json';
      fetch(execUrl, {
        cache: 'no-store', credentials: 'same-origin',
        headers: { 'Accept': 'application/json' }
      })
      .then(function(res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      })
      .then(function(data) {
        if(runModal.inspectorRequest!==inspectorRequest)return;
        renderExecutionData(data);
      })
      .catch(function(err) {
        if(runModal.inspectorRequest!==inspectorRequest)return;
        document.getElementById('qcc-run-modal-status-badge').textContent = 'ERROR';
        document.getElementById('qcc-dag-container').innerHTML = '<div style="color:#F43F5E; padding:16px; background:rgba(244,63,94,0.1); border-radius:6px; border:1px solid rgba(244,63,94,0.3);"><strong style="display:block; margin-bottom:6px;">Lỗi nạp dữ liệu Telemetry:</strong>' + escapeQccHtml(err.message) + '<br><span style="font-size:11px; color:#94A3B8;">Vui lòng kiểm tra kết nối AI Gateway hoặc xem trực tiếp trong nhật ký SQLite.</span></div>';
      });
      return;
    }
  });

  function formatVNDateTime(ts) {
    if (!ts) return 'Chưa có dữ liệu';
    var d;
    if (typeof ts === 'number') {
      d = new Date(ts < 10000000000 ? ts * 1000 : ts);
    } else if (typeof ts === 'string') {
      var num = Number(ts);
      if (!isNaN(num) && num > 0) {
        d = new Date(num < 10000000000 ? num * 1000 : num);
      } else {
        d = new Date(ts);
      }
    } else {
      d = new Date(ts);
    }
    if (isNaN(d.getTime())) return 'Chưa có dữ liệu';
    var parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Ho_Chi_Minh',
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false
    }).formatToParts(d);
    var p = {};
    parts.forEach(function(part) { p[part.type] = part.value; });
    return p.day + '/' + p.month + '/' + p.year + ' ' + p.hour + ':' + p.minute + ':' + p.second;
  }

  function escapeQccHtml(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function(ch) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];
    });
  }

  function renderExecutionData(data) {
    if (!data) return;
    var stateStr = String(data.state || 'UNKNOWN').toUpperCase();
    var badgeClass = stateStr === 'COMPLETED' ? 'qcc-chip-emerald' : (stateStr === 'RUNNING' ? 'qcc-chip-cyan' : ((stateStr === 'FAILED' || stateStr === 'BLOCKED') ? 'qcc-chip-rose' : 'qcc-chip-amber'));
    var badgeElem = document.getElementById('qcc-run-modal-status-badge');
    badgeElem.textContent = stateStr;
    badgeElem.className = 'qcc-chip ' + badgeClass;

    document.getElementById('qcc-run-modal-unit').textContent = data.request || data.unit || 'Engineering Unit';
    document.getElementById('qcc-run-metric-duration').textContent = data.duration_seconds ? (data.duration_seconds + 's') : '--';
    document.getElementById('qcc-run-metric-model').textContent = data.model || 'Chưa có dữ liệu';
    
    var metrics = data.metrics || {};
    document.getElementById('qcc-run-metric-tokens').textContent = typeof metrics.tokens === 'number' && Number.isFinite(metrics.tokens) ? metrics.tokens.toLocaleString() : 'Chưa có dữ liệu';
    document.getElementById('qcc-run-metric-calls').textContent = typeof metrics.calls === 'number' && Number.isFinite(metrics.calls) ? metrics.calls + ' calls' : 'Chưa có dữ liệu';
    document.getElementById('qcc-run-metric-agents').textContent = typeof metrics.agents === 'number' && Number.isFinite(metrics.agents) ? metrics.agents + ' Agents' : (Array.isArray(data.nodes) ? data.nodes.length + ' Agents' : 'Chưa có dữ liệu');

    var summary=document.getElementById('qcc-run-summary');if(summary)summary.innerHTML=qccExecutionSummary(data);

    // Render DAG
    var dagHtml = '';
    if (stateStr === 'FAILED' || stateStr === 'BLOCKED') {
      dagHtml += '<div style="margin-bottom:12px; padding:10px 14px; background:rgba(244,63,94,0.12); border-left:3px solid #F43F5E; border-radius:4px; font-size:12px; color:#FCA5A5;"><strong>Cảnh báo phiên thực thi:</strong> ' + escapeQccHtml(data.final_output || 'Phiên thực thi gặp lỗi hoặc bị chặn tại bước kiểm tra.') + '</div>';
    }

    var nodes = data.nodes || [];
    nodes.forEach(function(node, idx) {
      var nState = String(node.state || 'PENDING').toUpperCase();
      var stateClass = nState === 'COMPLETED' ? 'text-emerald' : (nState === 'RUNNING' ? 'text-cyan' : ((nState === 'FAILED' || nState === 'BLOCKED') ? 'text-rose' : 'text-slate'));
      var stateBg = nState === 'COMPLETED' ? 'rgba(52, 211, 153, 0.08)' : (nState === 'RUNNING' ? 'rgba(6, 182, 212, 0.08)' : ((nState === 'FAILED' || nState === 'BLOCKED') ? 'rgba(244, 63, 94, 0.12)' : 'rgba(30, 41, 59, 0.4)'));
      var roleColor = node.agent === 'dev' ? '#38BDF8' : (node.agent === 'reviewer' ? '#F59E0B' : (node.agent === 'qa' ? '#10B981' : (node.agent === 'ba' ? '#EC4899' : (node.agent === 'pm' ? '#8B5CF6' : '#A78BFA'))));

      dagHtml += '<div class="qcc-dag-node-box" style="background:' + stateBg + '; border-left: 3px solid ' + roleColor + ';">';
      dagHtml += '  <div class="qcc-dag-node-header">';
      dagHtml += '    <strong style="color:' + roleColor + ';">' + escapeQccHtml(node.name || node.agent) + '</strong>';
      dagHtml += '    <span class="' + stateClass + '" style="font-size:11px; font-weight:600;">' + escapeQccHtml(nState) + '</span>';
      dagHtml += '  </div>';
      dagHtml += '  <div style="font-size:12px; color:#CBD5E1;">' + escapeQccHtml(node.objective || '') + '</div>';
      if (node.output) {
        dagHtml += '  <div style="font-size:11px; color:#94A3B8; background:#030712; padding:6px 10px; border-radius:4px; margin-top:4px; max-height:100px; overflow-y:auto; white-space:pre-wrap; word-break:break-all;">' + escapeQccHtml(node.output) + '</div>';
      }
      dagHtml += '</div>';

      if (idx < nodes.length - 1) {
        dagHtml += '<div class="qcc-dag-arrow">↓</div>';
      }
    });
    document.getElementById('qcc-dag-container').innerHTML = dagHtml || '<p class="text-slate">Không có thông tin DAG cho lượt chạy này.</p>';

    // Render Events
    var events = data.events || [];
    var eventsHtml = '';
    events.forEach(function(ev, idx) {
      var evStatus = String(ev.status || 'UNKNOWN').toUpperCase();
      var evClass = evStatus === 'COMPLETED' || evStatus === 'OK' ? 'qcc-chip-emerald' : (evStatus === 'QUEUED' || evStatus === 'RUNNING' ? 'qcc-chip-cyan' : ((evStatus === 'FAILED' || evStatus === 'BLOCKED') ? 'qcc-chip-rose' : 'qcc-chip-slate'));
      var kind=/MODEL_|PROVIDER_|LIVE_SUCCESS/.test(ev.event_type || '') ? 'model' : (/TOOL_/.test(ev.event_type || '') ? 'tool' : (/FAILED|BLOCKED|ERROR/.test(evStatus+' '+(ev.event_type || '')) ? 'errors' : 'milestones'));
      var group=ev.agent_id==='pm'||ev.agent_id==='ba' ? 'Planning' : ({dev:'Dev',reviewer:'Reviewer',qa:'QA',publisher:'Delivery'}[ev.agent_id] || 'Integration');
      eventsHtml += '<tr data-event-kind="'+kind+'">';
      eventsHtml += '<td>' + escapeQccHtml(ev.sequence || idx + 1) + '</td>';
      var eventDate = ev.timestamp ? new Date(ev.timestamp < 10000000000 ? ev.timestamp * 1000 : ev.timestamp) : null;
      var isoTooltip = eventDate && Number.isFinite(eventDate.getTime()) ? eventDate.toISOString() : '';
      eventsHtml += '<td style="color:#94A3B8;" title="' + escapeQccHtml(isoTooltip) + '">' + escapeQccHtml(formatVNDateTime(ev.timestamp)) + '</td>';
      eventsHtml += '<td><strong style="color:#38BDF8;">' + escapeQccHtml(group+' / '+(ev.agent_id || 'UNKNOWN')) + '</strong></td>';
      eventsHtml += '<td><code>' + escapeQccHtml(ev.event_type || '') + '</code></td>';
      eventsHtml += '<td><span class="qcc-chip ' + evClass + '">' + escapeQccHtml(evStatus) + '</span></td>';
      eventsHtml += '</tr>';
    });
    document.getElementById('qcc-events-tbody').innerHTML = eventsHtml || '<tr><td colspan="5" class="text-center text-slate">Không có sự kiện ghi nhận</td></tr>';

    // Render Real Diff Content
    var diffText = '';
    var devNode = (data.nodes || []).find(function(n) { return n.agent === 'dev'; });
    if (devNode && devNode.output) {
      diffText = '=== [Dev Agent Output & Files] ===\n' + devNode.output;
    } else if (data.final_output) {
      diffText = '=== [Final Output] ===\n' + data.final_output;
    } else {
      diffText = 'Không có mã nguồn diff trực tiếp được ghi nhận trong lượt chạy này.';
    }
    document.getElementById('qcc-diff-content').textContent = diffText;

    // Render Real QA Content
    var qaText = '';
    var qaNode = (data.nodes || []).find(function(n) { return n.agent === 'qa'; });
    var reviewerNode = (data.nodes || []).find(function(n) { return n.agent === 'reviewer'; });
    if (qaNode && qaNode.output) {
      qaText += '=== [QA Agent Evidence] ===\n' + qaNode.output + '\n\n';
    }
    if (reviewerNode && reviewerNode.output) {
      qaText += '=== [Reviewer Exact-Diff Verdict] ===\n' + reviewerNode.output + '\n\n';
    }
    if (!qaText) {
      if (data.request && data.request.indexOf('planning') !== -1) {
        qaText = 'Tác vụ này là giai đoạn Lập kế hoạch PM/BA (Planning), không có bước thực thi Pytest mã nguồn.\nĐặc tả kỹ thuật và tiêu chí nghiệm thu được tạo tại Tab Backlog.';
      } else if (stateStr === 'FAILED' || stateStr === 'BLOCKED') {
        qaText = 'Phiên thực thi bị gián đoạn trước khi bước QA được tiến hành.\nNguyên nhân: ' + (data.final_output || 'Lỗi kiểm tra tính khả dụng hoặc phụ thuộc.');
      } else {
        qaText = 'Không có log kiểm thử QA riêng biệt cho lượt chạy này.';
      }
    }
    document.getElementById('qcc-qa-content').textContent = qaText;

    // Render Raw JSON
    document.getElementById('qcc-raw-content').textContent = JSON.stringify(data, null, 2);
  }

  // Modal Escape key support
  qccOn(document,'keydown', function(e) {
    if (e.key === 'Escape') {
      var backdrops = document.querySelectorAll('.qcc-modal-backdrop');
      backdrops.forEach(function(m) { m.style.display = 'none'; });
    }
  });

  // Phase3.1 owner filters and selection survive replacement of live fragments.
  qccOn(document,'input',function(e){if(e.target && ['qcc-task-search','qcc-plan-search'].includes(e.target.id))qccApplyWorkFilters(document);});
  qccOn(document,'change',function(e){
    if(e.target && e.target.id==='qcc-task-state')qccApplyWorkFilters(document);
    if(e.target && e.target.id==='qcc-event-filter')document.querySelectorAll('[data-event-kind]').forEach(function(row){row.hidden=e.target.value!=='all' && row.dataset.eventKind!==e.target.value;});
  });
  qccOn(document,'click',function(e){
    var copy=e.target.closest('[data-qcc-copy]');
    if(copy && navigator.clipboard)navigator.clipboard.writeText(copy.dataset.qccCopy).then(function(){copy.textContent='Đã sao chép';}).catch(function(){copy.textContent='Không thể copy; chọn ID trong details';});
    var row=e.target.closest('[data-work-row]');if(row){window.qccSelectedWork=row.dataset.wpId;document.querySelectorAll('[data-work-row]').forEach(function(n){n.classList.toggle('qcc-work-selected',n.dataset.wpId===window.qccSelectedWork);});}
  });
  if(window.location && window.location.search){
    var linkedRun=new URLSearchParams(window.location.search).get('run_id');
    if(linkedRun && /^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/.test(linkedRun)){
      var linkedButton=document.createElement('button');linkedButton.type='button';linkedButton.hidden=true;
      linkedButton.className='qcc-run-inspector-btn';linkedButton.setAttribute('data-run-id',linkedRun);
      document.getElementById('qldapm-command-center').appendChild(linkedButton);linkedButton.click();linkedButton.remove();
    }
  }
<% end %>

<%# QLDAPM AI Command Center — Modern Autonomous Operations Shell (Phase 2.9) %>
<%
  eng = @engineering || {}
  mode = eng['mode'] || 'UNKNOWN'
  tasks = eng['tasks'] || []
  backlog = eng['backlog'] || []
  runs = eng['runs'] || []
  parent = @engineering_wp || {}
  parent_id = parent['id'] || 379
  parent_lock = parent['lockVersion'] || parent['lock_version']
  raw_reports = @reports || eng['reports'] || []
  reports = raw_reports.is_a?(Hash) ? (raw_reports['reports'] || []) : Array(raw_reports)
  raw_notifs = @notifications || eng['notifications'] || []
  notifications = raw_notifs.is_a?(Hash) ? (raw_notifs['notifications'] || []) : Array(raw_notifs)
  sched = @schedule || eng['schedule'] || {}
  worker = eng['delivery_worker'] || {}
  worker_alive = worker['state'] == 'ALIVE'
  plans = eng['plans'] || []
  delivered_count = backlog.select { |b| (b['state'] == 'succeeded' || b['status'] == 'DELIVERED') }.size
  total_backlog = backlog.size
  github_info = eng['github'] || {}
  sync_meta = github_info['sync_meta'] || {}
  raw_prs = github_info['prs'] || eng['github_prs'] || []
  github_prs = raw_prs
  profiles = eng['profiles'] || []
  quota_info = eng['quota'] || {}
  quota_model = quota_info['model'] || 'gemini-3.5-flash-lite'
  control = eng['control'] || {}
  queue = eng['queue'] || {}

  format_vn_time = ->(val) {
    return 'Chưa có dữ liệu' if val.blank?
    t = nil
    if val.is_a?(Numeric)
      t = Time.at(val)
    elsif val.is_a?(String)
      t = (val =~ /\A\d+(\.\d+)?\z/) ? Time.at(val.to_f) : (Time.parse(val) rescue nil)
    elsif val.respond_to?(:in_time_zone)
      t = val
    end
    return 'Chưa có dữ liệu' unless t
    t.in_time_zone('Asia/Ho_Chi_Minh').strftime('%d/%m/%Y %H:%M:%S')
  }

  iso_tooltip = ->(val) {
    return '' if val.blank?
    t = nil
    if val.is_a?(Numeric)
      t = Time.at(val)
    elsif val.is_a?(String)
      t = (val =~ /\A\d+(\.\d+)?\z/) ? Time.at(val.to_f) : (Time.parse(val) rescue nil)
    elsif val.respond_to?(:utc)
      t = val
    end
    t ? t.utc.iso8601 : ''
  }

%>

<div id="qldapm-command-center" data-state-revision="<%= control['state_revision'] %>" class="qcc-root">
  <!-- Top Progress Bar (Active when mode is AUTO or task running) -->
  <div class="qcc-top-progress <%= 'active' if eng.dig('queue','executing').to_i > 0 %>"></div>

  <!-- TOAST NOTIFICATION CONTAINER (Phase 2.9.2) -->
  <div id="qcc-toast-container" class="qcc-toast-container">
    <% if @result.present? && @error.blank? %>
      <% result_msg = @result.is_a?(Hash) ? (@result['message'] || @result['text'] || @result['status']) : @result.to_s %>
      <div class="qcc-toast qcc-toast-success" role="alert">
        <div class="qcc-toast-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="qcc-toast-content">
          <div class="qcc-toast-title">Thao tác thành công</div>
          <div class="qcc-toast-body"><%= result_msg %></div>
        </div>
        <button type="button" class="qcc-toast-close" data-action="close-toast">&times;</button>
      </div>
    <% end %>

    <% if @error.present? %>
      <div class="qcc-toast qcc-toast-error" role="alert">
        <div class="qcc-toast-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="qcc-toast-content">
          <div class="qcc-toast-title">Thông báo lỗi / Từ chối</div>
          <div class="qcc-toast-body"><%= @error %></div>
        </div>
        <button type="button" class="qcc-toast-close" data-action="close-toast">&times;</button>
      </div>
    <% end %>
  </div>

  <!-- Command Center Shell Layout -->
  <div class="qcc-shell">
    <!-- LEFT SIDEBAR -->
    <aside class="qcc-sidebar">
      <!-- Brand & Project Identity -->
      <div class="qcc-brand">
        <div class="qcc-brand-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
          </svg>
        </div>
        <div class="qcc-brand-info">
          <div class="qcc-brand-name">QLDAPM COMMAND</div>
          <div class="qcc-brand-sub">AI Agent Center · v2.9</div>
        </div>
      </div>

      <!-- Project Badge -->
      <div class="qcc-project-badge">
        <span class="qcc-badge-dot <%= worker_alive ? 'alive' : 'idle' %>"></span>
        <span class="qcc-project-title">Project 6: ai-dev-demo</span>
      </div>

      <!-- Navigation Tabs -->
      <nav class="qcc-nav" role="tablist">
        <button class="qcc-nav-item active" data-tab="tab-mission" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="12 6 12 12 16 14"></polygon></svg>
          <span>Mission Control</span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-pipeline" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          <span>AI Pipeline · business + execution</span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-workforce" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>Agent Workforce</span>
          <span class="qcc-nav-pill">6</span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-backlog" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span>Backlog & Tasks</span>
          <span class="qcc-nav-pill"><%= tasks.size %></span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-execution" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          <span>Execution Center</span>
          <span class="qcc-nav-pill"><%= runs.size %></span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-github" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><line x1="6" y1="9" x2="6" y2="21"></line></svg>
          <span>GitHub & Delivery</span>
          <span class="qcc-nav-pill"><%= github_prs.size %> PRs</span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-reports" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span>Reports & Analytics</span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-knowledge" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span>Knowledge / RAG</span>
        </button>
        <button class="qcc-nav-item" data-tab="tab-integrations" role="tab">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          <span>System Integrations</span>
        </button>
      </nav>

      <!-- Sidebar Footer -->
      <div class="qcc-sidebar-footer">
        <div class="qcc-user-info">
          <div class="qcc-user-avatar">
            <%= (User.current.firstname.presence || 'O')[0].upcase %>
          </div>
          <div class="qcc-user-meta">
            <div class="qcc-user-name"><%= User.current.name %></div>
            <div class="qcc-user-role"><%= @role || 'AI_SYSTEM_OWNER' %></div>
          </div>
        </div>
        <div class="qcc-footer-links">
          <%= link_to "/projects/#{@project.identifier}/work_packages", class: "qcc-footer-link", title: "Mở danh sách Work Packages OpenProject" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/></svg>
            <span>Về OpenProject</span>
          <% end %>
          <%= link_to "/projects/#{@project.identifier}/qldapm-ai?ui=classic", class: "qcc-footer-link", title: "Chuyển về giao diện Classic Phase 2.8" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Bản Classic</span>
          <% end %>
        </div>
      </div>
    </aside>

    <!-- MAIN OPERATIONS CANVAS -->
    <main class="qcc-main">
      <div id="qcc-connection-status" role="status" aria-live="polite" class="qcc-text-muted">Đang hiển thị snapshot từ server; chờ live refresh.</div>
    <div id="qcc-command-feedback" role="status" aria-live="polite" class="qcc-text-muted" style="padding:8px"></div>

      <!-- TOP TELEMETRY & CONTROLS HEADER -->
      <header id="qcc-live-controls" data-qcc-live class="qcc-header">
        <div class="qcc-header-left">
          <h1 class="qcc-header-title">
            <span>AI Engineering Control Center</span>
            <span class="qcc-chip-mode mode-<%= mode.downcase %>">
              <span class="qcc-chip-pulse"></span>
              MODE: <span data-qcc-mode><%= mode %></span>
            </span>
          </h1>
          <p class="qcc-header-meta">
            Worker: <strong data-qcc-worker class="<%= worker_alive ? 'text-emerald' : 'text-slate' %>"><%= worker_alive ? 'ALIVE' : (worker['state'] || 'UNKNOWN') %></strong> · 
            Múi giờ: <strong>Asia/Ho_Chi_Minh (UTC+7)</strong> · 
            Auto Delivery: <strong><%= delivered_count %> / <%= total_backlog %> Units Delivered</strong>
          </p>
          <p class="qcc-header-meta">
            Desired: <strong><%= control['desired_mode'] || mode %></strong> · Effective: <strong data-qcc-effective><%= control['effective_state'] || 'UNKNOWN' %></strong> ·
            READY <strong><%= queue['ready'] || 0 %></strong> / ACTIVE <strong><%= queue['active'] || 0 %></strong> / BLOCKED <strong><%= queue['blocked'] || 0 %></strong><br>
            Heartbeat: <strong><%= format_vn_time.call(worker['seen']) %></strong> ·
            Lý do: <strong><%= control['blocked_reason'] || queue['reason_code'] || 'Không có blocker được ghi nhận' %></strong> ·
            Revision <%= control['state_revision'] || 'UNKNOWN' %>
          </p>
          <a class="qcc-btn qcc-btn-secondary" href="#qcc-live-notifications" aria-label="Mở thông báo chưa đọc">🔔 Thông báo · <strong><%= eng['notification_unread_count'] || notifications.size %></strong></a>
          <p class="qcc-header-meta">Scheduler policy: run BLOCKED dừng AUTO về OFF, cần Owner xử lý. Bounded AUTO continuation <strong><%= control.dig('scheduler_policy','auto_continuation_enabled') == true ? 'đã bật rõ ràng; chỉ internal budget và checkpoint an toàn' : 'TẮT mặc định' %></strong>; OFF không tự bật lại.</p>
          <% if control['last_command'] %>
            <p class="qcc-header-meta">Lệnh cuối: <%= control['last_command']['requested_action'] %> · <%= control['last_command']['reason_code'] %> · <%= control['last_command']['command_id'] %> · <%= format_vn_time.call(control['last_command']['server_timestamp']) %></p>
          <% end %>
        </div>

        <!-- ACTION BUTTONS TOOLBAR -->
        <div class="qcc-header-actions">
          <!-- Back to OpenProject Work Packages -->
          <%= link_to "/projects/#{@project.identifier}/work_packages", class: "qcc-btn qcc-btn-secondary", title: "Quay lại danh sách Work Packages của OpenProject" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            <span>← Work Packages</span>
          <% end %>

          <!-- RUN ONCE (Dynamically targeting eligible/latest unit) -->
          <%
            backlog_items = (Array(@engineering['backlog']) rescue [])
            active_or_next_unit = backlog_items.find { |b| b['eligible'] == true && b['state'] == 'PLANNED' && b['dependency_ready'] == true }
            target_unit_name = active_or_next_unit && active_or_next_unit['unit']
            target_native_id = active_or_next_unit && active_or_next_unit['native_id']
            target_task = (Array(@engineering['tasks']) rescue []).find { |t| t['id'] == target_native_id }
            target_lock = target_task ? target_task['lock_version'] : (target_native_id == parent_id ? parent_lock : nil)
            run_once_ready = mode == 'OFF' && target_unit_name.present? && target_native_id.is_a?(Integer) && target_lock.is_a?(Integer)
          %>
          <% if run_once_ready %>
          <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form" do %>
            <%= hidden_field_tag :tool, 'engineering_run_once' %>
            <%= hidden_field_tag :arguments, {native_id: target_native_id, lock_version: target_lock, unit: target_unit_name}.to_json %>
            <button type="submit" class="qcc-btn qcc-btn-primary" title="Chạy một lượt đơn lẻ có kiểm soát (Unit: <%= target_unit_name %>)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <span>RUN ONCE</span>
            </button>
          <% end %>
          <% else %>
            <button type="button" class="qcc-btn qcc-btn-primary" disabled title="Không có unit sẵn sàng hoặc thiếu phiên bản Native"><span>RUN ONCE · NO ELIGIBLE WORK</span></button>
          <% end %>

          <!-- MODE TOGGLE -->
          <% if mode == 'OFF' %>
            <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form" do %>
              <%= hidden_field_tag :tool, 'engineering_control' %>
              <%= hidden_field_tag :arguments, {mode: 'AUTO'}.to_json %>
              <button type="submit" class="qcc-btn qcc-btn-emerald">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <span>BẬT AUTO</span>
              </button>
            <% end %>
          <% else %>
            <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form" do %>
              <%= hidden_field_tag :tool, 'engineering_control' %>
              <%= hidden_field_tag :arguments, {mode: 'OFF'}.to_json %>
              <button type="submit" class="qcc-btn qcc-btn-slate">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                <span>OFF</span>
              </button>
            <% end %>
          <% end %>

          <% if mode == 'PAUSED' %>
            <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form" do %>
              <%= hidden_field_tag :tool, 'engineering_control' %>
              <%= hidden_field_tag :arguments, {mode: 'OFF'}.to_json %>
              <button type="submit" class="qcc-btn qcc-btn-slate"><span>TẮT PAUSE</span></button>
            <% end %>
          <% else %>
            <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form" do %>
              <%= hidden_field_tag :tool, 'engineering_control' %>
              <%= hidden_field_tag :arguments, {mode: 'PAUSED'}.to_json %>
              <button type="submit" class="qcc-btn qcc-btn-amber"><span>PAUSE</span></button>
            <% end %>
          <% end %>

          <!-- GITHUB SYNC -->
          <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form" do %>
            <%= hidden_field_tag :tool, 'engineering_github_sync' %>
            <%= hidden_field_tag :arguments, {}.to_json %>
            <button type="submit" class="qcc-btn qcc-btn-secondary" title="Đọc lại PR từ GitHub và đối soát Native">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              <span>Sync GitHub</span>
            </button>
          <% end %>

          <!-- SCHEDULE MODAL TRIGGER (Finding G) -->
          <button type="button" id="btn-open-schedule-modal" class="qcc-btn qcc-btn-secondary" >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Cấu hình lịch</span>
          </button>

          <!-- SNAPSHOT REPORT -->
          <%= form_tag "/projects/#{@project.identifier}/qldapm-ai/commands", class: "qcc-action-form" do %>
            <%= hidden_field_tag :tool, 'engineering_report_generate' %>
            <%= hidden_field_tag :arguments, {report_type: 'ON_DEMAND', include_narrative: true}.to_json %>
            <button type="submit" class="qcc-btn qcc-btn-secondary" title="Sinh báo cáo tổng hợp tức thời kèm nhận định AI">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
              <span>Snapshot Tức Thời (+AI)</span>
            </button>
          <% end %>

          <!-- GIAO VIỆC MỚI CHO AI (WORK INTAKE) -->
          <button type="button" id="btn-open-intake-modal" class="qcc-btn qcc-btn-primary qcc-open-intake-btn" title="Giao tính năng / yêu cầu mới cho Tác nhân PM & BA">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Giao việc mới cho AI</span>
          </button>
        </div>
      </header>

      <!-- NOTIFICATIONS TOAST BAR -->
      <section id="qcc-live-notifications" data-qcc-live class="qcc-notifications-section" aria-label="Notifications Bar">
        <%= render partial: 'qldapm_ai/engineering_notifications', locals: {eng: eng, notifications: notifications, format_vn_time: format_vn_time} %>
      </section>

      <!-- TAB 1: MISSION CONTROL (OVERVIEW) -->
      <section id="tab-mission" data-qcc-live class="qcc-tab-pane active" role="tabpanel">
        <%= render partial: 'qldapm_ai/engineering_live_activity', locals: {eng: eng, format_vn_time: format_vn_time} %>
        <!-- Project business anchor; not agent execution -->
        <div class="qcc-mission-hero">
          <div class="qcc-mission-badge">
            <span class="qcc-chip-pulse"></span>
            PROJECT ANCHOR · WP #<%= parent_id %>
          </div>
          <h2 class="qcc-mission-title"><%= parent['subject'] || 'Develop Mini Task Manager Application' %></h2>
          <p class="qcc-mission-desc">

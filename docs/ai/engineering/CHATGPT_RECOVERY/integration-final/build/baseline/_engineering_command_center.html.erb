      <!-- TAB 4: EXECUTION CENTER -->
      <section id="tab-execution" data-qcc-live class="qcc-tab-pane" role="tabpanel">
        <div class="qcc-card">
          <div class="qcc-card-header">
            <div>
              <h3 class="qcc-card-title">Trung tâm Điều phối Thực thi (Execution History & Controls)</h3>
              <p class="qcc-card-sub">Lịch sử toàn bộ các lượt chạy AI (runs), trạng thái hàng đợi và điểm kiểm soát (checkpoints)</p>
            </div>
            <span class="qcc-chip qcc-chip-cyan">Total <%= runs.size %> Runs Recorded</span>
          </div>

          <div class="qcc-table-wrapper">
            <table class="qcc-table">
              <thead>
                <tr>
                  <th>Run ID</th>
                  <th>Thời điểm chạy</th>
                  <th>Hàng đợi</th>
                  <th>Giai đoạn</th>
                  <th>Task / Unit</th>
                  <th>Trạng thái Review</th>
                  <th>Kết quả</th>
                  <th>Hành động</th>
                </tr>
              </thead>
              <tbody>
                <% if runs.empty? %>
                  <tr><td colspan="8" class="text-center text-slate">Chưa có lịch sử thực thi nào</td></tr>
                <% else %>
                  <% runs.each do |run| %>
                    <% 
                      qstate = run['queue_state'] || 'unknown'
                      status = run.dig('result', 'status') || 'unknown'
                      is_active = %w[queued executing].include?(qstate)
                      checkpoint = run['checkpoint'] || {}
                      run_resume = run['resume'] || {}; can_resume = run_resume['eligible'] == true
                    %>
                    <tr>
                      <td>
                        <button type="button" class="qcc-run-inspector-btn" data-run-id="<%= run['id'] %>" style="background:none; border:none; padding:0; cursor:pointer; display:inline-flex; align-items:center; gap:4px;" title="Xem chi tiết thực thi & sơ đồ tương tác Agent">
                          <code class="text-cyan"><%= run['id'] ? run['id'][0..7] : 'N/A' %>...</code>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                      </td>
                      <td title="<%= iso_tooltip.call(run['created_at']) %>">

          <%
            role_meta = {
              'supervisor' => { avatar: 'SUP', color: 'bg-indigo', title: 'AI Supervisor', sub: 'Orchestrator & Gatekeeper (gemini-3.5-flash-lite)' },
              'pm'         => { avatar: 'PM',  color: 'bg-blue',   title: 'Product Manager Agent', sub: 'Backlog Decomposition & WBS (gemini-3.5-flash-lite)' },
              'ba'         => { avatar: 'BA',  color: 'bg-teal',   title: 'Business Analyst Agent', sub: 'Requirements & AC (gemini-3.5-flash-lite)' },
              'dev'        => { avatar: 'DEV', color: 'bg-emerald',title: 'Senior Developer Agent', sub: 'Implementation via OpenClaw Worktree & Scripts' },
              'reviewer'   => { avatar: 'REV', color: 'bg-amber',  title: 'Code Reviewer Agent', sub: 'Local-Policy Exact-Diff Checker (0 LLM Calls)' },
              'qa'         => { avatar: 'QA',  color: 'bg-rose',   title: 'QA Automation Lead', sub: 'Automated Pytest Runner (No LLM Reasoning)' }
            }
          %>
          <% if profiles.present? %>
            <% profiles.each do |p| %>
              <%
                r_key = p['agent'] || 'supervisor'
                meta = role_meta[r_key] || { avatar: r_key[0..2].upcase, color: 'bg-indigo', title: r_key.capitalize, sub: 'AI Specialist' }
                st = p['status'] || 'STANDBY'
                chip_class = st == 'RUNNING' ? 'qcc-chip-cyan' : 'qcc-chip-emerald'
                act_model = p['actual_model_id'] || quota_model
                rt_disp = p['runtime_display'] || p['runtime']
                last_exec = p['last_execution'] ? p['last_execution'].to_s.truncate(22) : 'N/A'
                last_err = p['last_error'] || 'None'
                oc_sess = p['openclaw_session'] || 'N/A (Gateway Daemon)'
                evid = p['evidence'] || 'Verified by receipt'
                sk = p['skills_loaded'] || p['skill'] || 'engineering-planning'
              %>
              <div class="qcc-agent-card">
                <div class="qcc-agent-top">
                  <div class="qcc-agent-avatar <%= meta[:color] %>"><%= meta[:avatar] %></div>
                  <div class="qcc-agent-info">

 def create_task(task: TaskCreate):\n        if not isinstance(task.title, str) or not task.title.strip():\n            raise HTTPException(status_code=422, detail=\"Title cannot be blank\")\n        conn = sqlite3.connect(database_path)\n        cursor = conn.cursor()\n        cursor.execute(\"INSERT INTO tasks (title, status) VALUES (?, ?)\", (task.title, \"todo\"))\n        conn.commit()\n        task_id = cursor.lastrowid\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n        conn.close()\n        return {\"id\": row[0], \"title\": row[1], \"status\": row[2]}\n\n    @app.get(\"/tasks\")\n    def list_tasks(\n        q: Optional[str] = Query(None),\n        status: Optional[str] = Query(None)\n    ):\n        conn = sqlite3.connect(database_path)\n        conn.create_function(\"qldapm_casefold\", 1, lambda s: s.casefold() if s is not None else \"\")\n        cursor = conn.cursor()\n        query = \"SELECT id, title, status FROM tasks WHERE 1=1\"\n        params = []\n        \n        if q is not None:\n            query += \" AND qldapm_casefold(title) LIKE ? ESCAPE '\\\\'\"\n            escaped_q = q.casefold().replace('\\\\', '\\\\\\\\').replace('%', '\\\\%').replace('_', '\\\\_')\n            params.append(f\"%{escaped_q}%\")\n            \n        if status is not None:\n            if status not in (\"todo\", \"in_progress\", \"done\"):\n                conn.close()\n                raise HTTPException(status_code=422, detail=\"Invalid status\")\n            query += \" AND status = ?\"\n            params.append(status)\n            \n        query += \" ORDER BY id ASC\"\n        cursor.execute(query, params)\n        rows = cursor.fetchall()\n        conn.close()\n        return [{\"id\": r[0], \"title\": r[1], \"status\": r[2]} for r in rows]\n\n    @app.patch(\"/tasks/{task_id}\")\n    def update_task(task_id: int, task_update: TaskUpdate):\n        if task_update.title is No
itle TEXT NOT NULL,\r\n            status TEXT NOT NULL DEFAULT 'todo'\r\n        )\r\n    \"\"\")\r\n    conn.commit()\r\n    conn.close()\r\n\r\nclass TaskCreate(BaseModel):\r\n    title: str\r\n\r\nclass TaskUpdate(BaseModel):\r\n    title: Optional[str] = None\r\n    status: Optional[str] = None\r\n\r\ndef create_app(database_path: str = \"tasks.db\") -> FastAPI:\r\n    init_db(database_path)\r\n    app = FastAPI()\r\n\r\n    @app.post(\"/tasks\", status_code=status.HTTP_201_CREATED)\r\n    def create_task(task: TaskCreate):\r\n        if not isinstance(task.title, str) or not task.title.strip():\r\n            raise HTTPException(status_code=422, detail=\"Title cannot be blank\")\r\n        conn = sqlite3.connect(database_path)\r\n        cursor = conn.cursor()\r\n        cursor.execute(\"INSERT INTO tasks (title, status) VALUES (?, ?)\", (task.title, \"todo\"))\r\n        conn.commit()\r\n        task_id = cursor.lastrowid\r\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\r\n        row = cursor.fetchone()\r\n        conn.close()\r\n        return {\"id\": row[0], \"title\": row[1], \"status\": row[2]}\r\n\r\n    @app.get(\"/tasks\")\r\n    def list_tasks(\r\n        q: Optional[str] = Query(None),\r\n        status: Optional[str] = Query(None)\r\n    ):\r\n        conn = sqlite3.connect(database_path)\r\n        cursor = conn.cursor()\r\n        query = \"SELECT id, title, status FROM tasks WHERE 1=1\"\r\n        params = []\r\n        \r\n        if q is not None:\r\n            query += \" AND LOWER(title) LIKE ? ESCAPE '\\\\'\"\r\n            escaped_q = q.lower().replace('\\\\', '\\\\\\\\').replace('%', '\\\\%').replace('_', '\\\\_')\r\n            params.append(f\"%{escaped_q}%\")\r\n            \r\n        if status is not None:\r\n            if status not in (\"todo\", \"in_progress\", \"done\"):\r\n                conn.close()\r\n                raise HTTPException(status_code=422, detail=\"Invalid status\")\r\n            query += \" AND status = ?\"\r\n            params.append(status)\r\n            \r\n        query += \" ORDER BY id ASC\"\r\n        cursor.execute(query, params)\r\n        rows = cursor.fetchall()\r\n        conn.close()\r\n        return [{\"id\": r[0], \"title\": r[1], \"status\": r[2]} for r in rows]\r\n\r\n    @app.patch(\"/tasks/{task_id}\")\r\n    def update_task(task_id: int, task_update: TaskUpdate):\r\n        if task_update.title is None and task_update.status is None:\r\n            raise HTTPException(status_code=422, detail=\"Empty update\")\r\n            \r\n        if task_update.title is not None:\r\n            if not isinstance(task_update.title, str) or not task_update.title.strip():\r\n                raise HTTPException(status_code=422, detail=\"Title cannot be blank\")\r\n                \r\n        if task_update.status is not None:\r\n            if task_update.status not in (\"todo\", \"in_progress\", \"done\"):\r\n                raise HTTPException(status_code=422, detail=\"Invalid status\")\r\n\r\n        conn = sqlite3.connect(database_path)\r\n        cursor = conn.cursor()\r\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\r\n        row = cursor.fetchone()\r\n        if not row:\r\n            conn.close()\r\n            raise HTTPException(status_code=404, detail=\"Task not found\")\r\n\r\n        current_title, current_status = row[1], row[2]\r\n        new_title = task_update.title if task_update.title is not None else current_title\r\n        new_status = task_update.status if task_update.status is not None else current_status\r\n\r\n        cursor.execute(\"UPDATE tasks SET title = ?, status = ? WHERE id = ?\", (new_title, new_status, task_id))\r\n        conn.commit()\r\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\r\n        updated_row = cursor.fetchone()\r\n        conn.close()\r\n        return {\"id\": updated_row[0], \"title\": updated_row[1], \"status\": updated_row[2]}\r\n\r\n    @app.delete(\"/tasks/{task_id}\", status_code=status.HTTP_204_NO_CONTENT)\r\n    def delete_task(task_id: int):\r\n        conn = sqlite3.connect(database_path)\r\n        cursor = conn.cursor()\r\n        cursor.execute(\"SELECT id FROM tasks WHERE id = ?\", (task_id,))\r\n        row = cursor.fetchone()\r\n        if not row:\r\n            conn.close()\r\n            raise HTTPException(status_code=404, detail=\"Task not found\")\r\n        cursor.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\r\n        conn.commit()\r\n        conn.close()\r\n        return None\r\n\r\n    @app.get(\"/\", response_class=HTMLResponse)\r\n    def web_interface():\r\n        html_content = \"\"\"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Mini Task Manager</title>\r\n    <style>\r\n        body { font-family: sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; }\r\n        .error { color: red; margin-bottom: 1rem; }\r\n        .task-item { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; border-bottom: 1px solid #ddd; }\r\n        .task-actions button { margin-left: 0.5rem; }\r\n        .controls { display: flex; gap: 1rem; margin-bottom: 1rem; }\r\n    </style>\r\n</head>\r\n<body>\r\n    <main>\r\n        <h1>Mini Task Manager</h1>\r\n        <div id=\"error-box\" class=\"error\"></div>\r\n        <form id=\"create-form\">\r\n            <label for=\"new-title\">New Task</label>\r\n            <input type=\"text\" id=\"new-title\" placeholder=\"New task title...\" required>\r\n            <button type=\"submit\">Add Task</button>\r\n        </form>\r\n        <div class=\"controls\" style=\"margin-top: 1rem;\">\r\n            <label for=\"search-q\">Search</label>\r\n            <input type=\"text\" id=\"search-q\" placeholder=\"Search tasks...\">\r\n            <label for=\"filter-status\">Status</label>\r\n            <select id=\"filter-status\">\r\n                <option value=\"\">All Statuses</option>\r\n                <option value=\"todo\">Todo</option>\r\n                <option value=\"in_progress\">In Progress</option>\r\n                <option value=\"done\">Done</option>\r\n            </select>\r\n            <button id=\"search-btn\">Filter</button>\r\n        </div>\r\n        <div id=\"task-list\"></div>\r\n    </main>\r\n    <script>\r\n        async function fetchTasks() {\r\n            const q = document.getElementById('search-q').value;\r\n            const status = document.getElementById('filter-status').value;\r\n            let url = '/tasks?';\r\n            if (q) url += `q=${encodeURIComponent(q)}&`;\r\n            if (status) url += `status=${encodeURIComponent(status)}`;\r\n            \r\n            const res = await fetch(url);\r\n            const tasks = await res.json();\r\n            const listEl = document.getElementById('task-list');\r\n            listEl.innerHTML = '';\r\n            tasks.forEach(task => {\r\n                const div = document.createElement('div');\r\n                div.className = 'task-item';\r\n                \r\n                const label = document.createElement('label');\r\n                label.className = 'task-title';\r\n                label.textContent = task.title + ' (' + task.status + ')';\r\n                div.appendChild(label);\r\n\r\n                const actions = document.createElement('div');\r\n                actions.className = 'task-actions';\r\n\r\n                const statusSelect = document.createElement('select');\r\n                statusSelect.setAttribute('aria-label', 'Task Status');\r\n                ['todo', 'in_progress', 'done'].forEach(st => {\r\n                    const opt = document.createElement('option');\r\n                    opt.value = st;\r\n                    opt.textContent = st;\r\n                    if (st === task.status) opt.selected = true;\r\n                    statusSelect.appendChild(opt);\r\n                });\r\n                statusSelect.onchange = async () => {\r\n                    const r = await fetch(`/tasks/${task.id}`, {\r\n                        method: 'PATCH',\r\n                        headers: {'Content-Type': 'application/json'},\r\n                        body: JSON.stringify({status: statusSelect.value})\r\n                    });\r\n                    if (!r.ok) showError('Failed to update status');\r\n                    else fetchTasks();\r\n                };\r\n                actions.appendChild(statusSelect);\r\n\r\n                const editBtn = document.createElement('button');\r\n                editBtn.textContent = 'Edit';\r\n                editBtn.onclick = async () => {\r\n                    const newTitle = prompt('Edit task title:', task.title);\r\n                    if (newTitle !== null) {\r\n                        const r = await fetch(`/tasks/${task.id}`, {\r\n                            method: 'PATCH',\r\n                            headers: {'Content-Type': 'application/json'},\r\n                            body: JSON.stringify({title: newTitle})\r\n                        });\r\n                        if (!r.ok) {\r\n                            const err = await r.json();\r\n                            showError(err.detail || 'Failed to edit');\r\n                        } else {\r\n                            fetchTasks();\r\n                        }\r\n                    }\r\n                };\r\n                actions.appendChild(editBtn);\r\n\r\n                const delBtn = document.createElement('button');\r\n                delBtn.textContent = 'Delete';\r\n                delBtn.onclick = async () => {\r\n                    const r = await fetch(`/tasks/${task.id}`, {method: 'DELETE'});\r\n                    if (!r.ok) showError('Failed to delete');\r
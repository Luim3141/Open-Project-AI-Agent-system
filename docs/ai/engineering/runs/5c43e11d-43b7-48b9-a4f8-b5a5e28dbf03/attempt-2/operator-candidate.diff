+import os
+import pytest
+from fastapi.testclient import TestClient
+from task_manager.app import create_app
+
+@pytest.fixture
+def client(tmp_path):
+    db_path = tmp_path / "test.db"
+    app = create_app(str(db_path))
+    return TestClient(app)
+
+def test_ac1_post_task_success(client):
+    response = client.post("/tasks", json={"title": "Buy milk"})
+    assert response.status_code == 201
+    data = response.json()
+    assert data["title"] == "Buy milk"
+    assert data["status"] == "todo"
+    assert isinstance(data["id"], int)
+
+def test_ac2_get_tasks_order(client):
+    client.post("/tasks", json={"title": "Task One"})
+    client.post("/tasks", json={"title": "Task Two"})
+    response = client.get("/tasks")
+    assert response.status_code == 200
+    tasks = response.json()
+    assert len(tasks) == 2
+    assert tasks[0]["title"] == "Task One"
+    assert tasks[1]["title"] == "Task Two"
+    assert tasks[0]["id"] < tasks[1]["id"]
+
+def test_ac3_persistence(tmp_path):
+    db_path = tmp_path / "persistent.db"
+    app1 = create_app(str(db_path))
+    client1 = TestClient(app1)
+    client1.post("/tasks", json={"title": "Persistent Task"})
+
+    # Reopen app with same db file
+    app2 = create_app(str(db_path))
+    client2 = TestClient(app2)
+    response = client2.get("/tasks")
+    assert response.status_code == 200
+    tasks = response.json()
+    assert len(tasks) == 1
+    assert tasks[0]["title"] == "Persistent Task"
+
+def test_ac4_blank_title_rejected(client):
+    response = client.post("/tasks", json={"title": "   "})
+    assert response.status_code == 422
+    response2 = client.post("/tasks", json={"title": ""})
+    assert response2.status_code == 422

WHERE id = ?\", (new_title, new_status, task_id))\r\n        conn.commit()\r\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\r\n        updated_row = cursor.fetchone()\r\n        conn.close()\r\n        return {\"id\": updated_row[0], \"title\": updated_row[1], \"status\": updated_row[2]}\r\n\r\n    @app.delete(\"/tasks/{task_id}\", status_code=status.HTTP_204_NO_CONTENT)\r\n    def delete_task(task_id: int):\r\n        conn = sqlite3.connect(database_path)\r\n        cursor = conn.cursor()\r\n        cursor.execute(\"SELECT id FROM tasks WHERE id = ?\", (task_id,))\r\n        row = cursor.fetchone()\r\n        if not row:\r\n            conn.close()\r\n            raise HTTPException(status_code=404, detail=\"Task not found\")\r\n        cursor.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\r\n        conn.commit()\r\n        conn.close()\r\n        return None\r\n\r\n    @app.get(\"/\", response_class=HTMLResponse)\r\n    def web_interface():\r\n        return HTMLResponse(content=r\"\"\"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Mini Task Manager</title>\r\n  <style>\r\n    body { font-family: sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; }\r\n    .controls, .task-item, .task-actions { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }\r\n    .controls { margin: 1rem 0; }\r\n    .task-item { justify-content: space-between; padding: .6rem 0; border-bottom: 1px solid #ddd; }\r\n    .task-title { overflow-wrap: anywhere; }\r\n    button, input, select { padding: .5rem; }\r\n    .error { color: #a01010; min-height: 1.4em; }\r\n    button:disabled { opacity: .6; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <main>\r\n    <h1>Mini Task Manager</h1>\r\n    <div id=\"error-box\" class=\"error\" role=\"alert\" aria-live=\"assertive\"></div>\r\n    <form id=\"create-form\">\r\n      <label for=\"new-title\">New Task</label>\r\n      <input id=\"new-title\" type=\"text\" placeholder=\"New task title...\" required>\r\n      <button id=\"create-submit\" type=\"submit\">Add Task</button>\r\n    </form>\r\n    <div class=\"controls\">\r\n      <label for=\"search-q\">Search</label><input id=\"search-q\" type=\"search\" placeholder=\"Search tasks...\">\r\n      <label for=\"filter-status\">Status</label>\r\n      <select id=\"filter-status\">\r\n        <option value=\"\">All Statuses</option><option value=\"todo\">Todo</option>\r\n        <option value=\"in_progress\">In Progress</option><option value=\"done\">Done</option>\r\n      </select>\r\n      <button id=\"search-btn\" type=\"button\">Filter</button>\r\n      <button id=\"retry-btn\" type=\"button\" hidden>Retry loading tasks</button>\r\n    </div>\r\n    <p id=\"list-status\" role=\"status\" aria-live=\"polite\"></p>\r\n    <div id=\"task-list\" aria-busy=\"false\"></div>\r\n  </main>\r\n  <script>\r\n    const byId = id => document.getElementById(id);\r\n    let listSequence = 0;\r\n    let listController = null;\r\n\r\n    function errorMessage(data, fallback) {\r\n      if (typeof data === 'string') return data || fallback;\r\n      if (typeof data?.detail === 'string') return data.detail;\r\n      if (Array.isArray(data?.detail)) {\r\n        return data.detail.map(item => {\r\n          const field = Array.isArray(item.loc) ? item.loc.filter(part => part !== 'body').join('.') : '';\r\n          return (field ? field + ': ' : '') + (item.msg || 'Invalid value');\r\n        }).join('; ');\r\n      }\r\n      return fallback;\r\n    }\r\n\r\n    async function requestJson(url, options = {}) {\r\n      let response;\r\n      try { response = await fetch(url, options); }\r\n      catch (error) {\r\n        if (error.name === 'AbortError') throw error;\r\n        throw new Error('Network error. Check the connection and retry. Your input has been kept.');\r\n      }\r\n      if (!response.ok) {\r\n        let data = null;\r\n        try { data = await response.json(); } catch (_) { /* HTTP error may be HTML. */ }\r\n        throw new Error(errorMessage(data, 'Request failed (HTTP ' + response.status + '). Please retry.'));\r\n      }\r\n      if (response.status === 204) return null;\r\n      try { return await response.json(); }\r\n      catch (_) { throw new Error('The server returned an invalid response. Please retry.'); }\r\n    }\r\n\r\n    function showError(message) { byId('error-box').textContent = message || ''; }\r\n\r\n    async function withBusy(control, action) {\r\n      if (control.disabled) return;\r\n      control.disabled = true;\r\n      showError('');\r\n      try { await action(); await fetchTasks(); }\r\n      catch (error) { showError(error.message); }\r\n      finally { control.disabled = false; }\r\n    }\r\n\r\n    function renderTasks(tasks) {\r\n      const list = byId('task-list');\r\n      list.textContent = '';\r\n      tasks.forEach(task => {\r\n        const row = document.createElement('div'); row.className = 'task-item';\r\n        const title = document.createElement('span'); title.className = 'task-title';\r\n        title.textContent = task.title + ' (' + task.status + ')'; row.appendChild(title);\r\n        const actions = document.createElement('div'); actions.className = 'task-actions';\r\n        const status = document.createElement('select');\r\n        status.setAttribute('aria-label', 'Task Status: ' + task.title);\r\n        ['todo', 'in_progress', 'done'].forEach(value => {\r\n          const option = document.createElement('option'); option.value = value; option.textContent = value;\r\n          option.selected = value === task.status; status.appendChild(option);\r\n        });\r\n        status.value = task.status;\r\n        status.onchange = () => withBusy(status, async () => {\r\n          try {\r\n            await requestJson('/tasks/' + task.id, {method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({status: status.value})});\r\n          } catch (error) { status.value = task.status; throw error; }\r\n        });\r\n        actions.appendChild(status);\r\n        const edit = document.createElement('button'); edit.type = 'button'; edit.textContent = 'Edit';\r\n        edit.onclick = () => {\r\n          const title = prompt('Edit task title:', task.title);\r\n          if (title !== null) return withBusy(edit, () => requestJson('/tasks/' + task.id, {method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title})}));\r\n        };\r\n        actions.appendChild(edit);\r\n        const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = 'Delete';\r\n        remove.onclick = () => withBusy(remove, () => requestJson('/tasks/' + task.id, {method: 'DELETE'}));\r\n        actions.appendChild(remove); row.appendChild(actions); list.appendChild(row);\r\n      });\r\n    }\r\n\r\n    async function fetchTasks() {\r\n      const sequence = ++listSequence;\r\n      if (listController) listController.abort();\r\n      listController = new AbortController();\r\n      const signal = listController.signal;\r\n      const query = new URLSearchParams();\r\n      if (byId('search-q').value) query.set('q', byId('search-q').value);\r\n      if (byId('filter-status').value) query.set('status', byId('filter-status').value);\r\n      byId('task-list').setAttribute('aria-busy', 'true');\r\n      byId('list-status').textContent = 'Loading tasks...';\r\n      byId('retry-btn').hidden = true;\r\n      showError('');\r\n      try {\r\n        const tasks = await requestJson('/tasks?' + query.toString(), {signal});\r\n        if (sequence !== listSequence) return;\r\n        if (!Array.isArray(tasks)) throw new Error('The task list response is invalid. Please retry.');\r\n        renderTasks(tasks);\r\n        byId('list-status').textContent = tasks.length ? tasks.length + ' task(s)' : 'No tasks match your filters.';\r\n      } catch (error) {\r\n        if (sequence !== listSequence || error.name === 'AbortError') return;\r\n        showError(error.message);\r\n        byId('list-status').textContent = 'Unable to refresh tasks. Previously loaded data is kept.';\r\n        byId('retry-btn').hidden = false;\r\n      } finally {\r\n        if (sequence === listSequence) byId('task-list').setAttribute('aria-busy', 'false');\r\n      }\r\n    }\r\n\r\n    byId('create-form').onsubmit = event => {\r\n      event.preventDefault();\r\n      return withBusy(byId('create-submit'), async () => {\r\n        await requestJson('/tasks', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title: byId('new-title').value})});\r\n        byId('new-title').value = '';\r\n      });\r\n    };\r\n    byId('search-btn').onclick = fetchTasks;\r\n    byId('retry-btn').onclick = fetchTasks;\r\n    byId('search-q').oninput = fetchTasks;\r\n    byId('filter-status').onchange = fetchTasks;\r\n    fetchTasks();\r\n  </script>\r\n</body>\r\n</html>\r\n\"\"\".replace('<h1>Mini Task Manager</h1>', '<h1>Mini Task Manager</h1><p id=\"release-info\">' + html.escape(release['type']) + ' · ' + html.escape(release['revision'] or 'unversioned') + '</p>', 1))\r\n\r\n    return app\r\n\n\nAssigned Project6 engineering unit. Scope only this repository/worktree. Read skills/engineering-development/SKILL.md. Follow TDD/systematic debugging and receiving-review-feedback, use real terminal/file tools. Do not alter config/skills, scheduler, credentials or outside paths. No commit/push; host owns finishing branch. Preserve all existing code and completed work; inspect current tree, implement only missing assigned behavior. Use .venv/bin/python -m pytest, keep dependencies pinned. Batch edits/verification; finish concise JSON evidence. Specification/AC: {\"unit\": \"feedback-faf8797c2a8d1f4f\", \"title\": \"Viet file test doc lap kiem tra viec tu choi 
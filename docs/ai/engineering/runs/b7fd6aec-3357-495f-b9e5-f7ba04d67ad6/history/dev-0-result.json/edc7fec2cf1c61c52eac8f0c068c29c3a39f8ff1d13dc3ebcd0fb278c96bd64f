pt>\r\n    const byId = id => document.getElementById(id);\r\n    let listSequence = 0;\r\n    let listController = null;\r\n\r\n    function errorMessage(data, fallback) {\r\n      if (typeof data === 'string') return data || fallback;\r\n      if (typeof data?.detail === 'string') return data.detail;\r\n      if (Array.isArray(data?.detail)) {\r\n        return data.detail.map(item => {\r\n          const field = Array.isArray(item.loc) ? item.loc.filter(part => part !== 'body').join('.') : '';\r\n          return (field ? field + ': ' : '') + (item.msg || 'Invalid value');\r\n        }).join('; ');\r\n      }\r\n      return fallback;\r\n    }\r\n\r\n    async function requestJson(url, options = {}) {\r\n      let response;\r\n      try { response = await fetch(url, options); }\r\n      catch (error) {\r\n        if (error.name === 'AbortError') throw error;\r\n        throw new Error('Network error. Check the connection and retry. Your input has been kept.');\r\n      }\r\n      if (!response.ok) {\r\n        let data = null;\r\n        try { data = await response.json(); } catch (_) { /* HTTP error may be HTML. */ }\r\n        throw new Error(errorMessage(data, 'Request failed (HTTP ' + response.status + '). Please retry.'));\r\n      }\r\n      if (response.status === 204) return null;\r\n      try { return await response.json(); }\r\n      catch (_) { throw new Error('The server returned an invalid response. Please retry.'); }\r\n    }\r\n\r\n    function showError(message) { byId('error-box').textContent = message || ''; }\r\n\r\n    async function withBusy(control, action) {\r\n      if (control.disabled) return;\r\n      control.disabled = true;\r\n      showError('');\r\n      try { await action(); await fetchTasks(); }\r\n      catch (error) { showError(error.message); }\r\n      finally { control.disabled = false; }\r\n    }\r\n\r\n    function renderTasks(tasks) {\r\n      const list = byId('task-list');\r\n      list.textContent = '';\r\n      tasks.f
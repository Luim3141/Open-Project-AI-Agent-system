\n    async function fetchTasks() {\r\n      const sequence = ++listSequence;\r\n      if (listController) listController.abort();\r\n      listController = new AbortController();\r\n      const signal = listController.signal;\r\n      const query = new URLSearchParams();\r\n      if (byId('search-q').value) query.set('q', byId('search-q').value);\r\n      if (byId('filter-status').value) query.set('status', byId('filter-status').value);\r\n      byId('task-list').setAttribute('aria-busy', 'true');\r\n      byId('list-status').textContent = 'Loading tasks...';\r\n      byId('retry-btn').hidden = true;\r\n      showError('');\r\n      try {\r\n        const tasks = await requestJson('/tasks?' + query.toString(), {signal});\r\n        if (sequence !== listSequence) return;\r\n        if (!Array.isArray(tasks)) throw new Error('The task list response is invalid. Please retry.');\r\n        renderTasks(tasks);\r\n        byId('list-status').textContent = tasks.length ? tasks.length + ' task(s)' : 'No tasks match your filters.';\r\n      } catch (error) {\r\n        if (sequence !== listSequence || error.name === 'AbortError') return;\r\n        showError(error.message);\r\n        byId('list-status').textContent = 'Unable to refresh tasks. Previously loaded data is kept.';\r\n        byId('retry-btn').hidden = false;\r\n      } finally {\r\n        if (sequence === listSequence) byId('task-list').setAttribute('aria-busy', 'false');\r\n      }\r\n    }\r\n\r\n    byId('create-form').onsubmit = event => {\r\n      event.preventDefault();\r\n      return withBusy(byId('create-submit'), async () => {\r\n        await requestJson('/tasks', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title: byId('new-title').value})});\r\n        byId('new-title').value = '';\r\n      });\r\n    };\r\n    byId('search-btn').onclick = fetchTasks;\r\n    byId('retry-btn').onclick = fetchTasks;\r\n    byId('search-q').oninput = fetchTasks;\r\n    byId('filter-status').onchange = fetchTasks;\r\n    fetchTasks();\r\n  </script>\r\n</body>\r\n</html>\r\n\"\"\")\r\n\r\n    return app\r\n\n\nAssigned Project6 engineering unit. Scope only this repository/worktree. Read skills/engineering-development/SKILL.md. Follow TDD/systematic debugging and receiving-review-feedback, use real terminal/file tools. Do not alter config/skills, scheduler, credentials or outside paths. No commit/push; host owns finishing branch. Preserve all existing code and completed work; inspect current tree, implement only missing assigned behavior. Use .venv/bin/python -m pytest, keep dependencies pinned. Batch edits/verification; finish concise JSON evidence. Specification/AC: {\"unit\": \"feedback-2ec52f6742aa972f\", \"title\": \"Bổ sung endpoint GET /tasks/export.csv trong mini-task-manager để xuất dữ liệu task ra định dạng CSV (hỗ trợ q và status, bảo toàn Unicode, xử lý ký tự đặc biệt theo chuẩn thư viện\", \"spec_sha256\": \"eb33906e2027e4e49cf1bcf861db4926ec8369c0892b4b82d85b570872898aab\", \"steps\": [\"Define AC/API\", \"Implement one feature in isolated worktree\", \"Independent review\", \"Independent tests\", \"Publish PR and progress\", \"Reindex authorized Native evidence\"], \"acceptance\": {\"AC5\": \"PATCH /tasks/{id} edits title or status: todo,in_progress,done; persists after reopening\", \"AC6\": \"DELETE /tasks/{id} returns204; missing edit/delete returns404\", \"AC7\": \"GET /tasks?q=...&status=... filters by case-insensitive literal title substring and valid status; combined filters use AND; ordered ids\", \"AC8\": \"GET / returns self-contained HTML (inline CSS/JS) web UI: create/list/edit/delete/status/search/filter; viewport, main, labels, DOM textContent for task titles, keyboard controls and visible errors\", \"AC9\": \"Blank edit, empty PATCH, invalid status and malformed input return422; SQL text remains data; original AC1-4 regression passes\", \"F1\": \"AC1: GET /tasks/export.csv trả HTTP 200, Content-Type text/csv vớ
ows)\n        active = sum(1 for r in rows if r[0] in (\"todo\", \"in_progress\"))\n        completed = sum(1 for r in rows if r[0] == \"done\")\n        return {\"total\": total, \"active\": active, \"completed\": completed}\n\n    @app.post(\"/tasks\", status_code=status.HTTP_201_CREATED)\n    def create_task(task: TaskCreate):\n        if not isinstance(task.title, str) or not task.title.strip():\n            raise HTTPException(status_code=422, detail=\"Title cannot be blank\")\n        conn = sqlite3.connect(database_path)\n        cursor = conn.cursor()\n        cursor.execute(\"INSERT INTO tasks (title, status) VALUES (?, ?)\", (task.title, \"todo\"))\n        conn.commit()\n        task_id = cursor.lastrowid\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n        conn.close()\n        return {\"id\": row[0], \"title\": row[1], \"status\": row[2]}\n\n    @app.get(\"/tasks/export.csv\")\n    def export_tasks_csv(\n        q: Optional[str] = Query(None),\n        status: Optional[str] = Query(None)\n    ):\n        conn = sqlite3.connect(database_path)\n        conn.create_function(\"qldapm_casefold\", 1, lambda s: s.casefold() if s is not None else \"\")\n        cursor = conn.cursor()\n        query = \"SELECT id, title, status FROM tasks WHERE 1=1\"\n        params = []\n        \n        if q is not None:\n            query += \" AND qldapm_casefold(title) LIKE ? ESCAPE '\\\\'\"\n            escaped_q = q.casefold().replace('\\\\', '\\\\\\\\').replace('%', '\\\\%').replace('_', '\\\\_')\n            params.append(f\"%{escaped_q}%\")\n            \n        if status is not None:\n            if status not in (\"todo\", \"in_progress\", \"done\"):\n                conn.close()\n                raise HTTPException(status_code=422, detail=\"Invalid status\")\n            query += \" AND status = ?\"\n            params.append(status)\n            \n        query += \" ORDER BY id ASC\"\n        cursor.execute(query, params)\n        rows = cursor.fetchall()\n        conn.close()\n\n        output = io.StringIO()\n        writer = csv.writer(output)\n        writer.writerow([\"id\", \"title\", \"status\"])\n        for r in rows:\n            writer.writerow([r[0], r[1], r[2]])\n        csv_content = output.getvalue()\n        \n        return Response(\n            content=csv_content,\n            media_type=\"text/csv; charset=utf-8\",\n            headers={\"Content-Disposition\": \"attachment; filename=tasks.csv\"}\n        )\n\n    @app.get(\"/tasks/{task_id}\")\n    def get_task(task_id: int):\n        conn = sqlite3.connect(database_path)\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n        conn.close()\n        if not row:\n            raise HTTPException(status_code=404, detail=\"Task not found\")\n        return {\"id\": row[0], \"title\": row[1], \"status\": row[2]}\n\n    @app.get(\"/tasks/{task_id}/exists\")\n    def task_exists(task_id: int):\n        conn = sqlite3.connect(database_path)\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n        conn.close()\n        return {\"exists\": bool(row)}\n\n    @app.get(\"/tasks/{task_id}/title\")\n    def get_task_title(task_id: int):\n        conn = sqlite3.connect(database_path)\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id, title FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n        conn.close()\n        if not row:\n            raise HTTPException(status_code=404, detail=\"Task not found\")\n        return {\"id\": row[0], \"title\": row[1]}\n\n    @app.get(\"/tasks\")\n    def list_tasks(\n        q: Optional[str] = Query(None),\n        status: Optional[str] = Query(None)\n    ):\n        conn = sqlite3.connect(database_path)\n        conn.create_function(\"qldapm_casefold\", 1, lambda s: s.casefold() if s is not None else \"\")\n        cursor = conn.cursor()\n        query = \"SELECT id, title, status FROM tasks WHERE 1=1\"\n        params = []\n        \n        if q is not None:\n            query += \" AND qldapm_casefold(title) LIKE ? ESCAPE '\\\\'\"\n            escaped_q = q.casefold().replace('\\\\', '\\\\\\\\').replace('%', '\\\\%').replace('_', '\\\\_')\n            params.append(f\"%{escaped_q}%\")\n            \n        if status is not None:\n            if status not in (\"todo\", \"in_progress\", \"done\"):\n                conn.close()\n                raise HTTPException(status_code=422, detail=\"Invalid status\")\n            query += \" AND status = ?\"\n            params.append(status)\n            \n        query += \" ORDER BY id ASC\"\n        cursor.execute(query, params)\n        rows = cursor.fetchall()\n        conn.close()\n        return [{\"id\": r[0], \"title\": r[1], \"status\": r[2]} for r in rows]\n\n    @app.patch(\"/tasks/{task_id}\")\n    def update_task(task_id: int, task_update: TaskUpdate):\n        if task_update.title is None and task_update.status is None:\n            raise HTTPException(status_code=422, detail=\"Empty update\")\n            \n        if task_update.title is not None:\n            if not isinstance(task_update.title, str) or not task_update.title.strip():\n                raise HTTPException(status_code=422, detail=\"Title cannot be blank\")\n                \n        if task_update.status is not None:\n            if task_update.status not in (\"todo\", \"in_progress\", \"done\"):\n                raise HTTPException(status_code=422, detail=\"Invalid status\")\n\n        conn = sqlite3.connect(database_path)\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n        if not row:\n            conn.close()\n            raise HTTPException(status_code=404, detail=\"Task not found\")\n\n        current_title, current_status = row[1], row[2]\n        new_title = task_update.title if task_update.title is not None else current_title\n        new_status = task_update.status if task_update.status is not None else current_status\n\n        cursor.execute(\"UPDATE tasks SET title = ?, status = ? WHERE id = ?\", (new_title, new_status, task_id))\n        conn.commit()\n        cursor.execute(\"SELECT id, title, status FROM tasks WHERE id = ?\", (task_id,))\n        updated_row = cursor.fetchone()\n        conn.close()\n        return {\"id\": updated_row[0], \"title\": updated_row[1], \"status\": updated_row[2]}\n\n    @app.delete(\"/tasks/{task_id}\", status_code=status.HTTP_204_NO_CONTENT)\n    def delete_task(task_id: int):\n        conn = sqlite3.connect(database_path)\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT id FROM tasks WHERE id = ?\", (task_id,))\n        row = cursor.fetchone()\n        if not row:\n            conn.close()\n            raise HTTPException(status_code=404, detail=\"Task not found\")\n        cursor.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\n        conn.commit()\n        conn.close()\n        return None\n\n    @app.get(\"/\", response_class=HTMLResponse)\n    def web_interface():\n        return HTMLResponse(content=r\"\"\"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mini Task Manager</title>\n  <style>\n    body { font-family: sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; }\n    .controls, .task-item, .task-actions { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }\n    .controls { margin: 1rem 0; }\n    .task-item { justify-content: space-between; padding: .6rem 0; border-bottom: 1px solid #ddd; }\n    .task-title { overflow-wrap: anywhere; }\n    button, input, select { padding: .5rem; }\n    .error { color: #a01010; min-height: 1.4em; }\n    button:disabled { opacity: .6; }\n  </style>\n</head>\n<body>\n  <main>\n    <h1>Mini Task Manager</h1>\n    <div id=\"error-box\" class=\"error\" role=\"alert\" aria-live=\"assertive\"></div>\n    <form id=\"create-form\">\n      <label for=\"new-title\">New Task</label>\n      <input id=\"new-title\" type=\"text\" placeholder=\"New task title...\" required>\n      <button id=\"create-submit\" type=\"submit\">Add Task</button>\n    </form>\n    <div class=\"controls\">\n      <label for=\"search-q\">Search</label><input id=\"search-q\" type=\"search\" placeholder=\"Search tasks...\">\n      <label for=\"filter-status\">Status</label>\n      <select id=\"filter-status\">\n        <option value=\"\">All Statuses</option><option value=\"todo\">Todo</option>\n        <option value=\"in_progress\">In Progress</option><option value=\"done\">Done</option>\n      </select>\n      <button id=\"search-btn\" type=\"button\">Filter</button>\n      <button id=\"retry-btn\" type=\"button\" hidden>Retry loading tasks</button>\n    </div>\n    <p id=\"list-status\" role=\"status\" aria-live=\"polite\"></p>\n    <div id=\"task-list\" aria-busy=\"false\"></div>\n  </main>\n  <script>\n    const byId = id => document.getElementById(id);\n    let listSequence = 0;\n    let listController = null;\n\n    function errorMessage(data, fallback) {\n      if (typeof data === 'string') return data || fallback;\n      if (typeof data?.detail === 'string') return data.detail;\n      if (Array.isArray(data?.detail)) {\n        return data.detail.map(item => {\n          const field = Array.isArray(item.loc) ? item.loc.filter(part => part !== 'body').join('.') : '';\n          return (field ? field + ': ' : '') + (item.msg || 'Invalid value');\n        }).join('; ');\n      }\n      return fallback;\n    }\n\n    async function requestJson(url, options = {}) {\n      let response;\n      try { response = await fetch(url, options); }\n      catch (error) {\n        if (error.name === 'AbortError') throw error;\n        throw new Error('Network error. Check the connection and retry. Your input has been kept.');\n      }\n      if (!response.ok) {\n        let data = null;\n        try { data = await response.json(); } catch (_) { /* HTTP error may be HTML. */ }\n        throw new Error(errorMessage(data, 'Request failed (HTTP ' + response.status + '). Please retry.'));\n      }\n      if (response.status === 204) return null;\n      try { return await response.json(); }\n      catch (_) { throw new Error('The server returned an invalid response. Please retry.'); }\n    }\n\n    function showError(message) { byId('error-box').textContent = message || ''; }\n\n    async function withBusy(control, action) {\n      if (control.disabled) return;\n      control.disabled = true;\n      showError('');\n      try { await action(); await fetchTasks(); }\n      catch (error) { showError(error.message); }\n      finally { control.disabled = false; }\n    }\n\n    function renderTasks(tasks) {\n      const list = byId('task-list');\n      list.textContent = '';\n      tasks.forEach(task => {\n        const row = document.createElement('div'); row.className = 'task-item';\n        const title = document.createElement('span'); title.className = 'task-title';\n        title.textContent = task.title + ' (' + task.status + ')'; row.appendChild(title);\n        const actions = document.createElement('div'); actions.className = 'task-actions';\n        const status = document.createElement('select');\n        status.setAttribute('aria-label', 'Task Status: ' + task.title);\n        ['todo', 'in_progress', 'done'].forEach(value => {\n          const option = document.createElement('option'); option.value = value; option.textContent = value;\n          option.selected = value === task.status; status.appendChild(option);\n        });\n        status.value = task.status;\n        status.onchange = () => withBusy(status, async () => {\n          try {\n            await requestJson('/tasks/' + task.id, {method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({status: status.value})});\n          } catch (error) { status.value = task.status; throw error; }\n        });\n        actions.appendChild(status);\n        const edit = document.createElement('button'); edit.type = 'button'; edit.textContent = 'Edit';\n        edit.onclick = () => {\n          const title = prompt('Edit task title:', task.title);\n          if (title !== null) return withBusy(edit, () => requestJson('/tasks/' + task.id, {method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title})}));\n        };\n        actions.appendChild(edit);\n        const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = 'Delete';\n        remove.onclick = () => withBusy(remove, () => requestJson('/tasks/' + task.id, {method: 'DELETE'}));\n        actions.appendChild(remove); row.appendChild(actions); list.appendChild(row);\n      });\n    }\n\n    async function fetchTasks() {\n      const sequence = ++listSequence;\n      if (listController) listController.abort();\n      listController = new AbortController();\n      const signal = listController.signal;\n      const query = new URLSearchParams();\n      if (byId('search-q').value) query.set('q', byId('search-q').value);\n      if (byId('filter-status').value) query.set('status', byId('filter-status').value);\n      byId('task-list').setAttribute('aria-busy', 'true');\n      byId('list-status').textContent = 'Loading tasks...';\n      byId('retry-btn').hidden = true;\n      showError('');\n      try {\n        const tasks = await requestJson('/tasks?' + query.toString(), {signal});\n        if (sequence !== listSequence) return;\n        if (!Array.isArray(tasks)) throw new Error('The task list response is invalid. Please retry.');\n        renderTasks(tasks);\n        byId('list-status').textContent = tasks.length ? tasks.length + ' task(s)' : 'No tasks match your filters.';\n      } catch (error) {\n        if (sequence !== listSequence || error.name === 'AbortError') return;\n        showError(error.message);\n        byId('list-status').textContent = 'Unable to refresh tasks. Previously loaded data is kept.';\n        byId('retry-btn').hidden = false;\n      } finally {\n        if (sequence === listSequence) byId('task-list').setAttribute('aria-busy', 'false');\n      }\n    }\n\n    byId('create-form').onsubmit = event => {\n      event.preventDefault();\n      return withBusy(byId('create-submit'), async () => {\n        await requestJson('/tasks', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title: byId('new-title').value})});\n        byId('new-title').value = '';\n      });\n    };\n    byId('search-btn').onclick = fetchTasks;\n    byId('retry-btn').onclick = fetchTasks;\n    byId('search-q').oninput = fetchTasks;\n    byId('filter-status').onchange = fetchTasks;\n    fetchTasks();\n  </script>\n</body>\n</html>\n\"\"\")\n\n    return app\n\n\nAssigned Project6 engineering unit. Scope only this repository/worktree. Read skills/engineering-development/SKILL.md. Follow TDD/systematic debugging and receiving-review-feedback, use real terminal/file tools. Do not alter config/skills, scheduler, credentials or outside paths. No commit/push; host owns finishing branch. Preserve all existing code and completed work; inspect current tree, implement only missing assigned behavior. Use .venv/bin/python -m pytest, keep dependencies pinned. Batch edits/verification; finish concise JSON evidence. Specification/AC: {\"unit\": \"feedback-2ec52f6742aa972f\", \"title\": \"Bổ sung endpoint GET /tasks/export.csv trong mini-task-manager để xuất dữ liệu task ra định dạng CSV (hỗ trợ q và status, bảo toàn Unicode, xử lý ký tự đặc biệt theo chuẩn thư viện\", \"spec_sha256\": \"eb33906e2027e4e49cf1bcf861db4926ec8369c0892b4b82d
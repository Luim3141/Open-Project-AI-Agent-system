er}. Reuse the same optional q and status filters as GET /tasks; combined filters use AND and invalid status must have the same validation contract. Define the static /tasks/count route before any dynamic task-id route. Preserve current task CRUD, summary, detail, exists, title, CSV, Unicode and release identity behavior. Add meaningful tests for empty/count after create, q/status combined filters, Unicode/literal SQL characters, and ensure GET count never changes stored tasks. No schema migration, external service or extra feature; no PR merge or Demo deployment. Keep one coding unit, BA acceptance and PM dependencies explicit; reuse already delivered units without redoing their work.\"}\nDiff:\ndiff --git a/task_manager/app.py b/task_manager/app.py\nindex 55f7f42..f0333d7 100644\n--- a/task_manager/app.py\n+++ b/task_manager/app.py\n@@ -120,6 +120,11 @@ def create_app(database_path: str = \"tasks.db\", release: Optional[dict] = None)\n             headers={\"Content-Disposition\": \"attachment; filename=tasks.csv\"}\n         )\n \n+    @app.get(\"/tasks/count\")\n+    def get_tasks_count(q: Optional[str] = Query(None), status: Optional[str] = Query(None)):\n+        # shortcut: reuse list filtering for this small local app; add shared SQL count if task volume becomes large.\n+        return {\"count\": len(list_tasks(q=q, status=status))}\n+\n     @app.get(\"/tasks/{task_id}\")\n     def get_task(task_id: int):\n         conn = sqlite3.connect(database_path)\ndiff --git a/tests/test_tasks.py b/tests/test_tasks.py\nindex 5678acf..5737d41 100644\n--- a/tests/test_tasks.py\n+++ b/tests/test_tasks.py\n@@ -218,3 +218,93 @@ def test_get_task_title_missing(client):\n def test_get_task_title_invalid(client):\n     r = client.get(\"/tasks/abc/title\")\n     assert r.status_code == 422\n+\n+\n+def test_tasks_count_empty_and_after_create_delete(client):\n+    r = client.get(\"/tasks/count\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 0}\n+\n+    r1 = client.post(\"/tasks\", json={\"title\": \"Alpha Task\"})\n+    assert r1.status_code == 201\n+    id1 = r1.json()[\"id\"]\n+\n+    r2 = client.post(\"/tasks\", json={\"title\": \"Beta Task\"})\n+    assert r2.status_code == 201\n+\n+    r = client.get(\"/tasks/count\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 2}\n+\n+    client.delete(f\"/tasks/{id1}\")\n+    r = client.get(\"/tasks/count\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 1}\n+\n+def test_tasks_count_filters_q_and_status(client):\n+    # Create tasks with various statuses and titles\n+    r1 = client.post(\"/tasks\", json={\"title\": \"Python Project\"})\n+    id1 = r1.json()[\"id\"]\n+    client.patch(f\"/tasks/{id1}\", json={\"status\": \"in_progress\"})\n+\n+    r2 = client.post(\"/tasks\", json={\"title\": \"Python Script\"})\n+    id2 = r2.json()[\"id\"]\n+    client.patch(f\"/tasks/{id2}\", json={\"status\": \"done\"})\n+\n+    r3 = client.post(\"/tasks\", json={\"title\": \"JavaScript App\"})\n+\n+    # Filter q only\n+    r = client.get(\"/tasks/count?q=python\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 2}\n+\n+    # Filter status only\n+    r = client.get(\"/tasks/count?status=done\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 1}\n+\n+    # Combined q and status (AND)\n+    r = client.get(\"/tasks/count?q=python&status=in_progress\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 1}\n+\n+    # Combined no match\n+    r = client.get(\"/tasks/count?q=python&status=done\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 1}\n+\n+    r = client.get(\"/tasks/count?q=javascript&status=in_progress\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 0}\n+\n+def test_tasks_count_invalid_status(client):\n+    r = client.get(\"/tasks/count?status=invalid_status\")\n+    assert r.status_code == 422\n+\n+def test_tasks_count_unicode_and_literal_sql(client):\n+    client.post(\"/tasks\", json={\"title\": \"Unicode 🚀 50% off test_user\"})\n+    \n+    r = client.get(\"/tasks/count?q=50%\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 1}\n+\n+    r = client.get(\"/tasks/count?q=test_user\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 1}\n+\n+    r = client.get(\"/tasks/count?q=🚀\")\n+    assert r.status_code == 200\n+    assert r.json() == {\"count\": 1}\n+\n+def test_tasks_count_does_not_modify_storage(client):\n+    r1 = client.post(\"/tasks\", json={\"title\": \"Persistent Task\"})\n+    id1 = r1.json()[\"id\"]\n+\n+    r_count = client.get(\"/tasks/count\")\n+    assert r_count.status_code == 200\n+    assert r_count.json() == {\"count\": 1}\n+\n+    r_task = client.get(f\"/tasks/{id1}\")\n+    assert r_task.status_code == 200\n+    assert r_task.json()[\"title\"] == \"Persistent Task\"\n+    assert r_task.json()[\"status\"] == \"todo\"",

-Type': 'application/json'}, body: JSON.stringify({status: status.value})});\r\n          } catch (error) { status.value = task.status; throw error; }\r\n        });\r\n        actions.appendChild(status);\r\n        const edit = document.createElement('button'); edit.type = 'button'; edit.textContent = 'Edit';\r\n        edit.onclick = () => {\r\n          const title = prompt('Edit task title:', task.title);\r\n          if (title !== null) return withBusy(edit, () => requestJson('/tasks/' + task.id, {method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title})}));\r\n        };\r\n        actions.appendChild(edit);\r\n        const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = 'Delete';\r\n        remove.onclick = () => withBusy(remove, () => requestJson('/tasks/' + task.id, {method: 'DELETE'}));\r\n        actions.appendChild(remove); row.appendChild(actions); list.appendChild(row);\r\n      });\r\n    }\r\n\r\n    async function fetchTasks() {\r\n      const sequence = ++listSequence;\r\n      if (listController) listController.abort();\r\n      listController = new AbortController();\r\n      const signal = listController.signal;\r\n      const query = new URLSearchParams();\r\n      if (byId('search-q').value) query.set('q', byId('search-q').value);\r\n      if (byId('filter-status').value) query.set('status', byId('filter-status').value);\r\n      byId('task-list').setAttribute('aria-busy', 'true');\r\n      byId('list-status').textContent = 'Loading tasks...';\r\n      byId('retry-btn').hidden = true;\r\n      showError('');\r\n      try {\r\n        const tasks = await requestJson('/tasks?' + query.toString(), {signal});\r\n        if (sequence !== listSequence) return;\r\n        if (!Array.isArray(tasks)) throw new Error('The task list response is invalid. Please retry.');\r\n        renderTasks(tasks);\r\n        byId('list-status').textContent = tasks.length ? tasks.length + ' task(s)' : 'No tasks match your filters.';\r\n      } catch (error) {\r\n        if (sequence !== listSequence || error.name === 'AbortError') return;\r\n        showError(error.message);\r\n        byId('list-status').textContent = 'Unable to refresh tasks. Previously loaded data is kept.';\r\n        byId('retry-btn').hidden = false;\r\n      } finally {\r\n        if (sequence === listSequence) byId('task-list').setAttribute('aria-busy', 'false');\r\n      }\r\n    }\r\n\r\n    byId('create-form').onsubmit = event => {\r\n      event.preventDefault();\r\n      return withBusy(byId('create-submit'), async () => {\r\n        await requestJson('/tasks', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({title: byId('new-title').value})});\r\n        byId('new-title').value = '';\r\n      });\r\n    };\r\n    byId('search-btn').onclick = fetchTasks;\r\n    byId('retry-btn').onclick = fetchTasks;\r\n    byId('search-q').oninput = fetchTasks;\r\n    byId('filter-status').onchange = fetchTasks;\r\n    fetchTasks();\r\n  </script>\r\n</body>\r\n</html>\r\n\"\"\".replace('<h1>Mini Task Manager</h1>', '<h1>Mini Task Manager</h1><p id=\"release-info\">' + html.escape(release['type']) + ' · ' + html.escape(release['revision'] or 'unversioned') + '</p>', 1))\r\n\r\n    return app\r\n\n\nAssigned Project6 engineering unit. Scope only this repository/worktree. Read skills/engineering-development/SKILL.md. Follow TDD/systematic debugging and receiving-review-feedback, use real terminal/file tools. Do not alter config/skills, scheduler, credentials or outside paths. No commit/push; host owns finishing branch. Preserve all existing code and completed work; inspect current tree, implement only missing assigned behavior. Use .venv/bin/python -m pytest, keep dependencies pinned. Batch edits/verification; finish concise JSON evidence. Specification/AC: {\"unit\": \"feedback-d8b7006b5cff1bc4\", \"title\": \"Bo sung regression tests cho GET /health dam 
                  },
                  "arguments": {
                    "additionalProperties": true,
                    "title": "Arguments",
                    "type": "object"
                  },
                  "idempotency_key": {
                    "anyOf": [
                      {
                        "maxLength": 100,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Idempotency Key"
                  },
                  "auto_execute": {
                    "default": false,
                    "description": "Legacy field; true is denied. PM must confirm the exact proposal separately.",
                    "title": "Auto Execute",
                    "type": "boolean"
                  },
                  "project_id": {
                    "anyOf": [
                      {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],

    "/api/v1/ai-runs": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "engine": {
                    "type": "string",
                    "enum": [
                      "gemini",
                      "gemini_read",
                      "supervisor",
                      "supervisor_gemini"
                    ],
                    "default": "gemini",
                    "description": "supervisor is local; supervisor_gemini uses bounded live specialists and proposal-only writes with separate exact PM approval; gemini preserves legacy business tools; gemini_read is read-only"
                  },
                  "run_class": {
                    "type": "string",
                    "enum": [
                      "interactive",
                      "agent",
                      "report",
                      "system"
                    ],
                    "default": "interactive",
                    "description": "Scheduling priority and model round bound only; does not change identity, permissions or write consent"
                  },
                  "context_task_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Own stored task reference; requires conversation_id, fresh native ACL/version and unexpired task. Read-only exact follow-up; never write consent"
                  },
                  "conversation_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Must match the stored actor/project/task conversation; required with context_task_id"
                  },
                  "allow_routine_writes": {
                    "type": "boolean",
                    "default": false,
                    "description": "Legacy scope selection only; all writes produce proposals requiring a separate authenticated PM decision"
                  },
                  "write_scope_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "default": [],
                    "description": "User-selected existing work package IDs permitted to change in this run, without a fixed count; newly created IDs are tracked locally"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run receipt; poll GET"
          },
          "503": {
            "description": "Provider disabled/unavailable"
          }
        }
      }
    },
    "/api/v1/proposals/{id}/decision": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "PM decision for own exact proposal; approval executes once",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decision",
                  "hash"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approve",
                      "reject"
                    ]
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted decision/result; Native readback is separate from RAG verification"
          },
          "403": {
            "description": "PM/actor denied"
          },
          "409": {
            "description": "Changed, expired, consumed or uncertain proposal"
          },
          "422": {
            "description": "Invalid decision"
          }
        }
      }
    },

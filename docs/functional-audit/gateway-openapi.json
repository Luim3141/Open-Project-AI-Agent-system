    "/internal/automation/status": {
      "get": {
        "security": [
          {
            "machineStatusAuth": []
          }
        ],
        "description": "Internal machine Gateway liveness only; no native/provider probe, actor, query or request body.",
        "responses": {
          "200": {
            "description": "Gateway liveness and correlation ID; zero model calls"
          },
          "401": {
            "description": "Machine authentication required"
          },
          "403": {
            "description": "Machine scope denied"
          },
          "429": {
            "description": "Machine rate limited"
          }
        }
      }
    },
    "/internal/automation/monitor": {
      "get": {
        "security": [
          {
            "machineStatusAuth": []
          }
        ],
        "description": "Fixed Main health probes and Gateway cgroup/backlog; persisted SHA256 receipt per15minute bucket, one local BGE-M3 embedding, zero provider/Native writes. No caller target/body/query/human authority.",
        "responses": {
          "200": {
            "description": "Persisted HEALTHY/DEGRADED report; observed_at/cached distinguish freshness"
          },
          "401": {
            "description": "Machine authentication required"
          },
          "403": {
            "description": "Scope denied"
          },
          "503": {
            "description": "Monitor busy or receipt unavailable"
          }
        }
      }
    },
    "/internal/automation/commands": {
      "post": {
        "security": [
          {
            "machineStatusAuth": []
          }
        ],
        "description": "Internal signed status, fixed-five daily_brief read or fixed workflow_error metadata;60second expiry/15second future tolerance, durable idempotency, no caller actor/LLM/business write. daily_brief requires daily:YYYY-MM-DD; workflow_error requires error:<known-workflow>:<execution-or-activation>:YYYY-MM-DD in Asia/Bangkok, no raw errors.",
        "parameters": [
          {
            "name": "x-qldapm-command-signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "const": 1,
                    "title": "Version",
                    "type": "integer"
                  },
                  "kind": {
                    "enum": [
                      "status",
                      "daily_brief",
                      "weekly_summary",
                      "workflow_error"
                    ],
                    "title": "Kind",
                    "type": "string"
                  },
                  "request_key": {
                    "maxLength": 100,
                    "minLength": 16,
                    "pattern": "^[A-Za-z0-9:_-]+$",
                    "title": "Request Key",
                    "type": "string"
                  },
                  "nonce": {
                    "maxLength": 100,
                    "minLength": 16,
                    "pattern": "^[A-Za-z0-9:_-]+$",
                    "title": "Nonce",
                    "type": "string"
                  },
                  "issued_at": {
                    "maximum": 999999999999,
                    "minimum": 0,
                    "title": "Issued At",
                    "type": "integer"
                  }
                },
                "required": [
                  "version",
                  "kind",
                  "request_key",
                  "nonce",
                  "issued_at"
                ],
                "title": "AutomationCommand",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Same durable receipt on duplicate"
          },
          "401": {
            "description": "Machine auth required"
          },
          "403": {
            "description": "Signature, scope, expiry or replay denied"
          },
          "413": {
            "description": "Payload too large"
          },
          "422": {
            "description": "Invalid command"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "machineStatusAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-qldapm-machine-key",
        "description": "Separate local n8n key; deterministic status/fixed-five daily reads only, never a human bearer or business write permission"
      }
    },
    "schemas": {
      "AgentProgress": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "run_id": {
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Run Id",
            "type": "string"
          },
          "task_id": {
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Task Id",
            "type": "string"
          },
          "actor_id": {
            "exclusiveMinimum": 0,
            "title": "Actor Id",
            "type": "integer"

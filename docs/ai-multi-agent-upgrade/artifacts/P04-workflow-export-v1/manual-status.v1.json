{
  "id": "qldapmManualStatus",
  "name": "QLDAPM — Manual Gateway status (zero LLM)",
  "active": false,
  "versionId": "75096a4c-65c9-4b80-9a4b-e0f2a55d5b2a",
  "nodes": [
    {
      "id": "manual",
      "name": "Manual status",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "metadata",
      "name": "Command metadata",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { version: 1, kind: 'status', request_key: 'status:' + $workflow.id + ':' + $execution.id, nonce: 'n8n:' + $workflow.id + ':' + $execution.id, issued_at: Math.floor($now.toSeconds()) } }}",
        "options": {}
      }
    },
    {
      "id": "signature",
      "name": "Sign command",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "binaryData": false,
        "value": "={{ 'QLDAPM-AUTOMATION-COMMAND-V1\\nPOST\\n/internal/automation/commands\\n1\\n' + $json.kind + '\\n' + $json.request_key + '\\n' + $json.nonce + '\\n' + $json.issued_at }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "qldapmCommandHmac",
          "name": "QLDAPM status command HMAC"
        }
      }
    },
    {
      "id": "report",
      "name": "Gateway status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://gateway:8090/internal/automation/commands",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-QLDAPM-Command-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { version: $json.version, kind: $json.kind, request_key: $json.request_key, nonce: $json.nonce, issued_at: $json.issued_at } }}",
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "qldapmMachineStatus",
          "name": "QLDAPM Gateway status read only"
        }
      }
    }
  ],
  "connections": {
    "Manual status": {
      "main": [
        [
          {
            "node": "Command metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Command metadata": {
      "main": [
        [
          {
            "node": "Sign command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign command": {
      "main": [
        [
          {
            "node": "Gateway status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok",
    "executionTimeout": 30,
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  }
}
